---
import type { Etape } from "../lib/data";
interface Props { etapes: Etape[]; }
const { etapes } = Astro.props;
const points = etapes.filter((e) => Number.isFinite(e.latitude) && Number.isFinite(e.longitude))
  .sort((a,b) => a.date.localeCompare(b.date))
  .map((e) => ({ slug:e.slug, date:e.date, titre:e.titre, ville:e.ville, pays:e.pays, latitude:e.latitude, longitude:e.longitude, statut:e.statut || "passee" }));
---
<section class="voyage-film container" aria-label="Diaporama du voyage">
  <div class="film-stage">
    <div class="film-map-wrap">
      <div id="film-map" data-points={JSON.stringify(points)} aria-label="Carte animée du voyage"></div>
      <div class="film-map-caption"><span id="film-place">Préparation du voyage…</span></div>
      <div class="film-map-day"><select id="film-day-select" aria-label="Jour du diapo" disabled><option>Chargement des jours…</option></select></div>
    </div>
    <div class="film-memory" id="film-memory">
      <div class="film-memory-content" id="film-memory-content"><div class="film-memory-placeholder">Le voyage se raconte ici, une image à la fois.</div></div>
    </div>
  </div>
  <div class="film-controls">
    <button type="button" id="film-fullscreen" aria-label="Passer le film en plein écran" title="Plein écran">⛶</button>
    <button type="button" id="film-prev" aria-label="Souvenir précédent">←</button>
    <button type="button" id="film-play" class="film-play" aria-label="Lancer le diaporama" title="Lancer le diaporama" disabled>▶</button>
    <button type="button" id="film-next" aria-label="Souvenir suivant">→</button>
    <select id="film-speed" class="film-speed-select" aria-label="Vitesse de déroulement du film" title="Vitesse du film">
      <option value="0.25">0,25×</option><option value="0.5">0,5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="3">3×</option><option value="4">4×</option><option value="5">5×</option>
    </select>
    <label class="film-activities-toggle" for="film-show-activities"><input type="checkbox" id="film-show-activities" /> <span>Activité</span></label>
  </div>
</section>
<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  type FilmPoint = {slug?:string;date:string;titre:string;ville:string;pays:string;latitude:number;longitude:number;statut:string};
  type FilmItem = {kind:"etape"|"photo"|"video"|"video-fichier"|"activite";date:string;title:string;lat:number;lon:number;detail:string;place?:string;time?:string;location?:string;src?:string;fileVideoSrc?:string;youtubeId?:string;slug?:string;id?:string;zoom:number};
  const points:FilmPoint[] = JSON.parse(document.querySelector("#film-map")?.getAttribute("data-points") || "[]");
  const mapElement = document.querySelector<HTMLElement>("#film-map");
  const memory = document.querySelector<HTMLElement>("#film-memory-content");
  const place = document.querySelector<HTMLElement>("#film-place");
  const placeCaption = document.querySelector<HTMLElement>(".film-map-caption");
  const dateLabel = document.querySelector<HTMLElement>("#film-date");
  const playButton = document.querySelector<HTMLButtonElement>("#film-play");
  const prevButton = document.querySelector<HTMLButtonElement>("#film-prev");
  const nextButton = document.querySelector<HTMLButtonElement>("#film-next");
  const fullscreenButton = document.querySelector<HTMLButtonElement>("#film-fullscreen");
  const filmSection = document.querySelector<HTMLElement>(".voyage-film");
  const valid = (lat:unknown,lon:unknown) => typeof lat==="number" && typeof lon==="number" && Number.isFinite(lat) && Number.isFinite(lon) && Math.abs(lat)<=85 && Math.abs(lon)<=180;
  const prettyDate = (value:string) => { const d=new Date(value+"T12:00:00"); return Number.isNaN(d.getTime())?value:new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"long",year:"numeric",timeZone:"Europe/Paris"}).format(d); };
  const formatClock = (value:unknown):string => { if(value===null||value===undefined||value==="")return ""; let d:Date; if(typeof value==="number"||(typeof value==="string"&&/^\d+(?:\.\d+)?$/.test(value.trim()))){const n=Number(value);d=new Date(n<1e12?n*1000:n);}else{d=new Date(String(value));} return Number.isNaN(d.getTime())?"":new Intl.DateTimeFormat("fr-FR",{hour:"2-digit",minute:"2-digit",timeZone:"Europe/Paris"}).format(d); };
  const activityPlaceCache=new Map<string,string>();
  async function reverseGeocode(lat:number,lon:number):Promise<string>{
    const key=lat.toFixed(3)+","+lon.toFixed(3);
    if(activityPlaceCache.has(key))return activityPlaceCache.get(key)||"";
    try{
      const response=await fetch("https://photon.komoot.io/reverse?lon="+encodeURIComponent(String(lon))+"&lat="+encodeURIComponent(String(lat))+"&limit=1",{headers:{"Accept":"application/json"}});
      if(!response.ok)return "";
      const data=await response.json();
      const properties=data?.features?.[0]?.properties;
      if(!properties)return "";
      // N'afficher que si le géocodeur identifie une localité, jamais un comté ou une région comme ville.
      const locality=properties.city||properties.town||properties.village||properties.municipality;
      const country=properties.country;
      const result=typeof locality==="string"&&locality.trim()
        ? [locality,country].filter((value,index,array)=>typeof value==="string"&&value.trim()&&array.indexOf(value)===index).join(", ")
        : "";
      if(result)activityPlaceCache.set(key,result);
      return result;
    }catch{return "";}
  }
  async function initFilm(){
    if(!mapElement||!memory||!place||!playButton||!prevButton||!nextButton||!fullscreenButton||!filmSection)return;
    if(!points.length){place.textContent="Aucune étape disponible pour ce voyage.";return;}
    const syncFullscreenButton=()=>{
      const active=filmSection.classList.contains("film-browser-fullscreen");
      fullscreenButton.textContent="⛶";
      fullscreenButton.setAttribute("aria-label",active?"Réduire le film":"Passer le film en plein écran");
      fullscreenButton.title=active?"Réduire le film":"Plein écran";
      window.setTimeout(()=>{
        map.resize();
        if(!playing&&activeFilmItem?.kind==="photo"){
          map.jumpTo({center:[activeFilmItem.lon,activeFilmItem.lat],zoom:activeFilmItem.zoom});
        }
      },180);
    };
    fullscreenButton.addEventListener("click",()=>{
      filmSection.classList.toggle("film-browser-fullscreen");
      document.body.classList.toggle("film-browser-fullscreen-open",filmSection.classList.contains("film-browser-fullscreen"));
      syncFullscreenButton();
    });
    document.addEventListener("keydown",(event)=>{
      if(event.key==="Escape"&&filmSection.classList.contains("film-browser-fullscreen")){
        filmSection.classList.remove("film-browser-fullscreen");
        document.body.classList.remove("film-browser-fullscreen-open");
        syncFullscreenButton();
      }
    });
    let activeFilmItem:FilmItem|undefined;
    const map = new maplibregl.Map({container:mapElement,style:"https://tiles.openfreemap.org/styles/liberty",center:[points[0].longitude,points[0].latitude],zoom:4,attributionControl:false,scrollZoom:false,dragRotate:false,pitchWithRotate:false});
    let viewportPlace="";
    let placeLookupToken=0;
    const updateViewportPlace=async()=>{
      const token=++placeLookupToken;
      const center=map.getCenter();
      const location=await reverseGeocode(center.lat,center.lng);
      // Ignorer les réponses d'un ancien cadrage si l'utilisateur a bougé entre-temps.
      if(token!==placeLookupToken)return;
      viewportPlace=location;
      const current=activeFilmItem;
      // Priorité au lieu enregistré avec le souvenir ; le géocodage de la carte sert de secours.
      const currentLocation=current?.location||current?.place||viewportPlace;
      const captionText=[currentLocation,current?.time].filter(Boolean).join(" · ");
      place.textContent=captionText;
      if(placeCaption)placeCaption.hidden=!captionText;
    };
    map.on("moveend",()=>{void updateViewportPlace();});
    map.doubleClickZoom.disable();
    map.addControl(new maplibregl.NavigationControl({showCompass:false}),"top-right");
    const photoMarkerElement=document.createElement("div");
    photoMarkerElement.className="film-photo-marker";
    photoMarkerElement.setAttribute("role","img");
    photoMarkerElement.setAttribute("aria-label","Position GPS de la photo");
    const photoMarker=new maplibregl.Marker({element:photoMarkerElement,anchor:"center"});
    const items:FilmItem[] = [];
    try{
      const [photoResponse,activityResponse,fileVideoResponse]=await Promise.all([fetch("/api/public/photos"),fetch("/api/public/carte-evenements"),fetch("/api/public/videos-fichiers")]);
      const photos=photoResponse.ok?(await photoResponse.json()).photos||[]:[];
      const activities=activityResponse.ok?(await activityResponse.json()).courses||[]:[];
      const fileVideos=fileVideoResponse.ok?(await fileVideoResponse.json()).videos||[]:[];
      const videoGroups=await Promise.all(points.map(async stage=>{
        try{
          const response=await fetch("/api/public/videos?etape="+encodeURIComponent(stage.slug||""));
          if(!response.ok)return [];
          const data=await response.json();
          return (data.videos||[]).map((video:any)=>({...video,stage}));
        }catch{return [];}
      }));
      for(const video of videoGroups.flat()){
        const match=String(video.url||"").match(/(?:youtu\.be\/|[?&]v=|\/(?:embed|shorts|live)\/)([a-zA-Z0-9_-]{11})/);
        const youtubeId=match?.[1];
        const stage=video.stage;
        if(!youtubeId||!valid(stage?.latitude,stage?.longitude))continue;
        const rawDate=String(video.dateHeure||video.datePrise||video.date||stage.date||"").slice(0,10);
        if(!/^\d{4}-\d{2}-\d{2}$/.test(rawDate))continue;
        const hasVideoGps=valid(video.latitude,video.longitude);
        const lat=hasVideoGps?Number(video.latitude):stage.latitude;
        const lon=hasVideoGps?Number(video.longitude):stage.longitude;
        items.push({kind:"video",date:rawDate,title:video.titre||"Vidéo du voyage",place:[stage.ville,stage.pays].filter(Boolean).join(", "),time:formatClock(video.dateHeure||video.datePrise),lat,lon,detail:String(video.description||video.commentaire||"").trim(),youtubeId,slug:stage.slug,zoom:12});
      }
      for(const video of fileVideos){
        const rawDate=String(video.date||video.ajouteLe||"").slice(0,10);
        const stage=(video.etape?points.find(p=>p.slug===video.etape):undefined)||
          [...points].filter(p=>p.date<=rawDate).sort((a,b)=>b.date.localeCompare(a.date))[0]||
          points.find(p=>p.date===rawDate);
        const date=/^\d{4}-\d{2}-\d{2}$/.test(rawDate)?rawDate:(stage?.date||"");
        if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||!video.src)continue;
        const hasVideoGps=valid(video.latitude,video.longitude);
        const hasStageGps=valid(stage?.latitude,stage?.longitude);
        // Comme sur la page « Hier », une vidéo importée reste visible même sans étape/GPS.
        // On ne lui attribue des coordonnées que si elles sont réellement disponibles.
        const lat=hasVideoGps?Number(video.latitude):(hasStageGps?stage!.latitude:NaN);
        const lon=hasVideoGps?Number(video.longitude):(hasStageGps?stage!.longitude:NaN);
        items.push({kind:"video-fichier",date,title:video.titre||"Vidéo du voyage",
          place:stage?[stage.ville,stage.pays].filter(Boolean).join(", "):"",lat,lon,
          detail:"",fileVideoSrc:video.src,slug:stage?.slug,zoom:12});
      }
      for(const photo of photos){
        if(!photo)continue;
        const rawLat=photo.latitude,rawLon=photo.longitude;
        let lat=rawLat!==null&&rawLat!==undefined&&rawLat!==""?Number(rawLat):NaN;
        let lon=rawLon!==null&&rawLon!==undefined&&rawLon!==""?Number(rawLon):NaN;
        const hasPhotoGps=valid(lat,lon);
        const linkedStage=photo.etape?points.find(p=>p.slug===photo.etape):undefined;
        if(!hasPhotoGps&&linkedStage){lat=linkedStage.latitude;lon=linkedStage.longitude;}
        if(!valid(lat,lon))continue;
        const date=String(photo.dateHeure||photo.datePrise||photo.ajouteLe||"").slice(0,10);
        if(!/^\d{4}-\d{2}-\d{2}$/.test(date))continue;
        const datedStage=linkedStage||[...points].filter(p=>p.date<=date).sort((a,b)=>b.date.localeCompare(a.date))[0]||points.find(p=>p.date===date);
        items.push({kind:"photo",date,title:photo.legende||photo.alt||"Un souvenir en photo",place:[datedStage?.ville,datedStage?.pays].filter(Boolean).join(", "),time:formatClock(photo.dateHeure||photo.datePrise),lat,lon,detail:String(photo.commentaire||photo.description||photo.descriptionCourte||photo.legende||"").trim(),src:photo.src,slug:datedStage?.slug,zoom:12});
      }
      for(const activity of activities){
        if(!activity||!valid(activity.latitude,activity.longitude))continue;
        const timestamp=Number(activity.fin);
        const date=String(activity.date||(Number.isFinite(timestamp)?new Intl.DateTimeFormat("en-CA",{timeZone:"Europe/Paris",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date(timestamp)):"")).slice(0,10);
        if(!/^\d{4}-\d{2}-\d{2}$/.test(date))continue;
        const details=[activity.sport,typeof activity.km==="number"?activity.km.toLocaleString("fr-FR",{maximumFractionDigits:2})+" km":"",typeof activity.minutes==="number"?activity.minutes+" min":""].filter(Boolean).join(" · ");
        const location=[activity.lieu,activity.location_name,activity.location_city,activity.ville,activity.city,activity.location_state,activity.state,activity.location_country,activity.pays,activity.country].filter((value,index,array)=>typeof value==="string"&&value.trim()&&array.indexOf(value)===index).join(", ");
        const startTime=formatClock(activity.debut||activity.start_time||activity.start||activity.dateDebut);
        const endTime=formatClock(activity.fin||activity.end_time||activity.end||activity.dateFin);
        const time=startTime&&endTime?`${startTime}–${endTime}`:startTime||endTime;
        items.push({kind:"activite",date,title:activity.titre||activity.name||"Activité du voyage",place:location,time,lat:activity.latitude,lon:activity.longitude,detail:details,location,id:activity.id,zoom:11});
      }
    }catch{/* Le film utilise les photos et activités disponibles, sans ajouter d'étapes de destination. */}
    const unique=new Map<string,FilmItem>();
    for(const item of items)unique.set([item.kind,item.date,item.title,item.src||item.id||""].join("|"),item);
    // Trier par date ET heure : le tri par date seule mélangeait les souvenirs d’une même journée.
    // Quand aucune heure n’est connue, ne pas en fabriquer : les éléments datés précisément
    // passent avant ceux dont seule la journée est connue, avec un ordre stable pour les égalités.
    const clockMinutes=(item:FilmItem):number|null=>{
      const match=String(item.time||"").match(/(\d{2}):(\d{2})/);
      return match?Number(match[1])*60+Number(match[2]):null;
    };
    const allSequence=[...unique.values()].sort((a,b)=>{
      const byDate=a.date.localeCompare(b.date);
      if(byDate)return byDate;
      const aTime=clockMinutes(a),bTime=clockMinutes(b);
      if(aTime!==null&&bTime!==null&&aTime!==bTime)return aTime-bTime;
      if(aTime!==null&&bTime===null)return -1;
      if(aTime===null&&bTime!==null)return 1;
      return a.kind==="etape"?-1:b.kind==="etape"?1:0;
    });
    const activityToggle=document.querySelector<HTMLInputElement>("#film-show-activities");
    const activityPreferenceKey="voyage-film-show-activities";
    if(activityToggle){
      try{
        const savedPreference=window.localStorage.getItem(activityPreferenceKey);
        if(savedPreference==="true"||savedPreference==="false")activityToggle.checked=savedPreference==="true";
      }catch{/* Le stockage peut être indisponible : le réglage reste utilisable pour cette session. */}
    }
    let sequence=allSequence.filter(item=>activityToggle?.checked!==false||item.kind!=="activite");
    if(!sequence.length){return;}
    const daySelect=document.querySelector<HTMLSelectElement>("#film-day-select");
    const updateDays=()=>{
      const days=[...new Set(sequence.map(item=>item.date))];
      if(daySelect){
        const selected=daySelect.value;
        daySelect.replaceChildren(...days.map(day=>{
          const option=document.createElement("option");
          option.value=day;
          option.textContent=prettyDate(day);
          return option;
        }));
        daySelect.disabled=false;
        if(days.includes(selected))daySelect.value=selected;
      }
    };
    updateDays();
    const arrivalIndex=sequence.findIndex(item=>item.date.slice(5)==="09-25");
    let index=arrivalIndex>=0?arrivalIndex:0,playing=false,timer:number|undefined,routeRequest=0;
    const clearActivityRoute=()=>{
      const source=map.getSource("film-activity-route") as maplibregl.GeoJSONSource|undefined;
      source?.setData({type:"FeatureCollection",features:[]});
    };
    const showActivityRoute=async(item:FilmItem)=>{
      const request=++routeRequest;
      clearActivityRoute();
      if(item.kind!=="activite"||!item.id)return;
      try{
        const response=await fetch("/api/public/defi/parcours/"+encodeURIComponent(item.id)+"?precision=detail",{cache:"no-store"});
        if(!response.ok)return;
        const result=await response.json();
        const route=(Array.isArray(result.route)?result.route:[]).filter(
          (p:unknown):p is [number,number]=>Array.isArray(p)&&p.length===2&&valid(p[0],p[1]));
        if(request!==routeRequest||route.length<2)return;
        const empty={type:"FeatureCollection" as const,features:[]};
        const source=map.getSource("film-activity-route") as maplibregl.GeoJSONSource|undefined;
        if(source)source.setData(empty);
        else{
          map.addSource("film-activity-route",{type:"geojson",data:empty});
          map.addLayer({id:"film-activity-route-casing",type:"line",source:"film-activity-route",
            layout:{"line-cap":"round","line-join":"round"},
            paint:{"line-color":"#fffdf8","line-width":8,"line-opacity":.95}});
          map.addLayer({id:"film-activity-route-line",type:"line",source:"film-activity-route",
            layout:{"line-cap":"round","line-join":"round"},
            paint:{"line-color":"#df784a","line-width":5,"line-opacity":1}});
        }
        const bounds=new maplibregl.LngLatBounds();
        route.forEach(p=>bounds.extend([p[1],p[0]]));
        if(!bounds.isEmpty())map.fitBounds(bounds,{padding:55,maxZoom:14,duration:500});
        const drawStart=()=>{
          if(request!==routeRequest)return;
          const reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const duration=reduced?0:3200;
          const started=performance.now();
          const update=(now:number)=>{
            if(request!==routeRequest)return;
            const ratio=duration===0?1:Math.min(1,(now-started)/duration);
            const scaled=ratio*(route.length-1);
            const whole=Math.floor(scaled);
            const coordinates=route.slice(0,whole+1).map(p=>[p[1],p[0]]);
            if(whole<route.length-1){
              const fraction=scaled-whole;
              const from=route[whole],to=route[whole+1];
              coordinates.push([from[1]+(to[1]-from[1])*fraction,from[0]+(to[0]-from[0])*fraction]);
            }
            if(coordinates.length>=2){
              const data={type:"Feature" as const,properties:{},geometry:{
                type:"LineString" as const,coordinates}};
              (map.getSource("film-activity-route") as maplibregl.GeoJSONSource|undefined)?.setData(data);
            }
            if(ratio<1)window.requestAnimationFrame(update);
          };
          window.requestAnimationFrame(update);
        };
        window.setTimeout(drawStart,550);
      }catch{/* Le film continue même si le tracé GPS n'est pas disponible. */}
    };
    const render=(animate=true)=>{
      const item=sequence[index];
      activeFilmItem=item;
      // Afficher immédiatement le lieu et l'heure du souvenir quand ces informations existent.
      const initialCaption=[item.location||item.place,item.time].filter(Boolean).join(" · ");
      place.textContent=initialCaption;
      if(placeCaption)placeCaption.hidden=!initialCaption;
      if(daySelect)daySelect.value=item.date;
      memory.replaceChildren();
      // Pour une photo, afficher sa description une seule fois, discrètement au-dessus de l'image.
      if(item.kind==="photo"){
        const caption=document.createElement("p");
        caption.className="film-photo-description";
        caption.textContent=item.detail.trim()||item.title;
        memory.append(caption);
      }
      // Afficher d'abord le média, puis ses informations pour une carte plus naturelle.
      if(item.youtubeId){
        const frame=document.createElement("iframe");frame.src="https://www.youtube-nocookie.com/embed/"+encodeURIComponent(item.youtubeId)+"?rel=0";frame.title=item.title;frame.loading="lazy";frame.allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";frame.allowFullscreen=true;frame.className="film-video-frame";memory.append(frame);
      }else if(item.fileVideoSrc){
        const player=document.createElement("video");
        player.src=item.fileVideoSrc;
        player.controls=true;
        player.preload="metadata";
        player.playsInline=true;
        player.setAttribute("aria-label",item.title);
        player.className="film-video-frame";
        // Cet élément est créé en JavaScript et ne reçoit pas les attributs CSS scopés d'Astro.
        // Appliquer les dimensions directement pour le contenir dans le panneau inférieur.
        Object.assign(player.style,{
          display:"block",
          width:"100%",
          minWidth:"0",
          maxWidth:"100%",
          height:"auto",
          minHeight:"0",
          maxHeight:"min(42vh, 360px)",
          aspectRatio:"16 / 9",
          objectFit:"contain",
          boxSizing:"border-box",
          background:"#000",
          borderRadius:"4px"
        });
        memory.append(player);
      }else if(item.src){
        const img=document.createElement("img");img.src=item.src;img.alt=item.title;img.loading=index<2?"eager":"lazy";img.decoding="async";memory.append(img);
      }else if(item.kind!=="activite"){
        const icon=document.createElement("div");icon.className="film-memory-icon";icon.textContent="⌖";icon.setAttribute("aria-hidden","true");memory.append(icon);
      }
      if(item.kind!=="activite"&&item.kind!=="photo"){
        const tag=document.createElement("span");tag.className="film-kind";tag.textContent=item.kind==="video"?"Vidéo YouTube":item.kind==="video-fichier"?"Vidéo importée":"Étape";
        memory.append(tag);
      }
      if(item.kind!=="photo"){
        const title=document.createElement("h3");title.textContent=item.title;
        memory.append(title);
        if(item.detail.trim()){const detail=document.createElement("p");detail.textContent=item.detail;memory.append(detail);}
      }
      if(item.kind==="activite"&&item.location){const location=document.createElement("p");location.className="film-activity-location";location.textContent=item.location;memory.append(location);}
      const reduced=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      filmSection.classList.toggle("film-showing-activity",item.kind==="activite");
      map.stop();
      if(item.kind==="activite") void showActivityRoute(item); else {routeRequest++;clearActivityRoute();}
      if((item.kind==="photo"||item.kind==="video"||item.kind==="video-fichier")&&valid(item.lat,item.lon)){
        photoMarker.setLngLat([item.lon,item.lat]).addTo(map);
        photoMarkerElement.title=(item.kind==="video"||item.kind==="video-fichier")?"Localisation de la vidéo":"Position GPS de la photo";
      }else{
        photoMarker.remove();
      }
      if(valid(item.lat,item.lon)){
        map.flyTo({center:[item.lon,item.lat],zoom:item.zoom,duration:animate&&!reduced?1400:0,essential:true});
      }
      // Résoudre aussi la vue courante si le souvenir n'a pas de coordonnées GPS.
      void updateViewportPlace();
      prevButton.disabled=index===0;
      nextButton.disabled=index===sequence.length-1;
    };
    const speedSelect=document.querySelector<HTMLSelectElement>("#film-speed");
    const playbackDelay=()=>5500/Math.max(0.25,Number(speedSelect?.value)||1);
    const scheduleNext=()=>{if(timer!==undefined)window.clearInterval(timer);timer=window.setInterval(()=>{if(index>=sequence.length-1){stop();return;}index++;render();},playbackDelay());};
    const stop=()=>{playing=false;if(timer!==undefined)window.clearInterval(timer);timer=undefined;playButton.textContent="▶";playButton.setAttribute("aria-label","Reprendre le diaporama");playButton.title="Reprendre le diaporama";};
    const start=()=>{if(playing)return;if(index===sequence.length-1)index=0;if(!filmSection.classList.contains("film-browser-fullscreen")){filmSection.classList.add("film-browser-fullscreen");document.body.classList.add("film-browser-fullscreen-open");syncFullscreenButton();}playing=true;playButton.textContent="Ⅱ";playButton.setAttribute("aria-label","Mettre en pause");playButton.title="Pause";map.resize();map.jumpTo({center:[0,20],zoom:0});render();scheduleNext();};
    playButton.disabled=false;playButton.textContent="▶";playButton.setAttribute("aria-label","Lancer le diaporama");playButton.title="Lancer le diaporama";
    playButton.addEventListener("click",()=>playing?stop():start());
    speedSelect?.addEventListener("change",()=>{if(playing)scheduleNext();});
    activityToggle?.addEventListener("change",()=>{
      try{window.localStorage.setItem(activityPreferenceKey,String(activityToggle.checked));}catch{/* Le film continue si le stockage est indisponible. */}
      const current=sequence[index];
      const wasPlaying=playing;
      stop();
      sequence=allSequence.filter(item=>activityToggle.checked||item.kind!=="activite");
      if(!sequence.length)return;
      const currentIndex=current?sequence.findIndex(item=>item.kind===current.kind&&item.date===current.date&&item.title===current.title): -1;
      index=currentIndex>=0?currentIndex:Math.min(index,sequence.length-1);
      updateDays();
      render(false);
      if(wasPlaying){start();}
    });
    prevButton.addEventListener("click",()=>{stop();index=Math.max(0,index-1);render(false);});
    nextButton.addEventListener("click",()=>{stop();index=Math.min(sequence.length-1,index+1);render(false);});
    daySelect?.addEventListener("change",()=>{
      const day=daySelect.value;
      const target=sequence.findIndex(item=>item.date===day);
      if(target<0)return;
      stop();
      index=target;
      render();
    });
    const showInitialFrame=()=>{if(points.length>1){const bounds=new maplibregl.LngLatBounds();points.forEach(p=>bounds.extend([p.longitude,p.latitude]));map.fitBounds(bounds,{padding:45,maxZoom:6,duration:0});}render(false);};
    if(map.loaded()) showInitialFrame(); else map.once("load",showInitialFrame);
  }
  initFilm().catch(()=>{if(place)place.textContent="Impossible de préparer le voyage.";});
</script>
