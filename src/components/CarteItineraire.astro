---
import type { Etape } from "../lib/data";

interface Props { etapes: Etape[]; }
const { etapes } = Astro.props;
const points = etapes
  .filter((etape) => Number.isFinite(etape.latitude) && Number.isFinite(etape.longitude))
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((etape) => ({
    slug: etape.slug,
    date: etape.date,
    titre: etape.titre,
    ville: etape.ville,
    pays: etape.pays,
    latitude: etape.latitude,
    longitude: etape.longitude,
    statut: etape.statut || "passee",
  }));
---
<div class="voyage-map-shell">
  <div id="carte-voyage" class="voyage-map" data-etapes={JSON.stringify(points)} role="region" aria-label="Carte interactive des étapes du voyage">
    <div class="map-loading">Chargement de la carte…</div>
  </div>
  <noscript><p>Activez JavaScript pour explorer la carte. Les étapes restent accessibles dans le journal.</p></noscript>
</div>
<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  type Point = {
    slug: string;
    date: string;
    titre: string;
    ville: string;
    pays: string;
    latitude: number;
    longitude: number;
    statut: "passee" | "actuelle" | "future";
  };

  const element = document.getElementById("carte-voyage");
  if (element) {
    (async () => {
      let points: Point[] = JSON.parse(element.dataset.etapes || "[]");
      // Charger les nouvelles étapes R2 à chaque visite, sans reconstruire Astro.
      try {
        const result = await fetch("/api/public/etapes");
        if (result.ok) {
          const data = await result.json();
          points = data.etapes.filter((p: Point) => Number.isFinite(p.latitude) && Number.isFinite(p.longitude))
            .sort((a: Point, b: Point) => String(a.date).localeCompare(String(b.date)));
        }
      } catch { /* Garder la liste statique existante en cas d'indisponibilité. */ }
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    const central = points.find((p) => p.statut === "actuelle") || points[points.length - 1];
    if (central) {
      // Préparer le cadrage avant le premier rendu pour éviter le zoom provisoire.
      const initialBounds = new maplibregl.LngLatBounds();
      points.forEach((p) => initialBounds.extend([p.longitude, p.latitude]));
      // Démarrer le chargement des souvenirs pendant que le fond de carte s'initialise.
      const mapEventsPromise = Promise.all([
        fetch("/api/public/photos").catch(() => null),
        fetch("/api/public/carte-evenements").catch(() => null),
        fetch("/api/public/videos-fichiers").catch(() => null),
      ]);
      const map = new maplibregl.Map({
        container: element,
        style: "https://tiles.openfreemap.org/styles/liberty",
        // Vue globale au départ ; l'animation vers les souvenirs arrive après leur chargement.
        center: [0, 20],
        zoom: 0,
        cooperativeGestures: false,
        scrollZoom: false,
        attributionControl: false,
        dragRotate: false,
        pitchWithRotate: false,
      });
      map.doubleClickZoom.disable();
      // Règle d’architecture : la caméra est pilotée exclusivement par requestDayCamera.
      // Le chargement de la carte et celui des traces ne doivent jamais cadrer eux-mêmes.
      // Les marqueurs d'étapes ne doivent jamais apparaître sur cette carte.
      element.querySelectorAll<HTMLElement>(".map-marker").forEach((marker) => {
        marker.style.display = "none";
      });
      // Ne contrôler que les lignes du voyage, sans toucher aux routes de fond de carte.
      // Masquer les liens entre les étapes dès l'ouverture de la carte.
      let voyageLinksHidden = true;
      const voyageLinkLayers = ["trajet-parcouru", "trajet-prevu", "fil-des-souvenirs", "fil-des-souvenirs-fleches"];
      const syncVoyageLinkVisibility = () => {
        for (const id of voyageLinkLayers) {
          if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", voyageLinksHidden ? "none" : "visible");
        }
      };
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
      map.addControl(new maplibregl.FullscreenControl(), "top-right");

      // Les commandes de journée restent dans la carte en mode normal et plein écran.
      // Lorsque la carte est masquée, on les replace dans leur emplacement d'origine.
      const dayNavigation = document.querySelector<HTMLElement>(".daily-heading-title");
      const dayNavigationHome = dayNavigation?.parentElement;
      const dayNavigationPlaceholder = document.createComment("Emplacement des commandes du jour");
      if (dayNavigation && dayNavigationHome) {
        dayNavigationHome.insertBefore(dayNavigationPlaceholder, dayNavigation);
      }
      const dayControl = document.createElement("div");
      dayControl.className = "map-day-navigation-control maplibregl-ctrl";
      dayControl.style.cssText = "display:flex;flex-direction:column;gap:7px;padding:9px 10px;background:#fffdf8;color:#173d3b;border:1px solid #d8d2c5;border-radius:4px;box-shadow:0 1px 5px #0002;max-width:min(100%,360px);";
      const dayLegend = document.createElement("div");
      dayLegend.style.cssText = "display:flex;align-items:center;gap:7px;font:600 11px 'DM Sans',sans-serif;color:#36534c;";
      const dayLegendLine = document.createElement("span");
      dayLegendLine.style.cssText = "display:inline-block;width:24px;height:0;border-top:4px solid #397A70;border-radius:3px;flex:none;";
      const dayLegendText = document.createElement("span");
      dayLegendText.textContent = "Tracé vert sauge : parcours du jour sélectionné";
      dayLegend.append(dayLegendLine, dayLegendText);
      dayControl.append(dayLegend);
      if (dayNavigation) dayControl.append(dayNavigation);
      const syncDayNavigationLocation = () => {
        if (!dayNavigation || !dayNavigationHome || !dayNavigationPlaceholder.parentNode) return;
        const mapIsHidden = element.style.display === "none";
        if (mapIsHidden) {
          if (dayNavigation.parentElement !== dayNavigationHome) {
            dayNavigationHome.insertBefore(dayNavigation, dayNavigationPlaceholder.nextSibling);
          }
          if (dayLegend.parentElement !== dayNavigationHome) dayNavigationHome.append(dayLegend);
          dayLegend.style.marginTop = "8px";
          dayControl.style.display = "none";
        } else {
          if (dayNavigation.parentElement !== dayControl) dayControl.append(dayNavigation);
          if (dayLegend.parentElement !== dayControl) dayControl.insertBefore(dayLegend, dayNavigation);
          dayLegend.style.marginTop = "0";
          dayControl.style.display = "";
        }
      };
      map.addControl({
        onAdd: () => dayControl,
        onRemove: () => dayControl.remove()
      } as maplibregl.IControl, "top-left");
      syncDayNavigationLocation();
      document.getElementById("map-visibility-toggle")?.addEventListener("click", () => {
        requestAnimationFrame(syncDayNavigationLocation);
      });
      document.addEventListener("fullscreenchange", syncDayNavigationLocation);

      // Fond satellite optionnel : on conserve les marqueurs HTML et les couches du voyage.
      let satelliteEnabled = false;
      let baseLayerVisibility = new Map<string, string>();
      let satelliteControl: HTMLButtonElement;
      const satelliteSourceId = "voyage-satellite-source";
      const satelliteLayerId = "voyage-satellite-raster";
      const satelliteIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v6m6-6v6M8 20v-4h8v4"/></svg>';
      const syncSatelliteControl = () => {
        satelliteControl.innerHTML = satelliteIcon;
        satelliteControl.title = satelliteEnabled ? "Revenir à la vue plan" : "Afficher la vue satellite";
        satelliteControl.setAttribute("aria-pressed", String(satelliteEnabled));
        satelliteControl.setAttribute("aria-label", satelliteEnabled ? "Revenir à la vue plan" : "Afficher la vue satellite");
      };
      satelliteControl = document.createElement("button");
      satelliteControl.type = "button";
      satelliteControl.className = "maplibregl-ctrl";
      satelliteControl.style.cssText = "display:flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;background:#fffdf8;color:#173d3b;border:1px solid #d8d2c5;border-radius:4px;cursor:pointer;box-shadow:0 1px 5px #0002;";
      satelliteControl.addEventListener("click", () => {
        satelliteEnabled = !satelliteEnabled;
        if (map.getLayer(satelliteLayerId)) {
          map.setLayoutProperty(satelliteLayerId, "visibility", satelliteEnabled ? "visible" : "none");
        }
        for (const [id, visibility] of baseLayerVisibility) {
          if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", satelliteEnabled ? "none" : visibility);
        }
        syncSatelliteControl();
      });
      map.addControl({
        onAdd: () => satelliteControl,
        onRemove: () => satelliteControl.remove()
      } as maplibregl.IControl, "top-right");

      for (const p of points) {
        const marker = document.createElement("button");
        marker.type = "button";
        marker.className = "map-marker map-marker-" + p.statut;
        // Éviter les points d’étape parasites visuellement sur la vue monde initiale.
        // Ils réapparaissent dès que la carte est suffisamment rapprochée.
        marker.style.display = "none";
        marker.style.zIndex = "1";
        marker.setAttribute("aria-label", "Ouvrir l'étape " + p.ville);
        marker.title = p.ville;
        marker.textContent = p.statut === "actuelle" ? "●" : "•";

        const contenu = document.createElement("div");
        contenu.className = "map-popup-content";
        const label = document.createElement("span");
        label.textContent = p.statut === "actuelle" ? "Étape actuelle" : p.statut === "future" ? "À venir" : "Étape parcourue";
        label.className = "map-popup-label";
        const titre = document.createElement("strong");
        titre.textContent = p.titre;
        const pays = document.createElement("span");
        pays.textContent = p.pays;
        const jour = document.createElement("button");
        jour.type = "button";
        jour.className = "map-popup-day-button";
        jour.style.cssText = "display:block;margin:8px 0;padding:7px 10px;border:1px solid #d8d8d0;border-radius:3px;background:#f8f6f0;color:#274c41;font:inherit;font-size:.8rem;cursor:pointer;text-align:left";
        jour.textContent = "Voir les souvenirs de cette journée";
        jour.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("voyage:jour", { detail: { date: p.date } }));
          document.querySelector("#daily-view")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        const lien = document.createElement("a");
        lien.href = base + "/etapes/" + encodeURIComponent(p.slug) + "/";
        lien.textContent = "Voir les photos et le récit";
        contenu.append(label, titre, pays, jour, lien);

        new maplibregl.Marker({ element: marker, anchor: "center" })
          .setLngLat([p.longitude, p.latitude])
          .setPopup(new maplibregl.Popup({ offset: 22 }).setDOMContent(contenu))
          .addTo(map);
      }

      const parcours = points.filter((p) => p.statut !== "future");
      const futur = points.filter((p) => p.statut === "future");
      map.on("load", () => {
        // Les tuiles Esri sont un fond raster public ; l'attribution reste visible.
        map.addSource(satelliteSourceId, {
          type: "raster",
          tiles: ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
          tileSize: 256,
          attribution: "Imagerie © Esri, Maxar, Earthstar Geographics et contributeurs",
        });
        const firstBaseLayerId = map.getStyle().layers?.[0]?.id;
        map.addLayer({
          id: satelliteLayerId,
          type: "raster",
          source: satelliteSourceId,
          layout: { visibility: "none" },
          paint: { "raster-opacity": 1 },
        }, firstBaseLayerId);
        // Mémoriser uniquement les couches du fond Liberty : les couches du voyage
        // ajoutées plus tard restent visibles au-dessus de l'imagerie satellite.
        baseLayerVisibility = new Map(
          (map.getStyle().layers || [])
            .filter((layer) => layer.id !== satelliteLayerId &&
              !["trajet-parcouru", "trajet-prevu", "fil-des-souvenirs", "fil-des-souvenirs-fleches",
                "tous-les-traces", "tous-les-traces-fleches", "trace-sportive", "trace-sportive-fleches"].includes(layer.id))
            .map((layer) => [layer.id, String(layer.layout?.visibility || "visible")])
        );
        syncSatelliteControl();
        const traces: { id: string; points: Point[]; couleur: string; tirets?: number[] }[] = [
          { id: "trajet-parcouru", points: parcours, couleur: "#bb714c" },
          { id: "trajet-prevu", points: [...parcours.slice(-1), ...futur], couleur: "#52746a", tirets: [2, 2] },
        ];
        for (const trace of traces) {
          if (trace.points.length < 2) continue;
          map.addSource(trace.id, {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: {
                type: "LineString",
                coordinates: trace.points.map((p) => [p.longitude, p.latitude]),
              },
            },
          });
          map.addLayer({
            id: trace.id,
            type: "line",
            source: trace.id,
            layout: { "line-cap": "round", "line-join": "round" },
            paint: {
              "line-color": trace.couleur,
              "line-width": 3.5,
              ...(trace.tirets ? { "line-dasharray": trace.tirets } : {}),
            },
          });
          syncVoyageLinkVisibility();
        }
        const currentDayColor = getComputedStyle(document.documentElement).getPropertyValue("--current-day-sage").trim() || "#397A70";
        let selectedDay = document.documentElement.dataset.voyageDay || "";
        // Source unique des styles du jour sélectionné : marqueurs, tracés et flèches.
        const syncCurrentDayArrowStyle = (layerId:string) => {
          if (!map.getLayer(layerId)) return;
          const isCurrentDay = ["==", ["get", "date"], selectedDay];
          map.setPaintProperty(layerId, "text-color", selectedDay
            ? ["case", isCurrentDay, currentDayColor, "#df784a"]
            : "#df784a");
          // La couleur sauge s'applique au symbole, mais son contour reste blanc.
          map.setPaintProperty(layerId, "text-halo-color", "#fffdf8");
        };
        // Le point d’entrée unique de toute décision de cadrage. Il est initialisé
        // après fetchRoute ; les appels précoces sont rejoués après création des marqueurs.
        let requestDayCamera: (date:string, initialFocus?:boolean, target?:[number,number]) => void = () => {};
        let selectedTraceId:string|null=null;
        let selectedTraceDate="";
        let selectedTraceAnimationToken=0;
        let selectedTraceRequestToken=0;
        const updateSelectedDay = (date:string, fitMap = true, initialFocus = false) => {
          selectedDay = date;
          document.documentElement.dataset.voyageDay = date;
          element.querySelectorAll<HTMLElement>(".memory-map-marker").forEach((marker) => {
            const active = !selectedDay || marker.dataset.date === selectedDay;
            marker.style.opacity = active ? "1" : ".38";
            marker.style.transform = active ? "scale(1.08)" : "scale(.82)";
            marker.style.zIndex = marker.classList.contains("memory-map-photo-marker") ? "3" : "2";
            const isCurrentDay = !!selectedDay && marker.dataset.date === selectedDay;
            // Les photos du jour gardent leur contour sauge ; le bouton d'activité
            // conserve un contour blanc, même lorsque son fond passe en sauge.
            const isPhotoMarker = marker.classList.contains("memory-map-photo-marker");
            marker.style.borderColor = isCurrentDay && isPhotoMarker ? currentDayColor : "#fff";
            marker.style.borderWidth = "2px";
            if (!isPhotoMarker) {
              marker.style.backgroundColor = isCurrentDay ? currentDayColor : "#c86f4d";
            }
          });
          if (map.getLayer("tous-les-traces-fleches")) {
            map.setLayoutProperty("tous-les-traces-fleches", "symbol-sort-key", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 1, 0]
              : 0);
            syncCurrentDayArrowStyle("tous-les-traces-fleches");
          }
          syncCurrentDayArrowStyle("trace-sportive-fleches");
          if (map.getLayer("tous-les-traces")) {
            map.setPaintProperty("tous-les-traces", "line-color", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], currentDayColor, "#df784a"]
              : "#df784a");
            map.setPaintProperty("tous-les-traces", "line-width", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 5, 2.5]
              : 3.5);
            map.setLayoutProperty("tous-les-traces", "line-sort-key", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 1, 0]
              : 0);
          }
          if (map.getLayer("trace-sportive")) {
            map.setPaintProperty("trace-sportive", "line-color", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], currentDayColor, "#df784a"]
              : "#df784a");
            map.setPaintProperty("trace-sportive", "line-width", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 7, 3]
              : 5);
          }
          // Garder les lignes sous les flèches pour qu'elles restent lisibles.
          // Remonter ensuite les couches de flèches au-dessus de toutes les lignes.
          if (map.getLayer("tous-les-traces")) map.moveLayer("tous-les-traces");
          if (map.getLayer("trace-sportive")) map.moveLayer("trace-sportive");
          if (map.getLayer("fil-des-souvenirs-fleches")) map.moveLayer("fil-des-souvenirs-fleches");
          if (map.getLayer("trace-sportive-fleches") && selectedTraceDate === selectedDay && selectedDay) {
            map.moveLayer("tous-les-traces-fleches");
            map.moveLayer("trace-sportive-fleches");
          } else {
            if (map.getLayer("trace-sportive-fleches")) map.moveLayer("trace-sportive-fleches");
            if (map.getLayer("tous-les-traces-fleches")) map.moveLayer("tous-les-traces-fleches");
          }
          const dateLabel = document.querySelector<HTMLElement>("#daily-date");
          if (dateLabel) {
            dateLabel.style.backgroundColor = selectedDay ? currentDayColor : "transparent";
            dateLabel.style.color = selectedDay ? "#fffdf8" : "";
            dateLabel.style.padding = selectedDay ? "4px 8px" : "";
            dateLabel.style.borderRadius = selectedDay ? "3px" : "";
            dateLabel.style.display = selectedDay ? "inline-block" : "";
          }
          // Toute la caméra passe par un seul point d'entrée : éviter que deux
          // animations concurrentes se remplacent lors des changements de journée.
          if (fitMap) requestDayCamera(date, initialFocus);
        };
        window.addEventListener("voyage:jour", (event) => {
          const detail = (event as CustomEvent<{date?:string;fitMap?:boolean}>).detail;
          updateSelectedDay(detail?.date || "", detail?.fitMap !== false, detail?.initialFocus === true);
        });
        // La légende décrit la zone actuellement visible, indépendamment du jour sélectionné.
        // L'heure, elle, vient uniquement de l'activité GPS de la journée sélectionnée.
        const placeControl = document.createElement("div");
        placeControl.className = "map-day-control maplibregl-ctrl";
        placeControl.setAttribute("aria-live", "polite");
        placeControl.style.cssText = "padding:8px 11px;background:#fffdf8;color:#173d3b;border:1px solid #d8d2c5;border-radius:4px;font:600 12px 'DM Sans',sans-serif;box-shadow:0 1px 5px #0002;max-width:220px;";
        const dailyActivityTimes = new Map<string,string>();
        let viewportPlace = "";
        let currentActivityTime = "";
        let placeLookupToken = 0;
        const updatePlaceLabel = (date:string) => {
          currentActivityTime = dailyActivityTimes.get(date) || "";
          placeControl.textContent = viewportPlace ? [viewportPlace, currentActivityTime].filter(Boolean).join(" · ") : "";
          placeControl.style.display = viewportPlace ? "" : "none";
        };
        updatePlaceLabel(selectedDay);
        window.addEventListener("voyage:jour", (event) => {
          const detail = (event as CustomEvent<{date?:string}>).detail;
          updatePlaceLabel(detail?.date || "");
        });
        map.addControl({
          onAdd: () => placeControl,
          onRemove: () => placeControl.remove()
        } as maplibregl.IControl, "bottom-left");

        // Bouton indépendant à droite pour afficher directement la journée d’hier.
          let yesterdayKeyForControl = "";
          window.addEventListener("voyage:jour", (event) => {
            const detail = (event as CustomEvent<{date?:string}>).detail;
            yesterdayButton.style.display = detail?.date === yesterdayKeyForControl ? "none" : "";
          });
          const yesterdayButton = document.createElement("button");
          yesterdayButton.type = "button";
          yesterdayButton.className = "map-today-control maplibregl-ctrl";
          yesterdayButton.textContent = "Hier";
          yesterdayButton.setAttribute("aria-label", "Afficher la journée d’hier");
          yesterdayButton.addEventListener("click", (event) => {
            event.stopPropagation();
            window.dispatchEvent(new CustomEvent("voyage:hier"));
          });
          for (const eventName of ["pointerdown", "mousedown", "touchstart", "dblclick"]) {
            yesterdayButton.addEventListener(eventName, (event) => {
              event.stopPropagation();
              if (eventName === "dblclick") event.preventDefault();
            });
          }
          map.addControl({
            onAdd: () => yesterdayButton,
            onRemove: () => yesterdayButton.remove()
          } as maplibregl.IControl, "bottom-right");
        // Frise de voyage : chacune des photos publiques et toutes les activités
        // GPX publiées sont positionnées selon l'heure de leur capture/départ.
        // Une position de ville/étape reste explicitement approximative.
        void (async()=>{
          type Event={type:"photo"|"video"|"video-fichier"|"sport"|"etape";date:string;dateHeure?:string|null;
            order:string|null;latitude:number;longitude:number;titre:string;
            src?:string;key?:string;youtubeId?:string;etape?:string;id?:string;distance?:number;km?:number;minutes?:number;sport?:string;precision:string;parcours?:boolean};
          const valid=(lat:unknown,lon:unknown)=>
            typeof lat==="number"&&typeof lon==="number"&&Number.isFinite(lat)&&
            Number.isFinite(lon)&&Math.abs(lat)<=85&&Math.abs(lon)<=180;
          const localClock=(value:number)=>{
            if(!Number.isFinite(value))return null;
            const parts=new Intl.DateTimeFormat("fr-FR",{timeZone:"Europe/Paris",
              year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",
              minute:"2-digit",hourCycle:"h23"}).formatToParts(new Date(value));
            const n=(name:string)=>parts.find(p=>p.type===name)?.value||"";
            return n("year")+"-"+n("month")+"-"+n("day")+"T"+n("hour")+":"+n("minute");
          };
          try{
            const [photosResponse,sportsResponse,fileVideosResponse]=await mapEventsPromise;
            // La carte et son bouton de tracés doivent rester disponibles même si
            // l'une des API d'événements est momentanément indisponible.
            const photoData=photosResponse?.ok?await photosResponse.json():{};
            const sportData=sportsResponse?.ok?await sportsResponse.json():{};
            const photos=photoData.photos;
            const courses=sportData.courses;
            const fileVideoData=fileVideosResponse?.ok?await fileVideosResponse.json():{};
            const videoGroups=await Promise.all(points.map(async stage=>{
              try{
                const response=await fetch("/api/public/videos?etape="+encodeURIComponent(stage.slug));
                if(!response.ok)return [];
                const data=await response.json();
                return (data.videos||[]).map((video:any)=>({...video,stage}));
              }catch{return [];}
            }));
            const memories:Event[]=[];
            for(const video of videoGroups.flat()){
              const match=String(video.url||"").match(/(?:youtu\.be\/|[?&]v=|\/(?:embed|shorts|live)\/)([a-zA-Z0-9_-]{11})/);
              const youtubeId=match?.[1], stage=video.stage;
              if(!youtubeId||!valid(stage?.latitude,stage?.longitude))continue;
              const date=String(video.dateHeure||video.datePrise||video.date||stage.date||"").slice(0,10);
              if(!/^\d{4}-\d{2}-\d{2}$/.test(date))continue;
              const hasGps=valid(video.latitude,video.longitude);
              memories.push({type:"video",date,dateHeure:typeof video.dateHeure==="string"?video.dateHeure:null,
                order:video.dateHeure||date+"T23:58",latitude:hasGps?Number(video.latitude):stage.latitude,
                longitude:hasGps?Number(video.longitude):stage.longitude,
                precision:hasGps?"GPS vidéo":"Emplacement indicatif de l'étape",
                titre:video.titre||"Vidéo YouTube",youtubeId,etape:stage.slug});
            }
            for(const video of (Array.isArray(fileVideoData.videos)?fileVideoData.videos:[])){
              const date=String(video.date||video.ajouteLe||"").slice(0,10);
              if(!/^\d{4}-\d{2}-\d{2}$/.test(date))continue;
              const stage=(video.etape?points.find(p=>p.slug===video.etape):undefined)||
                [...points].filter(p=>p.date<=date).sort((a,b)=>b.date.localeCompare(a.date))[0]||
                points.find(p=>p.date===date);
              const hasVideoGps=valid(video.latitude,video.longitude);
              if(!hasVideoGps&&(!stage||!valid(stage.latitude,stage.longitude)))continue;
              memories.push({type:"video-fichier",date,order:date+"T23:58",
                latitude:hasVideoGps?Number(video.latitude):stage!.latitude,
                longitude:hasVideoGps?Number(video.longitude):stage!.longitude,
                precision:hasVideoGps?"GPS vidéo":"Emplacement indicatif de l'étape",
                titre:video.titre||"Vidéo du voyage",src:video.src,key:video.key,etape:video.etape});
            }
            const parisToday = new Intl.DateTimeFormat("en-CA", {
              timeZone: "Europe/Paris", year: "numeric", month: "2-digit", day: "2-digit"
            }).format(new Date());
            const yesterday = new Date(parisToday + "T12:00:00");
            yesterday.setDate(yesterday.getDate() - 1);
            const yesterdayKey = new Intl.DateTimeFormat("en-CA", {
              timeZone: "Europe/Paris", year: "numeric", month: "2-digit", day: "2-digit"
            }).format(yesterday);
            yesterdayKeyForControl = yesterdayKey;
            for(const photo of (Array.isArray(photos)?photos:[])){
              if(!photo)continue;
              // Le GPS est prioritaire. Sans GPS, utiliser l'étape liée ou, à défaut,
              // l'étape la plus récente à la date de la photo pour garder son propre marqueur.
              const gps=valid(photo.latitude,photo.longitude);
              const dateHeure=typeof photo.dateHeure==="string"?photo.dateHeure:null;
              const photoDate=String(dateHeure?.slice(0,10)||String(photo.datePrise||"").slice(0,10)||String(photo.ajouteLe||"").slice(0,10));
              const linkedStage=photo.etape?points.find(p=>p.slug===photo.etape):undefined;
              const stage=linkedStage||[...points].filter(p=>p.date<=photoDate).sort((a,b)=>b.date.localeCompare(a.date))[0]||points.find(p=>p.date===photoDate);
              if(!gps&&!stage)continue;
              const date=photoDate||stage?.date||"";
              memories.push({type:"photo",date,dateHeure,
                order:dateHeure||(date?date+"T23:59":null),
                latitude:gps?photo.latitude:stage!.latitude,
                longitude:gps?photo.longitude:stage!.longitude,
                precision:gps?(photo.precision==="exact"?"GPS exact":"GPS approximatif"):
                  "Ville / étape (emplacement indicatif)",
                titre:photo.alt||"Photo du voyage",src:photo.src,etape:photo.etape});
            }
            for(const sport of (Array.isArray(courses)?courses:[])){
              if(!sport||!valid(sport.latitude,sport.longitude))continue;
              const clock=localClock(Number(sport.fin));
              const date=String(sport.date||clock?.slice(0,10)||"");
              memories.push({type:"sport",date,dateHeure:clock,
                order:clock||date+"T23:59",latitude:sport.latitude,longitude:sport.longitude,
                precision:"Tracé de l'activité",titre:sport.titre||"Activité sportive",
                id:sport.id,km:sport.km,minutes:sport.minutes,
                sport:sport.sport||"autre",parcours:sport.parcours===true});
            }
            // Les étapes structurent les dates sans heure ; elles ancrent
            // l'itinéraire avant les événements détaillés de la même journée.
            // Le lieu de la légende est géocodé depuis le centre visible de la carte;
            // seule l'heure provient de l'activité GPS de la journée sélectionnée.
            const reversePlace=async(lat:number,lon:number):Promise<string>=>{
              try{
                const response=await fetch("https://photon.komoot.io/reverse?lon="+encodeURIComponent(String(lon))+"&lat="+encodeURIComponent(String(lat))+"&limit=1",{headers:{"Accept":"application/json"}});
                if(!response.ok)return "";
                const properties=(await response.json())?.features?.[0]?.properties;
                if(!properties)return "";
                // Ne pas présenter un comté ou une région comme une ville si la résolution est imprécise.
                const locality=properties.city||properties.town||properties.village||properties.municipality;
                if(typeof locality!=="string"||!locality.trim())return "";
                return [locality,properties.country].filter((value,index,array)=>typeof value==="string"&&value.trim()&&array.indexOf(value)===index).join(", ");
              }catch{return "";}
            };
            const updateViewportPlace=async()=>{
              const token=++placeLookupToken;
              const center=map.getCenter();
              const location=await reversePlace(center.lat,center.lng);
              // Une réponse lente d'un ancien cadrage ne doit jamais écraser le lieu actuel.
              if(token!==placeLookupToken)return;
              viewportPlace=location;
              placeControl.textContent=viewportPlace?[viewportPlace,currentActivityTime].filter(Boolean).join(" · "):"";
              placeControl.style.display=viewportPlace?"":"none";
            };
            map.on("moveend",()=>{void updateViewportPlace();});
            void updateViewportPlace();
            const dayEvents=[...memories].filter(event=>event.date).sort((a,b)=>String(a.order).localeCompare(String(b.order)));
            const stages:Event[]=points.filter(p=>p.statut!=="future").map(p=>({
              type:"etape",date:p.date,order:p.date+"T00:00",
              latitude:p.latitude,longitude:p.longitude,titre:p.ville,precision:"Étape du voyage"}));
            const timeline=[...stages,...memories].filter(e=>e.order)
              .sort((a,b)=>String(a.order).localeCompare(String(b.order)));
            // Déterminer et appliquer l'état initial AVANT toute géolocalisation de libellés.
            // Écrire seulement dans dataset.voyageDay ne met pas à jour selectedDay,
            // qui a été initialisé plus haut et reste sinon vide.
            const datedMemories = [...memories, ...stages].filter(e => e.date && e.date < parisToday);
            const targetDay = datedMemories.some(e => e.date === yesterdayKey)
              ? yesterdayKey
              : datedMemories.reduce((latest, e) => e.date > latest ? e.date : latest, "");
            const targetEvents = datedMemories.filter(e => e.date === targetDay);
            if (targetEvents.length) {
              selectedDay = targetDay;
              document.documentElement.dataset.voyageDay = targetDay;
            }
            // Seule l'heure dépend de l'activité de la journée. Le lieu est calculé
            // séparément à partir du centre de la fenêtre visible, après chaque moveend.
            const datesToLabel=[...new Set(dayEvents.map(event=>event.date))];
            for(const date of datesToLabel){
              const activity=dayEvents
                .filter(event=>event.date===date&&event.type==="sport"&&event.id&&event.parcours)
                .sort((a,b)=>String(b.order||"").localeCompare(String(a.order||"")))[0];
              const timeValue=activity?.dateHeure||activity?.order||"";
              const timeMatch=String(timeValue).match(/T(\d{2}:\d{2})/);
              if(activity&&timeMatch)dailyActivityTimes.set(date,timeMatch[1]);
            }
            updatePlaceLabel(selectedDay);
            void updateViewportPlace();
            if(timeline.length>=2){
              map.addSource("fil-des-souvenirs",{type:"geojson",data:{
                type:"Feature",properties:{},
                geometry:{type:"LineString",coordinates:timeline.map(p=>[p.longitude,p.latitude])}}});
              map.addLayer({id:"fil-des-souvenirs",type:"line",source:"fil-des-souvenirs",
                layout:{"line-cap":"round","line-join":"round"},
                paint:{"line-color":"#b78369","line-width":2,"line-dasharray":[2,3],"line-opacity":.68}});
              map.addLayer({id:"fil-des-souvenirs-fleches",type:"symbol",source:"fil-des-souvenirs",
                layout:{"symbol-placement":"line","symbol-spacing":150,"text-field":"›","text-size":18,
                  "text-rotation-alignment":"map","text-offset":[-0.7,0],"text-keep-upright":false,"text-allow-overlap":true},
                paint:{"text-color":"#b78369","text-halo-color":"#fffdf8","text-halo-width":1.6,"text-opacity":1}});
              syncVoyageLinkVisibility();
            }
            type RoutePrecision = "overview" | "detail" | "full";
            const routePrecisionForZoom=(zoom:number):RoutePrecision=>zoom<8?"overview":zoom<12?"detail":"full";
            // Gestion centralisée des résolutions : les coordonnées API sont [latitude, longitude].
            // overview sert de référence globale ; detail/full ne sont demandés que pour les
            // parcours dont un segment intersecte la fenêtre courante.
            const routeCache=new Map<string,[number,number][]>();
            const routeRequests=new Map<string,Promise<[number,number][]|null>>();
            const fetchRoute=async(id:string,precision:RoutePrecision):Promise<[number,number][]|null>=>{
              const key=id+":"+precision;
              const cached=routeCache.get(key);
              if(cached)return cached;
              const pending=routeRequests.get(key);
              if(pending)return pending;
              const request=(async()=>{
                const response=await fetch("/api/public/defi/parcours/"+encodeURIComponent(id)+"?precision="+precision,{cache:"no-store"});
                if(!response.ok)return null;
                const result=await response.json();
                const route=(Array.isArray(result.route)?result.route:[]).filter(
                  (p:unknown):p is [number,number]=>Array.isArray(p)&&p.length===2&&valid(p[0],p[1]));
                if(route.length<2)return null;
                routeCache.set(key,route);
                return route;
              })();
              routeRequests.set(key,request);
              try{return await request;}
              finally{if(routeRequests.get(key)===request)routeRequests.delete(key);}
            };
            const routeIntersectsViewport=(route:[number,number][])=>{
              if(!route.length)return false;
              const bounds=map.getBounds();
              const west=bounds.getWest(),east=bounds.getEast();
              const south=bounds.getSouth(),north=bounds.getNorth();
              const segmentIntersects=(x0:number,y0:number,x1:number,y1:number)=>{
                // Découpage paramétrique du segment par le rectangle de la fenêtre.
                const dx=x1-x0,dy=y1-y0;
                const p=[-dx,dx,-dy,dy],q=[x0-west,east-x0,y0-south,north-y0];
                let start=0,end=1;
                for(let i=0;i<4;i++){
                  if(p[i]===0){if(q[i]<0)return false;continue;}
                  const ratio=q[i]/p[i];
                  if(p[i]<0)start=Math.max(start,ratio);
                  else end=Math.min(end,ratio);
                  if(start>end)return false;
                }
                return true;
              };
              for(let i=0;i<route.length;i++){
                const [lat,lon]=route[i];
                if(lon>=west&&lon<=east&&lat>=south&&lat<=north)return true;
                if(i>0){
                  const [previousLat,previousLon]=route[i-1];
                  if(segmentIntersects(previousLon,previousLat,lon,lat))return true;
                }
              }
              return false;
            };
            const displayedRoutes=new Map<string,{precision:RoutePrecision;route:[number,number][]}>();
            let traceResolutionRequest=0;
            const resolveRouteForViewport=async(id:string,precision:RoutePrecision,request:number)=>{
              if(precision==="overview"){
                const route=await fetchRoute(id,"overview");
                if(request!==traceResolutionRequest)return null;
                if(route){displayedRoutes.set(id,{precision:"overview",route});return route;}
                return displayedRoutes.get(id)?.route||null;
              }
              const overview=routeCache.get(id+":overview")||await fetchRoute(id,"overview");
              if(request!==traceResolutionRequest)return null;
              if(!overview)return displayedRoutes.get(id)?.route||null;
              if(!routeIntersectsViewport(overview)){
                displayedRoutes.set(id,{precision:"overview",route:overview});
                return overview;
              }
              const detailed=await fetchRoute(id,precision);
              if(request!==traceResolutionRequest)return null;
              if(detailed){
                displayedRoutes.set(id,{precision,route:detailed});
                return detailed;
              }
              // Une réponse manquante ne remplace jamais le dernier tracé valide.
              const lastValid=displayedRoutes.get(id);
              if(lastValid)return lastValid.route;
              displayedRoutes.set(id,{precision:"overview",route:overview});
              return overview;
            };
            let cameraRequest = 0;
            requestDayCamera = (date:string, initialFocus=false, target?:[number,number]) => {
              const request = ++cameraRequest;
              // Appliquer un premier cadrage sans attendre le réseau : les marqueurs
              // du jour sont déjà rendus. Le chargement GPS ne doit jamais bloquer
              // Précédent/Suivant ni laisser la caméra sur l'ancienne journée.
              const markerBounds = new maplibregl.LngLatBounds();
              if (target && Number.isFinite(target[0]) && Number.isFinite(target[1])) {
                markerBounds.extend(target);
              } else {
                for (const marker of Array.from(element.querySelectorAll<HTMLElement>(".memory-map-marker"))) {
                  if (marker.dataset.date !== date) continue;
                  const lat = Number(marker.dataset.latitude);
                  const lon = Number(marker.dataset.longitude);
                  if (Number.isFinite(lat) && Number.isFinite(lon) &&
                      Math.abs(lat) <= 90 && Math.abs(lon) <= 180) markerBounds.extend([lon, lat]);
                }
              }

              const fallbackBounds = () => {
                const bounds = new maplibregl.LngLatBounds();
                const stage = points.find((point) => point.date === date);
                if (stage) bounds.extend([stage.longitude, stage.latitude]);
                else {
                  bounds.extend(initialBounds.getSouthWest());
                  bounds.extend(initialBounds.getNorthEast());
                }
                return bounds;
              };

              const applyCamera = (bounds:maplibregl.LngLatBounds, usedRoute=false, attempt=0) => {
                if (request !== cameraRequest || bounds.isEmpty()) return;
                if (element.clientWidth < 2 || element.clientHeight < 2) {
                  if (attempt < 30) requestAnimationFrame(() => applyCamera(bounds, usedRoute, attempt + 1));
                  return;
                }
                map.resize();
                map.stop();
                const southWest = bounds.getSouthWest();
                const northEast = bounds.getNorthEast();
                const distance = southWest.distanceTo(northEast);
                const singlePoint = distance < 100;
                const maxZoom = target
                  ? Math.max(map.getZoom(), 11)
                  : usedRoute ? 16 : (singlePoint ? (initialFocus ? 14 : 13) : (initialFocus ? 15 : 14));
                const options = {
                  padding: { top: 58, right: 58, bottom: 100, left: 58 },
                  maxZoom,
                  duration: initialFocus ? 6000 : 850,
                };
                const center = bounds.getCenter();
                if (target || singlePoint) {
                  map.flyTo({ center, zoom: maxZoom, duration: options.duration, essential: true });
                } else {
                  map.fitBounds(bounds, options);
                  map.once("moveend", () => {
                    if (request !== cameraRequest) return;
                    map.fitBounds(bounds, { ...options, duration: 0 });
                  });
                }
              };

              const immediateBounds = markerBounds.isEmpty() ? fallbackBounds() : markerBounds;
              applyCamera(immediateBounds);

              // Affiner ensuite le cadrage sur le parcours GPS complet si disponible.
              // La réponse réseau ne peut agir que si cette journée est toujours sélectionnée.
              const dailyActivity = memories
                .filter((memory) => memory.type === "sport" && memory.date === date && memory.id && memory.parcours)
                .sort((a, b) => String(b.order || "").localeCompare(String(a.order || "")))[0];
              if (!target && dailyActivity?.id) {
                void (async () => {
                  try {
                    // Le cadrage n’a besoin que de la géométrie légère ; le gestionnaire de traces affinera après le déplacement.
                    const route = await fetchRoute(dailyActivity.id!, "overview");
                    if (request !== cameraRequest || !route?.length) return;
                    const routeBounds = new maplibregl.LngLatBounds();
                    for (const [lat, lon] of route) {
                      if (Number.isFinite(lat) && Number.isFinite(lon) &&
                          Math.abs(lat) <= 90 && Math.abs(lon) <= 180) routeBounds.extend([lon, lat]);
                    }
                    if (!routeBounds.isEmpty()) applyCamera(routeBounds, true);
                  } catch {
                    // Le cadrage immédiat sur les marqueurs reste valable si le GPS échoue.
                  }
                })();
              }
            };
            const showTrace=async(id:string,date:string,fitMap=true,animate=true)=>{
              selectedTraceId=id;
              selectedTraceDate=date;
              const requestToken=++selectedTraceRequestToken;
              try{
                const precision=routePrecisionForZoom(map.getZoom());
                let route:[number,number][]|null=null;
                if(precision==="overview"){
                  route=await fetchRoute(id,"overview");
                }else{
                  const overview=routeCache.get(id+":overview")||await fetchRoute(id,"overview");
                  if(requestToken!==selectedTraceRequestToken)return;
                  if(overview&&routeIntersectsViewport(overview)){
                    route=await fetchRoute(id,precision);
                    if(!route)route=displayedRoutes.get(id)?.route||overview;
                  }else{
                    // Hors fenêtre : rester sur une résolution légère, sans demander le tracé complet.
                    route=overview||displayedRoutes.get(id)?.route||null;
                  }
                }
                if(requestToken!==selectedTraceRequestToken||selectedTraceId!==id||selectedTraceDate!==date)return;
                if(!route)route=displayedRoutes.get(id)?.route||null;
                if(!route||route.length<2)return;
                displayedRoutes.set(id,{precision:precision==="overview"||!routeIntersectsViewport(route)?"overview":precision,route});
                const line={type:"Feature" as const,properties:{date},
                  geometry:{type:"LineString" as const,coordinates:route.map(p=>[p[1],p[0]])}};
                const traceSource = map.getSource("trace-sportive") as maplibregl.GeoJSONSource | undefined;
                if(traceSource){
                  traceSource.setData(animate && line.geometry.coordinates.length > 2
                    ? {...line, geometry:{...line.geometry, coordinates:line.geometry.coordinates.slice(0,2)}}
                    : line);
                }else{
                  map.addSource("trace-sportive",{type:"geojson",data:line});
                  map.addLayer({id:"trace-sportive",type:"line",source:"trace-sportive",
                    layout:{"line-cap":"round","line-join":"round"},
                    paint:{"line-color":selectedDay
                      ? ["case",["==",["get","date"],selectedDay],currentDayColor,"#df784a"]
                      : "#df784a",
                      "line-width":selectedDay
                        ? ["case",["==",["get","date"],selectedDay],6,4]
                        : 5}});
                  map.addLayer({id:"trace-sportive-fleches",type:"symbol",source:"trace-sportive",
                    layout:{"symbol-placement":"line","symbol-spacing":170,"text-field":"›","text-size":20,
                      "text-rotation-alignment":"map","text-offset":[-0.7,0],"text-keep-upright":false,"text-allow-overlap":true},
                    paint:{"text-color":"#df784a","text-halo-color":"#fffdf8","text-halo-width":1.6,"text-opacity":1}});
                  syncCurrentDayArrowStyle("trace-sportive-fleches");
                  syncVoyageLinkVisibility();
                }
                // Invalider toute animation précédente puis masquer la même journée dans
                // la couche globale : sinon le tracé complet reste visible sous l'animation.
                const animationToken = ++selectedTraceAnimationToken;
                if (map.getLayer("tous-les-traces")) {
                  map.setFilter("tous-les-traces", ["!=", ["get", "date"], date]);
                }
                if (map.getLayer("tous-les-traces-fleches")) {
                  map.setFilter("tous-les-traces-fleches", ["!=", ["get", "date"], date]);
                }
                const animationCoordinates = line.geometry.coordinates;
                if (animate && animationCoordinates.length > 2) {
                  const startedAt = performance.now();
                  const duration = Math.min(2200, Math.max(700, animationCoordinates.length * 2));
                  const drawFrame = (now:number) => {
                    if (animationToken !== selectedTraceAnimationToken || selectedTraceId !== id || selectedTraceDate !== date) return;
                    const progress = Math.min(1, (now - startedAt) / duration);
                    const count = Math.min(animationCoordinates.length, Math.max(2, Math.ceil(progress * animationCoordinates.length)));
                    (map.getSource("trace-sportive") as maplibregl.GeoJSONSource | undefined)?.setData({...line, geometry:{...line.geometry, coordinates:animationCoordinates.slice(0,count)}});
                    if (progress < 1) requestAnimationFrame(drawFrame);
                  };
                  (map.getSource("trace-sportive") as maplibregl.GeoJSONSource | undefined)?.setData({...line, geometry:{...line.geometry, coordinates:animationCoordinates.slice(0,2)}});
                  requestAnimationFrame(drawFrame);
                }
                if(map.getLayer("trace-sportive")) map.moveLayer("trace-sportive");
                if(map.getLayer("trace-sportive-fleches")) map.moveLayer("trace-sportive-fleches");
                const bounds=new maplibregl.LngLatBounds();
                for(const pt of route)bounds.extend([pt[1],pt[0]]);
                // Le tracé est dessiné ici ; seul requestDayCamera peut déplacer la caméra.
                if (fitMap) requestDayCamera(date, false, [bounds.getCenter().lng, bounds.getCenter().lat]);
              }catch{ /* Conserver la carte en cas d'indisponibilité. */ }
            };
            const allTracesButton=document.createElement("button");
            allTracesButton.type="button";
            allTracesButton.className="maplibregl-ctrl";
            for (const eventName of ["pointerdown","mousedown","touchstart","dblclick","click"]) {
              allTracesButton.addEventListener(eventName,(event)=>{
                event.stopPropagation();
                if(eventName==="dblclick") event.preventDefault();
              });
            }
            allTracesButton.textContent="Afficher les liens";
            allTracesButton.setAttribute("aria-label","Afficher les liens");
            allTracesButton.setAttribute("aria-pressed","false");
            allTracesButton.style.cssText="background:#fffdf8;color:#173d3b;border:1px solid #d8d2c5;border-radius:4px;padding:9px 12px;font:600 13px 'DM Sans',sans-serif;cursor:pointer;box-shadow:0 1px 5px #0002;";
            // Point d'entrée unique pour charger, sélectionner la résolution et afficher les traces.
            const loadAllTraces=async()=>{
              const request=++traceResolutionRequest;
              const activities=memories.filter(e=>e.type==="sport"&&e.id);
              const precision=routePrecisionForZoom(map.getZoom());
              await Promise.all(activities.map(async activity=>{
                try{await resolveRouteForViewport(activity.id!,precision,request);}
                catch{/* La dernière géométrie valide reste affichée. */}
              }));
              if(request!==traceResolutionRequest)return;
              const features=activities.map((activity,index)=>{
                const displayed=displayedRoutes.get(activity.id!);
                return displayed?{type:"Feature" as const,properties:{index,date:activity.date},
                  geometry:{type:"LineString" as const,coordinates:displayed.route.map(p=>[p[1],p[0]] as [number,number])}}:null;
              }).filter((feature):feature is NonNullable<typeof feature>=>feature!==null);
              if(!features.length)return;
              const data={type:"FeatureCollection" as const,features};
              if(map.getSource("tous-les-traces")){
                (map.getSource("tous-les-traces") as maplibregl.GeoJSONSource).setData(data);
              }else{
                map.addSource("tous-les-traces",{type:"geojson",data});
                map.addLayer({id:"tous-les-traces",type:"line",source:"tous-les-traces",
                  layout:{"line-cap":"round","line-join":"round"},
                  paint:{"line-color":selectedDay
                    ? ["case",["==",["get","date"],selectedDay],currentDayColor,"#df784a"]
                    : "#df784a",
                  "line-width":selectedDay
                    ? ["case",["==",["get","date"],selectedDay],5,2.5]
                    : 3.5,
                  "line-opacity":.85}});
                map.addLayer({id:"tous-les-traces-fleches",type:"symbol",source:"tous-les-traces",
                  layout:{"symbol-placement":"line","symbol-spacing":170,"symbol-sort-key":["case",["==",["get","date"],selectedDay],1,0],"text-field":"›","text-size":19,
                    "text-rotation-alignment":"map","text-offset":[-0.7,0],"text-keep-upright":false,"text-allow-overlap":true},
                  paint:{"text-color":"#df784a","text-halo-color":"#fffdf8","text-halo-width":1.7,"text-opacity":1}});
                syncCurrentDayArrowStyle("tous-les-traces-fleches");
                syncVoyageLinkVisibility();
              }
              const selectedActivity=activities.some(memory=>memory.date===selectedDay);
              const backgroundFilter=selectedActivity?["!=",["get","date"],selectedDay] as any:null;
              if(map.getLayer("tous-les-traces"))map.setFilter("tous-les-traces",backgroundFilter);
              if(map.getLayer("tous-les-traces-fleches"))map.setFilter("tous-les-traces-fleches",backgroundFilter);
            };
            allTracesButton.addEventListener("click",()=>{
              voyageLinksHidden = !voyageLinksHidden;
              syncVoyageLinkVisibility();
              allTracesButton.textContent = voyageLinksHidden
                ? "Afficher les liens"
                : "Masquer les liens";
              allTracesButton.setAttribute("aria-label", allTracesButton.textContent);
              allTracesButton.setAttribute("aria-pressed", String(voyageLinksHidden));
            });
            const linksControl = document.createElement("div");
            linksControl.className = "maplibregl-ctrl map-links-control";
            linksControl.append(allTracesButton);
            map.addControl({
              onAdd: () => linksControl,
              onRemove: () => linksControl.remove()
            } as maplibregl.IControl, "top-left");
            const mapVisibilityToggle = document.getElementById("map-visibility-toggle");
            mapVisibilityToggle?.addEventListener("click", () => {
              const hidden = element.style.display === "none";
              if (hidden) {
                element.style.display = "";
                mapVisibilityToggle.textContent = "Masquer la carte";
                mapVisibilityToggle.setAttribute("aria-expanded", "true");
                requestAnimationFrame(() => map.resize());
              } else {
                element.style.display = "none";
                mapVisibilityToggle.textContent = "Afficher la carte";
                mapVisibilityToggle.setAttribute("aria-expanded", "false");
              }
            });
            // Réévaluer la fenêtre après chaque déplacement. Ne recharger le tracé
            // sélectionné que si le niveau de zoom ou son appartenance à la fenêtre change.
            let appliedTracePrecision=routePrecisionForZoom(map.getZoom());
            let selectedTraceWasVisible=false;
            map.on("moveend",()=>{
              const precision=routePrecisionForZoom(map.getZoom());
              const selectedActivity=memories.find(memory=>memory.type==="sport"&&memory.id===selectedTraceId);
              const overview=selectedActivity?.id?routeCache.get(selectedActivity.id+":overview"):undefined;
              const selectedIsVisible=!!overview&&routeIntersectsViewport(overview);
              const refreshSelected=precision!==appliedTracePrecision||selectedIsVisible!==selectedTraceWasVisible;
              appliedTracePrecision=precision;
              selectedTraceWasVisible=selectedIsVisible;
              void loadAllTraces();
              if(selectedTraceId&&refreshSelected)void showTrace(selectedTraceId,selectedTraceDate,false,false);
            });
            // Tous les tracés restent visibles ; le tracé du jour est ensuite animé au premier plan.
            void loadAllTraces().then(() => {
              const activity = memories.find((memory) => memory.type === "sport" && memory.date === selectedDay && memory.id);
              if (activity?.id) void showTrace(activity.id, activity.date, false);
            });
            window.addEventListener("voyage:jour", (event) => {
              const date = (event as CustomEvent<{date?:string}>).detail?.date || "";
              const activity = memories.find((memory) => memory.type === "sport" && memory.date === date && memory.id);
              if (activity?.id) void showTrace(activity.id, date, false);
            });
            for(const memory of memories.slice(-1500)){
              const marker=document.createElement("button");
              marker.type="button";
              marker.classList.add("memory-map-marker");
              if((memory.type==="photo" && memory.src)||memory.type==="video"||memory.type==="video-fichier") marker.classList.add("memory-map-photo-marker");
              marker.dataset.date=memory.date;
              marker.dataset.latitude=String(memory.latitude);
              marker.dataset.longitude=String(memory.longitude);
              marker.dataset.memoryType=memory.type;
              marker.dataset.memoryKey=memory.type==="photo" ? String(memory.src||"") : memory.type==="sport" ? String(memory.id||"") : memory.type==="video" ? "video:"+String(memory.youtubeId||"") : memory.type==="video-fichier" ? "video-file:"+String(memory.key||"") : "";
              marker.title=memory.titre+" · "+memory.date;
              marker.setAttribute("aria-label",memory.titre+" du "+memory.date);
              marker.style.cssText=(memory.type==="photo"&&memory.src)||(memory.type==="video"&&memory.youtubeId)||(memory.type==="video-fichier"&&memory.src)
                ?"width:44px;height:44px;cursor:pointer;border:2px solid #fff;border-radius:8px;"+
                  (memory.type==="video-fichier"?"background:#24352f;color:#fff;font-size:20px;":"background:#fff url('"+String(memory.type==="photo"?memory.src:"https://i.ytimg.com/vi/"+memory.youtubeId+"/hqdefault.jpg").replace(/'/g,"%27")+"') center/cover no-repeat;")+
                  "box-shadow:0 2px 8px #0005;"
                :"width:16px;height:16px;cursor:pointer;border:2px solid #fff;border-radius:50%;"+
                  "background:#c86f4d;box-shadow:0 1px 5px #0005;";
              if(memory.type==="video-fichier")marker.textContent="▶";
              marker.style.zIndex = marker.classList.contains("memory-map-photo-marker") ? "3" : "2";
              if(selectedDay && memory.date === selectedDay){
                if(!marker.classList.contains("memory-map-photo-marker")) marker.style.backgroundColor = currentDayColor;
              }
              const panel=document.createElement("div");
              panel.className="map-popup-content";
              // Pour les photos, garder un aperçu compact : uniquement l'image et le lien galerie.
              if(memory.type!=="photo"){
                const title=document.createElement("strong");title.textContent=memory.titre;
                const when=document.createElement("span");
                when.textContent=memory.dateHeure
                  ?memory.dateHeure.slice(0,10)+" · "+memory.dateHeure.slice(11,16)
                  :memory.date+" · heure non renseignée";
                panel.append(title,when);
              }
              if(memory.type==="sport"){
                const metrics=document.createElement("span");
                metrics.style.cssText="display:block;margin:5px 0;color:#274c41;font-size:.82rem;";
                const details:string[]=[];
                if(memory.sport){
                  details.push(memory.sport.charAt(0).toLocaleUpperCase("fr-FR")+memory.sport.slice(1));
                }
                if(typeof memory.km==="number"&&Number.isFinite(memory.km)&&memory.km>0){
                  details.push(memory.km.toLocaleString("fr-FR",{maximumFractionDigits:2})+" km");
                }
                if(typeof memory.minutes==="number"&&Number.isFinite(memory.minutes)&&memory.minutes>0){
                  details.push(memory.minutes+" min");
                  if(memory.sport && /course|run|running|trail/i.test(memory.sport) &&
                    typeof memory.km==="number"&&Number.isFinite(memory.km)&&memory.km>0){
                    const paceSeconds=Math.round(memory.minutes*60/memory.km);
                    details.push(Math.floor(paceSeconds/60)+":"+String(paceSeconds%60).padStart(2,"0")+" min/km");
                  }
                }
                metrics.textContent=details.join(" · ");
                if(details.length)panel.append(metrics);
              }else if(memory.type!=="photo"){
                const precision=document.createElement("span");precision.textContent=memory.precision;
                panel.append(precision);
              }
              if((memory.type==="photo"&&memory.src)||(memory.type==="video"&&memory.youtubeId)){
                const image=document.createElement("img");
                image.src=memory.type==="photo"?memory.src!:"https://i.ytimg.com/vi/"+memory.youtubeId+"/hqdefault.jpg";
                image.alt=memory.titre;image.loading="lazy";
                image.style.cssText="width:100%;max-width:230px;max-height:160px;object-fit:cover;border-radius:6px;margin:6px 0;";
                panel.append(image);
              }
              if(memory.type==="video-fichier"&&memory.src){
                const player=document.createElement("video");player.src=memory.src;player.controls=true;player.preload="metadata";player.playsInline=true;
                player.style.cssText="width:100%;max-width:230px;max-height:160px;border-radius:6px;margin:6px 0;background:#000;";
                panel.append(player);
              }
              if(memory.type==="sport"&&memory.id&&memory.parcours){
                const action=document.createElement("button");
                action.type="button";action.textContent="Zoomer sur le parcours";
                action.style.cssText="cursor:pointer;border:0;background:none;color:#274c41;font-weight:700;text-decoration:underline;padding:6px 0;";
                action.addEventListener("click",()=>void showTrace(memory.id!,memory.date));
                panel.append(action);
              }else if(memory.type==="photo"&&memory.src){
                const link=document.createElement("a");
                link.href="/galerie/?photo="+encodeURIComponent(memory.src);
                link.textContent="Voir dans la galerie";panel.append(link);
              }else if(memory.type==="video"&&memory.youtubeId){
                const link=document.createElement("a");
                link.href="/galerie/";
                link.textContent="Voir dans la galerie";panel.append(link);
              }
              else if(memory.type==="video-fichier"&&memory.src){
                const link=document.createElement("a");
                link.href="/galerie/";
                link.textContent="Voir dans la galerie";panel.append(link);
              }
              if(selectedDay && selectedDay !== memory.date){
                marker.style.opacity=".38";marker.style.transform="scale(.82)";
              }
              const popup = new maplibregl.Popup({
                offset: 14,
                className: "memory-map-popup",
                closeButton: true,
                closeOnClick: true,
                maxWidth: "280px",
              }).setDOMContent(panel);
              popup.on("open", () => {
                // Placer la popup active au-dessus des autres éléments.
                const popupElement = popup.getElement();
                if (popupElement) popupElement.style.zIndex = "1000";
                element.querySelectorAll<HTMLElement>(".maplibregl-popup").forEach((other) => {
                  if (other !== popupElement) other.style.zIndex = "1";
                });

                // Garantir que la popup reste dans les limites visibles de la carte,
                // même lorsque le marqueur est près d'un bord ou sur petit écran.
                const keepPopupVisible = (attempts = 2) => {
                  if (!popup.isOpen() || !popupElement || attempts < 0) return;
                  const mapRect = element.getBoundingClientRect();
                  const popupRect = popupElement.getBoundingClientRect();
                  const inset = 12;
                  let shiftX = 0;
                  let shiftY = 0;
                  if (popupRect.right > mapRect.right - inset) {
                    shiftX = popupRect.right - (mapRect.right - inset);
                  } else if (popupRect.left < mapRect.left + inset) {
                    shiftX = popupRect.left - (mapRect.left + inset);
                  }
                  if (popupRect.bottom > mapRect.bottom - inset) {
                    shiftY = popupRect.bottom - (mapRect.bottom - inset);
                  } else if (popupRect.top < mapRect.top + inset) {
                    shiftY = popupRect.top - (mapRect.top + inset);
                  }
                  if (shiftX || shiftY) {
                    map.once("moveend", () => requestAnimationFrame(() => keepPopupVisible(attempts - 1)));
                    map.panBy([shiftX, shiftY], { duration: 220 });
                  }
                };
                requestAnimationFrame(() => keepPopupVisible());
                // Recalculer aussi après le chargement de la miniature, dont la
                // taille peut changer les dimensions de la fenêtre.
                const popupImage = popupElement?.querySelector("img");
                popupImage?.addEventListener("load", () => requestAnimationFrame(() => keepPopupVisible()), { once: true });
              });
              new maplibregl.Marker({element:marker,anchor:"center"})
                .setLngLat([memory.longitude,memory.latitude])
                .setPopup(popup).addTo(map);
            }
            window.addEventListener("voyage:voir-sur-carte",(event)=>{
              const detail=(event as CustomEvent<{date?:string;kind?:string;key?:string;latitude?:number;longitude?:number}>).detail;
              if(!detail?.date)return;
              if(element.style.display==="none") mapVisibilityToggle?.click();
              element.scrollIntoView({behavior:"smooth",block:"start"});
              // Sélectionner le jour sans lancer d'abord son cadrage général :
              // celui-ci pourrait laisser la caméra sur une autre activité de la journée.
              updateSelectedDay(detail.date,false);
              if(detail.kind==="sport" && detail.key) void showTrace(detail.key,detail.date,true);
              const markers=Array.from(element.querySelectorAll<HTMLElement>(".memory-map-marker"));
              const expectedType=detail.kind;
              let target=detail.key ? markers.find(marker=>
                marker.dataset.memoryKey===detail.key&&(!expectedType||marker.dataset.memoryType===expectedType)
              ) : undefined;
              const hasCoordinates=Number.isFinite(detail.latitude)&&Number.isFinite(detail.longitude)&&
                Math.abs(Number(detail.latitude))<=85&&Math.abs(Number(detail.longitude))<=180;
              const normalizePhotoKey=(value:string)=>{
                try{return new URL(value,window.location.origin).pathname;}
                catch{return value.split("?")[0];}
              };
              // Comparer aussi les chemins normalisés (URL relative/absolue, caractères encodés)
              // avant d'utiliser les coordonnées, qui peuvent être partagées par plusieurs photos.
              if(!target&&detail.kind==="photo"&&detail.key){
                const wanted=normalizePhotoKey(detail.key);
                target=markers.find(marker=>marker.dataset.memoryType==="photo"&&
                  normalizePhotoKey(marker.dataset.memoryKey||"")===wanted);
              }
              // Dernier recours : ne choisir un marqueur photo par coordonnées que si la position
              // identifie une seule photo, pour ne jamais ouvrir arbitrairement un autre souvenir.
              if(!target&&detail.kind==="photo"&&hasCoordinates){
                const matches=markers.filter(marker=>marker.dataset.memoryType==="photo"&&
                  Math.abs(Number(marker.dataset.latitude)-Number(detail.latitude))<0.0001&&
                  Math.abs(Number(marker.dataset.longitude)-Number(detail.longitude))<0.0001);
                if(matches.length===1)target=matches[0];
              }
              if(target){
                const lat=Number(target.dataset.latitude),lon=Number(target.dataset.longitude);
                if(Number.isFinite(lat)&&Number.isFinite(lon)){
                  const center=map.getCenter();
                  const alreadyCentered=Math.abs(center.lat-lat)<0.0001&&Math.abs(center.lng-lon)<0.0001&&map.getZoom()>=12;
                  if(alreadyCentered){
                    target.click();
                  }else{
                    // N'ouvrir que la popup de l'objet exact après le cadrage ciblé.
                    map.once("moveend",()=>target?.click());
                    requestDayCamera(detail.date,false,[lon,lat]);
                  }
                }else{
                  target.click();
                }
              }else if(hasCoordinates){
                // Si aucun marqueur exploitable n'existe, au moins cadrer la position
                // de la photo fournie par la galerie plutôt que le parcours de la journée.
                requestDayCamera(detail.date,false,[Number(detail.longitude),Number(detail.latitude)]);
              }
            });
            const mapRequest = new URLSearchParams(window.location.search);
            const requestedPhoto = mapRequest.get("photoMap");
            const requestedVideo = mapRequest.get("videoMap");
            const requestedFileVideo = mapRequest.get("videoFileMap");
            const requestedDate = mapRequest.get("date");
            const requestedLat = Number(mapRequest.get("lat"));
            const requestedLon = Number(mapRequest.get("lon"));
            if ((requestedPhoto || requestedVideo || requestedFileVideo) && requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) &&
                Number.isFinite(requestedLat) && Math.abs(requestedLat) <= 85 &&
                Number.isFinite(requestedLon) && Math.abs(requestedLon) <= 180) {
              window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte", {detail:{
                date:requestedDate,kind:requestedFileVideo?"video-fichier":requestedVideo?"video":"photo",key:requestedFileVideo?"video-file:"+requestedFileVideo:requestedPhoto||undefined,latitude:requestedLat,longitude:requestedLon
              }}));
              mapRequest.delete("photoMap");mapRequest.delete("videoMap");mapRequest.delete("videoFileMap");mapRequest.delete("date");mapRequest.delete("lat");mapRequest.delete("lon");
              const remaining = mapRequest.toString();
              window.history.replaceState({}, "", window.location.pathname + (remaining ? "?" + remaining : "") + window.location.hash);
            }
            // Toutes les données et tous les marqueurs sont prêts : cadrage initial.
            if (selectedDay) requestDayCamera(selectedDay, true);
            // Si la carte démarre dans un onglet masqué, la recadrer quand son
            // conteneur devient réellement visible (notamment sur mobile).
            let lastMapSize = "";
            const mapSizeObserver = new ResizeObserver(() => {
              const size = element.clientWidth + "x" + element.clientHeight;
              if (size === lastMapSize || element.clientWidth < 2 || element.clientHeight < 2) return;
              lastMapSize = size;
              if (selectedDay) requestAnimationFrame(() => requestDayCamera(selectedDay, true));
            });
            mapSizeObserver.observe(element);
          }catch{ /* Les étapes restent affichées si les événements échouent. */ }
        })();
      });
    } else {
      element.textContent = "La carte apparaîtra lorsque les premières étapes seront ajoutées.";
    }
    })();
  }
</script>

<style is:global>
