---
import type { Etape } from "../lib/data";

interface Props { etapes: Etape[]; }
const { etapes } = Astro.props;
const points = etapes
  .filter((etape) => Number.isFinite(etape.latitude) && Number.isFinite(etape.longitude))
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((etape) => ({
    slug: etape.slug,
    date: etape.date,
    titre: etape.titre,
    ville: etape.ville,
    pays: etape.pays,
    latitude: etape.latitude,
    longitude: etape.longitude,
    statut: etape.statut || "passee",
  }));
---
<div class="voyage-map-shell">
  <div id="carte-voyage" class="voyage-map" data-etapes={JSON.stringify(points)} role="region" aria-label="Carte interactive des étapes du voyage">
    <div class="map-loading">Chargement de la carte…</div>
  </div>
  <noscript><p>Activez JavaScript pour explorer la carte. Les étapes restent accessibles dans le journal.</p></noscript>
</div>
<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  type Point = {
    slug: string;
    date: string;
    titre: string;
    ville: string;
    pays: string;
    latitude: number;
    longitude: number;
    statut: "passee" | "actuelle" | "future";
  };

  const element = document.getElementById("carte-voyage");
  if (element) {
    (async () => {
      let points: Point[] = JSON.parse(element.dataset.etapes || "[]");
      // Charger les nouvelles étapes R2 à chaque visite, sans reconstruire Astro.
      try {
        const result = await fetch("/api/public/etapes");
        if (result.ok) {
          const data = await result.json();
          points = data.etapes.filter((p: Point) => Number.isFinite(p.latitude) && Number.isFinite(p.longitude))
            .sort((a: Point, b: Point) => String(a.date).localeCompare(String(b.date)));
        }
      } catch { /* Garder la liste statique existante en cas d'indisponibilité. */ }
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    const central = points.find((p) => p.statut === "actuelle") || points[points.length - 1];
    if (central) {
      // Préparer le cadrage avant le premier rendu pour éviter le zoom provisoire.
      const initialBounds = new maplibregl.LngLatBounds();
      points.forEach((p) => initialBounds.extend([p.longitude, p.latitude]));
      // Démarrer le chargement des souvenirs pendant que le fond de carte s'initialise.
      const mapEventsPromise = Promise.all([
        fetch("/api/public/photos").catch(() => null),
        fetch("/api/public/carte-evenements").catch(() => null),
      ]);
      const map = new maplibregl.Map({
        container: element,
        style: "https://tiles.openfreemap.org/styles/liberty",
        // Vue globale au départ ; l'animation vers les souvenirs arrive après leur chargement.
        center: [0, 20],
        zoom: 0,
        cooperativeGestures: false,
        scrollZoom: false,
        attributionControl: false,
        dragRotate: false,
        pitchWithRotate: false,
      });
      map.doubleClickZoom.disable();
      // Ne contrôler que les lignes du voyage, sans toucher aux routes de fond de carte.
      // Masquer les liens entre les étapes dès l'ouverture de la carte.
      let voyageLinksHidden = true;
      const voyageLinkLayers = ["trajet-parcouru", "trajet-prevu", "fil-des-souvenirs", "fil-des-souvenirs-fleches"];
      const syncVoyageLinkVisibility = () => {
        for (const id of voyageLinkLayers) {
          if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", voyageLinksHidden ? "none" : "visible");
        }
      };
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
      map.addControl(new maplibregl.FullscreenControl(), "top-right");

      for (const p of points) {
        const marker = document.createElement("button");
        marker.type = "button";
        marker.className = "map-marker map-marker-" + p.statut;
        marker.style.zIndex = "1";
        marker.setAttribute("aria-label", "Ouvrir l'étape " + p.ville);
        marker.title = p.ville;
        marker.textContent = p.statut === "actuelle" ? "●" : "•";

        const contenu = document.createElement("div");
        contenu.className = "map-popup-content";
        const label = document.createElement("span");
        label.textContent = p.statut === "actuelle" ? "Étape actuelle" : p.statut === "future" ? "À venir" : "Étape parcourue";
        label.className = "map-popup-label";
        const titre = document.createElement("strong");
        titre.textContent = p.titre;
        const pays = document.createElement("span");
        pays.textContent = p.pays;
        const jour = document.createElement("button");
        jour.type = "button";
        jour.className = "map-popup-day-button";
        jour.style.cssText = "display:block;margin:8px 0;padding:7px 10px;border:1px solid #d8d8d0;border-radius:3px;background:#f8f6f0;color:#274c41;font:inherit;font-size:.8rem;cursor:pointer;text-align:left";
        jour.textContent = "Voir les souvenirs de cette journée";
        jour.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("voyage:jour", { detail: { date: p.date } }));
          document.querySelector("#daily-view")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        const lien = document.createElement("a");
        lien.href = base + "/etapes/" + encodeURIComponent(p.slug) + "/";
        lien.textContent = "Voir les photos et le récit";
        contenu.append(label, titre, pays, jour, lien);

        new maplibregl.Marker({ element: marker, anchor: "center" })
          .setLngLat([p.longitude, p.latitude])
          .setPopup(new maplibregl.Popup({ offset: 22 }).setDOMContent(contenu))
          .addTo(map);
      }

      const parcours = points.filter((p) => p.statut !== "future");
      const futur = points.filter((p) => p.statut === "future");
      map.on("load", () => {
        const traces: { id: string; points: Point[]; couleur: string; tirets?: number[] }[] = [
          { id: "trajet-parcouru", points: parcours, couleur: "#bb714c" },
          { id: "trajet-prevu", points: [...parcours.slice(-1), ...futur], couleur: "#52746a", tirets: [2, 2] },
        ];
        for (const trace of traces) {
          if (trace.points.length < 2) continue;
          map.addSource(trace.id, {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: {
                type: "LineString",
                coordinates: trace.points.map((p) => [p.longitude, p.latitude]),
              },
            },
          });
          map.addLayer({
            id: trace.id,
            type: "line",
            source: trace.id,
            layout: { "line-cap": "round", "line-join": "round" },
            paint: {
              "line-color": trace.couleur,
              "line-width": 3.5,
              ...(trace.tirets ? { "line-dasharray": trace.tirets } : {}),
            },
          });
          syncVoyageLinkVisibility();
        }
        const currentDayColor = getComputedStyle(document.documentElement).getPropertyValue("--current-day-sage").trim() || "#397A70";
        let selectedDay = document.documentElement.dataset.voyageDay || "";
        // Source unique des styles du jour sélectionné : marqueurs, tracés et flèches.
        const syncCurrentDayArrowStyle = (layerId:string) => {
          if (!map.getLayer(layerId)) return;
          const isCurrentDay = ["==", ["get", "date"], selectedDay];
          map.setPaintProperty(layerId, "text-color", selectedDay
            ? ["case", isCurrentDay, currentDayColor, "#df784a"]
            : "#df784a");
          // La couleur sauge s'applique au symbole, mais son contour reste blanc.
          map.setPaintProperty(layerId, "text-halo-color", "#fffdf8");
        };
        const updateSelectedDay = (date:string, fitMap = true) => {
          selectedDay = date;
          const dailyMarkers = Array.from(element.querySelectorAll<HTMLElement>(".memory-map-marker"))
            .filter((marker) => marker.dataset.date === selectedDay);
          element.querySelectorAll<HTMLElement>(".memory-map-marker").forEach((marker) => {
            const active = !selectedDay || marker.dataset.date === selectedDay;
            marker.style.opacity = active ? "1" : ".38";
            marker.style.transform = active ? "scale(1.08)" : "scale(.82)";
            marker.style.zIndex = marker.classList.contains("memory-map-photo-marker") ? "3" : "2";
            const isCurrentDay = !!selectedDay && marker.dataset.date === selectedDay;
            // Les photos du jour gardent leur contour sauge ; le bouton d'activité
            // conserve un contour blanc, même lorsque son fond passe en sauge.
            const isPhotoMarker = marker.classList.contains("memory-map-photo-marker");
            marker.style.borderColor = isCurrentDay && isPhotoMarker ? currentDayColor : "#fff";
            marker.style.borderWidth = "2px";
            if (!isPhotoMarker) {
              marker.style.backgroundColor = isCurrentDay ? currentDayColor : "#c86f4d";
            }
          });
          if (map.getLayer("tous-les-traces-fleches")) {
            map.setLayoutProperty("tous-les-traces-fleches", "symbol-sort-key", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 1, 0]
              : 0);
            syncCurrentDayArrowStyle("tous-les-traces-fleches");
          }
          syncCurrentDayArrowStyle("trace-sportive-fleches");
          if (map.getLayer("tous-les-traces")) {
            map.setPaintProperty("tous-les-traces", "line-color", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], currentDayColor, "#df784a"]
              : "#df784a");
            map.setPaintProperty("tous-les-traces", "line-width", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 5, 2.5]
              : 3.5);
            map.setLayoutProperty("tous-les-traces", "line-sort-key", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 1, 0]
              : 0);
          }
          if (map.getLayer("trace-sportive")) {
            map.setPaintProperty("trace-sportive", "line-color", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], currentDayColor, "#df784a"]
              : "#df784a");
            map.setPaintProperty("trace-sportive", "line-width", selectedDay
              ? ["case", ["==", ["get", "date"], selectedDay], 7, 3]
              : 5);
          }
          // Garder les lignes sous les flèches pour qu'elles restent lisibles.
          // Remonter ensuite les couches de flèches au-dessus de toutes les lignes.
          if (map.getLayer("tous-les-traces")) map.moveLayer("tous-les-traces");
          if (map.getLayer("trace-sportive")) map.moveLayer("trace-sportive");
          if (map.getLayer("fil-des-souvenirs-fleches")) map.moveLayer("fil-des-souvenirs-fleches");
          if (map.getLayer("trace-sportive-fleches") && selectedTraceDate === selectedDay && selectedDay) {
            map.moveLayer("tous-les-traces-fleches");
            map.moveLayer("trace-sportive-fleches");
          } else {
            if (map.getLayer("trace-sportive-fleches")) map.moveLayer("trace-sportive-fleches");
            if (map.getLayer("tous-les-traces-fleches")) map.moveLayer("tous-les-traces-fleches");
          }
          const dateLabel = document.querySelector<HTMLElement>("#daily-date");
          if (dateLabel) {
            dateLabel.style.backgroundColor = selectedDay ? currentDayColor : "transparent";
            dateLabel.style.color = selectedDay ? "#fffdf8" : "";
            dateLabel.style.padding = selectedDay ? "4px 8px" : "";
            dateLabel.style.borderRadius = selectedDay ? "3px" : "";
            dateLabel.style.display = selectedDay ? "inline-block" : "";
          }
          if (!dailyMarkers.length) return;
          const bounds = new maplibregl.LngLatBounds();
          for (const marker of dailyMarkers) {
            const lat = Number(marker.dataset.latitude);
            const lon = Number(marker.dataset.longitude);
            if (Number.isFinite(lat) && Number.isFinite(lon)) bounds.extend([lon, lat]);
          }
          if (bounds.isEmpty() || !fitMap) return;
          if (dailyMarkers.length === 1) {
            map.easeTo({center: bounds.getCenter(), zoom: 10, duration: 650});
          } else {
            map.fitBounds(bounds, {padding: {top: 55, right: 55, bottom: 100, left: 55}, maxZoom: 13, duration: 650});
          }
        };
        window.addEventListener("voyage:jour", (event) => {
          const detail = (event as CustomEvent<{date?:string}>).detail;
          updateSelectedDay(detail?.date || "");
        });
        // En bas à gauche, afficher uniquement le lieu correspondant au jour sélectionné.
        const placeControl = document.createElement("div");
        placeControl.className = "map-day-control maplibregl-ctrl";
        placeControl.setAttribute("aria-live", "polite");
        placeControl.style.cssText = "padding:8px 11px;background:#fffdf8;color:#173d3b;border:1px solid #d8d2c5;border-radius:4px;font:600 12px 'DM Sans',sans-serif;box-shadow:0 1px 5px #0002;max-width:220px;";
        const dailyPlaceLabels = new Map<string,string>();
        const updatePlaceLabel = (date:string) => {
          const stage = points.find((point) => point.date === date);
          placeControl.textContent = dailyPlaceLabels.get(date) || (stage ? [stage.ville, stage.pays].filter(Boolean).join(", ") : "");
          placeControl.style.display = placeControl.textContent ? "" : "none";
        };
        updatePlaceLabel(selectedDay);
        window.addEventListener("voyage:jour", (event) => {
          const detail = (event as CustomEvent<{date?:string}>).detail;
          updatePlaceLabel(detail?.date || "");
        });
        map.addControl({
          onAdd: () => placeControl,
          onRemove: () => placeControl.remove()
        } as maplibregl.IControl, "bottom-left");

        // Bouton indépendant à droite pour afficher directement la journée d’hier.
          let yesterdayKeyForControl = "";
          window.addEventListener("voyage:jour", (event) => {
            const detail = (event as CustomEvent<{date?:string}>).detail;
            yesterdayButton.style.display = detail?.date === yesterdayKeyForControl ? "none" : "";
          });
          const yesterdayButton = document.createElement("button");
          yesterdayButton.type = "button";
          yesterdayButton.className = "map-today-control maplibregl-ctrl";
          yesterdayButton.textContent = "Hier";
          yesterdayButton.setAttribute("aria-label", "Afficher la journée d’hier");
          yesterdayButton.addEventListener("click", (event) => {
            event.stopPropagation();
            window.dispatchEvent(new CustomEvent("voyage:hier"));
          });
          for (const eventName of ["pointerdown", "mousedown", "touchstart", "dblclick"]) {
            yesterdayButton.addEventListener(eventName, (event) => {
              event.stopPropagation();
              if (eventName === "dblclick") event.preventDefault();
            });
          }
          map.addControl({
            onAdd: () => yesterdayButton,
            onRemove: () => yesterdayButton.remove()
          } as maplibregl.IControl, "bottom-right");
        // Frise de voyage : chacune des photos publiques et toutes les activités
        // GPX publiées sont positionnées selon l'heure de leur capture/départ.
        // Une position de ville/étape reste explicitement approximative.
        void (async()=>{
          type Event={type:"photo"|"sport"|"etape";date:string;dateHeure?:string|null;
            order:string|null;latitude:number;longitude:number;titre:string;
            src?:string;etape?:string;id?:string;distance?:number;km?:number;minutes?:number;sport?:string;precision:string;parcours?:boolean};
          const valid=(lat:unknown,lon:unknown)=>
            typeof lat==="number"&&typeof lon==="number"&&Number.isFinite(lat)&&
            Number.isFinite(lon)&&Math.abs(lat)<=85&&Math.abs(lon)<=180;
          const localClock=(value:number)=>{
            if(!Number.isFinite(value))return null;
            const parts=new Intl.DateTimeFormat("fr-FR",{timeZone:"Europe/Paris",
              year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",
              minute:"2-digit",hourCycle:"h23"}).formatToParts(new Date(value));
            const n=(name:string)=>parts.find(p=>p.type===name)?.value||"";
            return n("year")+"-"+n("month")+"-"+n("day")+"T"+n("hour")+":"+n("minute");
          };
          try{
            const [photosResponse,sportsResponse]=await mapEventsPromise;
            // La carte et son bouton de tracés doivent rester disponibles même si
            // l'une des API d'événements est momentanément indisponible.
            const photoData=photosResponse?.ok?await photosResponse.json():{};
            const sportData=sportsResponse?.ok?await sportsResponse.json():{};
            const photos=photoData.photos;
            const courses=sportData.courses;
            const memories:Event[]=[];
            const parisToday = new Intl.DateTimeFormat("en-CA", {
              timeZone: "Europe/Paris", year: "numeric", month: "2-digit", day: "2-digit"
            }).format(new Date());
            const yesterday = new Date(parisToday + "T12:00:00");
            yesterday.setDate(yesterday.getDate() - 1);
            const yesterdayKey = new Intl.DateTimeFormat("en-CA", {
              timeZone: "Europe/Paris", year: "numeric", month: "2-digit", day: "2-digit"
            }).format(yesterday);
            yesterdayKeyForControl = yesterdayKey;
            for(const photo of (Array.isArray(photos)?photos:[])){
              if(!photo)continue;
              // Les coordonnées GPS suffisent à afficher une photo sur la carte :
              // aucune étape n'est nécessaire. L'étape ne sert que de repli indicatif.
              const stage=photo.etape?points.find(p=>p.slug===photo.etape):undefined;
              const gps=valid(photo.latitude,photo.longitude);
              if(!gps&&!stage)continue;
              const dateHeure=typeof photo.dateHeure==="string"?photo.dateHeure:null;
              const date=String(dateHeure?.slice(0,10)||photo.datePrise||photo.ajouteLe?.slice(0,10)||stage?.date||"");
              memories.push({type:"photo",date,dateHeure,
                order:dateHeure||(date?date+"T23:59":null),
                latitude:gps?photo.latitude:stage!.latitude,
                longitude:gps?photo.longitude:stage!.longitude,
                precision:gps?(photo.precision==="exact"?"GPS exact":"GPS approximatif"):
                  "Ville / étape (emplacement indicatif)",
                titre:photo.alt||"Photo du voyage",src:photo.src,etape:photo.etape});
            }
            for(const sport of (Array.isArray(courses)?courses:[])){
              if(!sport||!valid(sport.latitude,sport.longitude))continue;
              const clock=localClock(Number(sport.fin));
              const date=String(sport.date||clock?.slice(0,10)||"");
              memories.push({type:"sport",date,dateHeure:clock,
                order:clock||date+"T23:59",latitude:sport.latitude,longitude:sport.longitude,
                precision:"Tracé de l'activité",titre:sport.titre||"Activité sportive",
                id:sport.id,km:sport.km,minutes:sport.minutes,
                sport:sport.sport||"autre",parcours:sport.parcours===true});
            }
            // Les étapes structurent les dates sans heure ; elles ancrent
            // l'itinéraire avant les événements détaillés de la même journée.
            // Le libellé de la carte reprend le lieu et l'heure du premier souvenir du jour,
            // comme le diaporama, avec le même géocodage inversé pour les activités.
            const reversePlace=async(lat:number,lon:number):Promise<string>=>{
              try{
                const response=await fetch("https://photon.komoot.io/reverse?lon="+encodeURIComponent(String(lon))+"&lat="+encodeURIComponent(String(lat))+"&limit=1",{headers:{"Accept":"application/json"}});
                if(!response.ok)return "";
                const properties=(await response.json())?.features?.[0]?.properties;
                if(!properties)return "";
                const locality=properties.city||properties.town||properties.village||properties.municipality||properties.county||properties.state;
                return [locality,properties.country].filter((value,index,array)=>typeof value==="string"&&value.trim()&&array.indexOf(value)===index).join(", ");
              }catch{return "";}
            };
            const dayEvents=[...memories].filter(event=>event.date).sort((a,b)=>String(a.order).localeCompare(String(b.order)));
            for(const event of dayEvents){
              if(dailyPlaceLabels.has(event.date))continue;
              const timeValue=event.dateHeure||event.order||"";
              const timeMatch=String(timeValue).match(/T(\d{2}:\d{2})/);
              let location="";
              if(event.type==="photo"){
                const stage=(event.etape?points.find(point=>point.slug===event.etape):undefined)||[...points].filter(point=>point.date<=event.date).sort((a,b)=>b.date.localeCompare(a.date))[0]||points.find(point=>point.date===event.date);
                location=[stage?.ville,stage?.pays].filter(Boolean).join(", ")||"Localisation de la photo";
              }else{
                location=await reversePlace(event.latitude,event.longitude);
              }
              dailyPlaceLabels.set(event.date,[location,timeMatch?.[1]].filter(Boolean).join(" · "));
            }
            updatePlaceLabel(selectedDay);
            const stages:Event[]=points.filter(p=>p.statut!=="future").map(p=>({
              type:"etape",date:p.date,order:p.date+"T00:00",
              latitude:p.latitude,longitude:p.longitude,titre:p.ville,precision:"Étape du voyage"}));
            const timeline=[...stages,...memories].filter(e=>e.order)
              .sort((a,b)=>String(a.order).localeCompare(String(b.order)));
            // Utiliser hier si des données existent, sinon le dernier jour passé documenté.
            const datedMemories = [...memories, ...stages].filter(e => e.date && e.date < parisToday);
            const targetDay = datedMemories.some(e => e.date === yesterdayKey)
              ? yesterdayKey
              : datedMemories.reduce((latest, e) => e.date > latest ? e.date : latest, "");
            const targetEvents = datedMemories.filter(e => e.date === targetDay);
            if (targetEvents.length) {
              document.documentElement.dataset.voyageDay = targetDay;
              const targetBounds = new maplibregl.LngLatBounds();
              for (const event of targetEvents) targetBounds.extend([event.longitude, event.latitude]);
              const targetCenter = targetBounds.getCenter();
              const animateToYesterday = () => {
                map.jumpTo({ center: [0, 20], zoom: 0 });
                map.flyTo({
                  center: [targetCenter.lng, targetCenter.lat],
                  zoom: targetEvents.length === 1 ? 11 : 10,
                  duration: 2400,
                  essential: true
                });
                window.dispatchEvent(new CustomEvent("voyage:jour", { detail: { date: targetDay } }));
                if (targetDay === yesterdayKey) {
                  yesterdayButton.click();
                }
              };
              if (map.loaded()) animateToYesterday();
              else map.once("load", animateToYesterday);
            }
            if(timeline.length>=2){
              map.addSource("fil-des-souvenirs",{type:"geojson",data:{
                type:"Feature",properties:{},
                geometry:{type:"LineString",coordinates:timeline.map(p=>[p.longitude,p.latitude])}}});
              map.addLayer({id:"fil-des-souvenirs",type:"line",source:"fil-des-souvenirs",
                layout:{"line-cap":"round","line-join":"round"},
                paint:{"line-color":"#b78369","line-width":2,"line-dasharray":[2,3],"line-opacity":.68}});
              map.addLayer({id:"fil-des-souvenirs-fleches",type:"symbol",source:"fil-des-souvenirs",
                layout:{"symbol-placement":"line","symbol-spacing":150,"text-field":"›","text-size":18,
                  "text-rotation-alignment":"map","text-offset":[-0.7,0],"text-keep-upright":false,"text-allow-overlap":true},
                paint:{"text-color":"#b78369","text-halo-color":"#fffdf8","text-halo-width":1.6,"text-opacity":1}});
              syncVoyageLinkVisibility();
            }
            type RoutePrecision = "overview" | "detail" | "full";
            const routePrecisionForZoom=(zoom:number):RoutePrecision=>zoom<8?"overview":zoom<12?"detail":"full";
            const routeCache=new Map<string,[number,number][]>();
            const fetchRoute=async(id:string,precision:RoutePrecision):Promise<[number,number][]|null>=>{
              const key=id+":"+precision;
              const cached=routeCache.get(key);
              if(cached)return cached;
              const response=await fetch("/api/public/defi/parcours/"+encodeURIComponent(id)+"?precision="+precision,{cache:"no-store"});
              if(!response.ok)return null;
              const result=await response.json();
              const route=(Array.isArray(result.route)?result.route:[]).filter(
                (p:unknown):p is [number,number]=>Array.isArray(p)&&p.length===2&&valid(p[0],p[1]));
              if(route.length<2)return null;
              routeCache.set(key,route);
              return route;
            };
            let selectedTraceId:string|null=null;
            let selectedTraceDate="";
            const showTrace=async(id:string,date:string,fitMap=true)=>{
              selectedTraceId=id;
              selectedTraceDate=date;
              try{
                const route=await fetchRoute(id,routePrecisionForZoom(map.getZoom()));
                if(!route)return;
                if(route.length<2)return;
                const line={type:"Feature" as const,properties:{date},
                  geometry:{type:"LineString" as const,coordinates:route.map(p=>[p[1],p[0]])}};
                if(map.getSource("trace-sportive")){
                  (map.getSource("trace-sportive") as maplibregl.GeoJSONSource).setData(line);
                }else{
                  map.addSource("trace-sportive",{type:"geojson",data:line});
                  map.addLayer({id:"trace-sportive",type:"line",source:"trace-sportive",
                    layout:{"line-cap":"round","line-join":"round"},
                    paint:{"line-color":selectedDay
                      ? ["case",["==",["get","date"],selectedDay],currentDayColor,"#df784a"]
                      : "#df784a",
                      "line-width":selectedDay
                        ? ["case",["==",["get","date"],selectedDay],6,4]
                        : 5}});
                  map.addLayer({id:"trace-sportive-fleches",type:"symbol",source:"trace-sportive",
                    layout:{"symbol-placement":"line","symbol-spacing":170,"text-field":"›","text-size":20,
                      "text-rotation-alignment":"map","text-offset":[-0.7,0],"text-keep-upright":false,"text-allow-overlap":true},
                    paint:{"text-color":"#df784a","text-halo-color":"#fffdf8","text-halo-width":1.6,"text-opacity":1}});
                  syncCurrentDayArrowStyle("trace-sportive-fleches");
                  syncVoyageLinkVisibility();
                }
                const bounds=new maplibregl.LngLatBounds();
                for(const pt of route)bounds.extend([pt[1],pt[0]]);
                if(fitMap)map.fitBounds(bounds,{padding:60,maxZoom:16,duration:650});
              }catch{ /* Conserver la carte en cas d'indisponibilité. */ }
            };
            const allTracesButton=document.createElement("button");
            allTracesButton.type="button";
            allTracesButton.className="maplibregl-ctrl";
            for (const eventName of ["pointerdown","mousedown","touchstart","dblclick","click"]) {
              allTracesButton.addEventListener(eventName,(event)=>{
                event.stopPropagation();
                if(eventName==="dblclick") event.preventDefault();
              });
            }
            allTracesButton.textContent="Afficher les liens";
            allTracesButton.setAttribute("aria-label","Afficher les liens");
            allTracesButton.setAttribute("aria-pressed","false");
            allTracesButton.style.cssText="background:#fffdf8;color:#173d3b;border:1px solid #d8d2c5;border-radius:4px;padding:9px 12px;font:600 13px 'DM Sans',sans-serif;cursor:pointer;box-shadow:0 1px 5px #0002;";
            const loadAllTraces=async(fitMap=true)=>{
              const activities=memories.filter(e=>e.type==="sport"&&e.id);
              const precision=routePrecisionForZoom(map.getZoom());
              const routes=await Promise.all(activities.map(async activity=>{
                try{
                  const route=await fetchRoute(activity.id!,precision);
                  return route?route.map(p=>[p[1],p[0]] as [number,number]):null;
                }catch{return null;}
              }));
              const features=routes.map((route,index)=>({route,activity:activities[index]}))
                .filter((item):item is {route:[number,number][];activity:Event}=>item.route!==null)
                .map(({route,activity},index)=>({
                  type:"Feature" as const,properties:{index,date:activity.date},
                  geometry:{type:"LineString" as const,coordinates:route}
                }));
              if(!features.length)return;
              const data={type:"FeatureCollection" as const,features};
              if(map.getSource("tous-les-traces")){
                (map.getSource("tous-les-traces") as maplibregl.GeoJSONSource).setData(data);
              }else{
                map.addSource("tous-les-traces",{type:"geojson",data});
                map.addLayer({id:"tous-les-traces",type:"line",source:"tous-les-traces",
                  layout:{"line-cap":"round","line-join":"round"},
                  paint:{"line-color":selectedDay
                    ? ["case",["==",["get","date"],selectedDay],currentDayColor,"#df784a"]
                    : "#df784a",
                  "line-width":selectedDay
                    ? ["case",["==",["get","date"],selectedDay],5,2.5]
                    : 3.5,
                  "line-opacity":.85}});
                map.addLayer({id:"tous-les-traces-fleches",type:"symbol",source:"tous-les-traces",
                  layout:{"symbol-placement":"line","symbol-spacing":170,"symbol-sort-key":["case",["==",["get","date"],selectedDay],1,0],"text-field":"›","text-size":19,
                    "text-rotation-alignment":"map","text-offset":[-0.7,0],"text-keep-upright":false,"text-allow-overlap":true},
                  paint:{"text-color":"#df784a","text-halo-color":"#fffdf8","text-halo-width":1.7,"text-opacity":1}});
                syncCurrentDayArrowStyle("tous-les-traces-fleches");
                syncVoyageLinkVisibility();
              }
              const bounds=new maplibregl.LngLatBounds();
              for(const feature of features){
                for(const coordinate of feature.geometry.coordinates)bounds.extend(coordinate);
              }
              if(fitMap&&!bounds.isEmpty())map.fitBounds(bounds,{padding:60,maxZoom:12,duration:650});
            };
            allTracesButton.addEventListener("click",()=>{
              voyageLinksHidden = !voyageLinksHidden;
              syncVoyageLinkVisibility();
              allTracesButton.textContent = voyageLinksHidden
                ? "Afficher les liens"
                : "Masquer les liens";
              allTracesButton.setAttribute("aria-label", allTracesButton.textContent);
              allTracesButton.setAttribute("aria-pressed", String(voyageLinksHidden));
            });
            const linksControl = document.createElement("div");
            linksControl.className = "maplibregl-ctrl map-links-control";
            linksControl.append(allTracesButton);
            map.addControl({
              onAdd: () => linksControl,
              onRemove: () => linksControl.remove()
            } as maplibregl.IControl, "top-left");
            const mapVisibilityToggle = document.getElementById("map-visibility-toggle");
            const dailyHeadingTitle = document.querySelector<HTMLElement>(".daily-heading-title");
            mapVisibilityToggle?.addEventListener("click", () => {
              const hidden = element.style.display === "none";
              if (hidden) {
                element.style.display = "";
                mapVisibilityToggle.textContent = "Masquer la carte";
                mapVisibilityToggle.setAttribute("aria-expanded", "true");
                dailyHeadingTitle?.classList.remove("daily-heading-visible");
                requestAnimationFrame(() => map.resize());
              } else {
                element.style.display = "none";
                mapVisibilityToggle.textContent = "Afficher la carte";
                mapVisibilityToggle.setAttribute("aria-expanded", "false");
                dailyHeadingTitle?.classList.add("daily-heading-visible");
              }
            });
            // Les tracés changent de résolution aux seuils de zoom, sans recharger
            // une résolution déjà reçue pour une activité.
            let appliedPrecision=routePrecisionForZoom(map.getZoom());
            map.on("zoomend",()=>{
              const precision=routePrecisionForZoom(map.getZoom());
              if(precision===appliedPrecision)return;
              appliedPrecision=precision;
              if(map.getSource("tous-les-traces"))void loadAllTraces(false);
              if(selectedTraceId)void showTrace(selectedTraceId,selectedTraceDate,false);
            });
            // Les tracés GPS sont chargés et affichés automatiquement à l'ouverture.
            void loadAllTraces();
            for(const memory of memories.slice(-1500)){
              const marker=document.createElement("button");
              marker.type="button";
              marker.classList.add("memory-map-marker");
              if(memory.type==="photo" && memory.src) marker.classList.add("memory-map-photo-marker");
              marker.dataset.date=memory.date;
              marker.dataset.latitude=String(memory.latitude);
              marker.dataset.longitude=String(memory.longitude);
              marker.dataset.memoryKey=memory.type==="photo" ? String(memory.src||"") : memory.type==="sport" ? String(memory.id||"") : "";
              marker.title=memory.titre+" · "+memory.date;
              marker.setAttribute("aria-label",memory.titre+" du "+memory.date);
              marker.style.cssText=memory.type==="photo"&&memory.src
                ?"width:44px;height:44px;cursor:pointer;border:2px solid #fff;border-radius:8px;"+
                  "background:#fff url('"+String(memory.src).replace(/'/g,"%27")+"') center/cover no-repeat;"+
                  "box-shadow:0 2px 8px #0005;"
                :"width:16px;height:16px;cursor:pointer;border:2px solid #fff;border-radius:50%;"+
                  "background:#c86f4d;box-shadow:0 1px 5px #0005;";
              marker.style.zIndex = marker.classList.contains("memory-map-photo-marker") ? "3" : "2";
              if(selectedDay && memory.date === selectedDay){
                if(!marker.classList.contains("memory-map-photo-marker")) marker.style.backgroundColor = currentDayColor;
              }
              const panel=document.createElement("div");
              panel.className="map-popup-content";
              const title=document.createElement("strong");title.textContent=memory.titre;
              const when=document.createElement("span");
              when.textContent=memory.dateHeure
                ?memory.dateHeure.slice(0,10)+" · "+memory.dateHeure.slice(11,16)
                :memory.date+" · heure non renseignée";
              panel.append(title,when);
              if(memory.type==="sport"){
                const metrics=document.createElement("span");
                metrics.style.cssText="display:block;margin:5px 0;color:#274c41;font-size:.82rem;";
                const details:string[]=[];
                if(memory.sport){
                  details.push(memory.sport.charAt(0).toLocaleUpperCase("fr-FR")+memory.sport.slice(1));
                }
                if(typeof memory.km==="number"&&Number.isFinite(memory.km)&&memory.km>0){
                  details.push(memory.km.toLocaleString("fr-FR",{maximumFractionDigits:2})+" km");
                }
                if(typeof memory.minutes==="number"&&Number.isFinite(memory.minutes)&&memory.minutes>0){
                  details.push(memory.minutes+" min");
                  if(memory.sport && /course|run|running|trail/i.test(memory.sport) &&
                    typeof memory.km==="number"&&Number.isFinite(memory.km)&&memory.km>0){
                    const paceSeconds=Math.round(memory.minutes*60/memory.km);
                    details.push(Math.floor(paceSeconds/60)+":"+String(paceSeconds%60).padStart(2,"0")+" min/km");
                  }
                }
                metrics.textContent=details.join(" · ");
                if(details.length)panel.append(metrics);
              }else{
                const precision=document.createElement("span");precision.textContent=memory.precision;
                panel.append(precision);
              }
              if(memory.type==="photo"&&memory.src){
                const image=document.createElement("img");image.src=memory.src;
                image.alt=memory.titre;image.loading="lazy";
                image.style.cssText="width:100%;max-width:230px;max-height:160px;object-fit:cover;border-radius:6px;margin:6px 0;";
                panel.append(image);
              }
              if(memory.type==="sport"&&memory.id&&memory.parcours){
                const action=document.createElement("button");
                action.type="button";action.textContent="Zoomer sur le parcours";
                action.style.cssText="cursor:pointer;border:0;background:none;color:#274c41;font-weight:700;text-decoration:underline;padding:6px 0;";
                action.addEventListener("click",()=>void showTrace(memory.id!,memory.date));
                panel.append(action);
              }else if(memory.type==="photo"&&memory.src){
                const link=document.createElement("a");
                link.href="/galerie/?photo="+encodeURIComponent(memory.src);
                link.textContent="Voir dans la galerie";panel.append(link);
              }
              if(selectedDay && selectedDay !== memory.date){
                marker.style.opacity=".38";marker.style.transform="scale(.82)";
              }
              const popup = new maplibregl.Popup({
                offset: 14,
                className: "memory-map-popup",
                closeButton: true,
                closeOnClick: true,
                maxWidth: "280px",
              }).setDOMContent(panel);
              popup.on("open", () => {
                // Placer la popup active au-dessus des autres éléments.
                const popupElement = popup.getElement();
                if (popupElement) popupElement.style.zIndex = "1000";
                element.querySelectorAll<HTMLElement>(".maplibregl-popup").forEach((other) => {
                  if (other !== popupElement) other.style.zIndex = "1";
                });

                // Garantir que la popup reste dans les limites visibles de la carte,
                // même lorsque le marqueur est près d'un bord ou sur petit écran.
                const keepPopupVisible = (attempts = 2) => {
                  if (!popup.isOpen() || !popupElement || attempts < 0) return;
                  const mapRect = element.getBoundingClientRect();
                  const popupRect = popupElement.getBoundingClientRect();
                  const inset = 12;
                  let shiftX = 0;
                  let shiftY = 0;
                  if (popupRect.right > mapRect.right - inset) {
                    shiftX = popupRect.right - (mapRect.right - inset);
                  } else if (popupRect.left < mapRect.left + inset) {
                    shiftX = popupRect.left - (mapRect.left + inset);
                  }
                  if (popupRect.bottom > mapRect.bottom - inset) {
                    shiftY = popupRect.bottom - (mapRect.bottom - inset);
                  } else if (popupRect.top < mapRect.top + inset) {
                    shiftY = popupRect.top - (mapRect.top + inset);
                  }
                  if (shiftX || shiftY) {
                    map.once("moveend", () => requestAnimationFrame(() => keepPopupVisible(attempts - 1)));
                    map.panBy([shiftX, shiftY], { duration: 220 });
                  }
                };
                requestAnimationFrame(() => keepPopupVisible());
                // Recalculer aussi après le chargement de la miniature, dont la
                // taille peut changer les dimensions de la fenêtre.
                const popupImage = popupElement?.querySelector("img");
                popupImage?.addEventListener("load", () => requestAnimationFrame(() => keepPopupVisible()), { once: true });
              });
              new maplibregl.Marker({element:marker,anchor:"center"})
                .setLngLat([memory.longitude,memory.latitude])
                .setPopup(popup).addTo(map);
            }
            window.addEventListener("voyage:voir-sur-carte",(event)=>{
              const detail=(event as CustomEvent<{date?:string;kind?:string;key?:string;latitude?:number;longitude?:number}>).detail;
              if(!detail?.date)return;
              if(element.style.display==="none") mapVisibilityToggle?.click();
              element.scrollIntoView({behavior:"smooth",block:"start"});
              updateSelectedDay(detail.date,true);
              if(detail.key){
                const target=Array.from(element.querySelectorAll<HTMLElement>(".memory-map-marker"))
                  .find(marker=>marker.dataset.memoryKey===detail.key);
                if(target){
                  const lat=Number(target.dataset.latitude),lon=Number(target.dataset.longitude);
                  if(Number.isFinite(lat)&&Number.isFinite(lon)){
                    // Centrer d'abord la carte, puis ouvrir la popup une fois le déplacement terminé :
                    // MapLibre peut ainsi calculer son placement à partir de la position finale.
                    const destination = new maplibregl.LngLat(lon,lat);
                    const alreadyCentered = map.getCenter().distanceTo(destination) < 8 && map.getZoom() >= 11;
                    map.stop();
                    if(alreadyCentered){
                      target.click();
                    }else{
                      map.once("moveend",()=>target.click());
                      map.easeTo({center:[lon,lat],zoom:Math.max(map.getZoom(),11),duration:450});
                    }
                  }else{
                    target.click();
                  }
                } else if (Number.isFinite(detail.latitude) && Number.isFinite(detail.longitude) &&
                    Math.abs(Number(detail.latitude)) <= 85 && Math.abs(Number(detail.longitude)) <= 180) {
                  map.stop();
                  map.easeTo({center:[Number(detail.longitude),Number(detail.latitude)],zoom:Math.max(map.getZoom(),11),duration:450});
                }
              }
            });
            const mapRequest = new URLSearchParams(window.location.search);
            const requestedPhoto = mapRequest.get("photoMap");
            const requestedDate = mapRequest.get("date");
            const requestedLat = Number(mapRequest.get("lat"));
            const requestedLon = Number(mapRequest.get("lon"));
            if (requestedPhoto && requestedDate && /^\\d{4}-\\d{2}-\\d{2}$/.test(requestedDate) &&
                Number.isFinite(requestedLat) && Math.abs(requestedLat) <= 85 &&
                Number.isFinite(requestedLon) && Math.abs(requestedLon) <= 180) {
              window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte", {detail:{
                date:requestedDate,kind:"photo",key:requestedPhoto,latitude:requestedLat,longitude:requestedLon
              }}));
              mapRequest.delete("photoMap");mapRequest.delete("date");mapRequest.delete("lat");mapRequest.delete("lon");
              const remaining = mapRequest.toString();
              window.history.replaceState({}, "", window.location.pathname + (remaining ? "?" + remaining : "") + window.location.hash);
            }
            if (selectedDay) updateSelectedDay(selectedDay, false);
          }catch{ /* Les étapes restent affichées si les événements échouent. */ }
        })();
      });
    } else {
      element.textContent = "La carte apparaîtra lorsque les premières étapes seront ajoutées.";
    }
    })();
  }
</script>
