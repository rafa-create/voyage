---
import Base from "../../layouts/Base.astro";
import { pays, dateFr, type Pays } from "../../lib/data";
import { chemin } from "../../lib/paths";

interface Props { paysItem: Pays; }

export function getStaticPaths() {
  return pays.map((paysItem) => ({
    params: { slug: paysItem.slug },
    props: { paysItem },
  }));
}

const { paysItem } = Astro.props;
---

<Base title={paysItem.nom} active="pays">
  <section class="page-intro container">
    <p class="eyebrow"><a href={chemin("/pays/")}>TOUS LES PAYS</a> / DESTINATION</p>
    <h1>{paysItem.nom}<span class="heading-dot">.</span></h1>
    <p>{paysItem.etapes.length} {paysItem.etapes.length > 1 ? "étapes" : "étape"} dans ce pays.</p>
  </section>
  <section class="container section">
    <div class="cards-grid" id="country-stages" data-pays={paysItem.slug}>
      {paysItem.etapes.map((etape) => (
        <a class="step-card" href={chemin("/etapes/" + etape.slug + "/")}>
          {etape.photos[0] ? (
            <img src={chemin(etape.photos[0].src)} alt={etape.photos[0].alt} loading="lazy" width="720" height="480" />
          ) : <div class="card-illustration"></div>}
          <div class="card-body">
            <span class="card-meta">{dateFr(etape.date)} · {etape.ville}</span>
            <h2>{etape.titre}</h2>
            <span class="card-more">Voir l'étape</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    function slugify(x:string){return x.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");}
    const grid=document.getElementById("country-stages");
    if(grid){
      fetch("/api/public/etapes").then(r=>r.ok?r.json():null).then(data=>{
        if(!data)return;
        const matching=data.etapes.filter((e:{pays:string})=>slugify(e.pays)===grid.dataset.pays);
        grid.replaceChildren();
        for(const e of matching){
          const a=document.createElement("a");a.className="step-card";a.href="/etapes/"+encodeURIComponent(e.slug)+"/";
          const card=document.createElement("div");card.className="card-body";
          const meta=document.createElement("span");meta.className="card-meta";meta.textContent=e.date+" · "+e.ville;
          const h=document.createElement("h2");h.textContent=e.titre;
          const more=document.createElement("span");more.className="card-more";more.textContent="Voir l'étape";
          card.append(meta,h,more);a.append(card);grid.append(a);
        }
      }).catch(()=>{});
    }
  </script>
</Base>
