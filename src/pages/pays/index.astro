---
import Base from "../../layouts/Base.astro";
import { pays } from "../../lib/data";
import { chemin } from "../../lib/paths";
---

<Base title="Pays" active="pays">
  <section class="page-intro container">
    <p class="eyebrow">CARTE DES SOUVENIRS</p>
    <h1>Explorer par pays<span class="heading-dot">.</span></h1>
    <p>À chaque destination ses étapes, ses photos et ses histoires.</p>
  </section>
  <section class="container section">
    {pays.length ? (
      <div class="country-grid">
        {pays.map((paysItem, index) => (
          <a class="country-card" href={chemin("/pays/" + paysItem.slug + "/")}>
            <span class="country-index">{String(index + 1).padStart(2, "0")} / DESTINATION</span>
            <h2>{paysItem.nom}</h2>
            <span>{paysItem.etapes.length} {paysItem.etapes.length > 1 ? "étapes" : "étape"} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-symbol" aria-hidden="true">◎</div>
        <h2>La carte attend ses destinations</h2>
        <p>Les pays se créeront automatiquement dès qu'une étape sera ajoutée au carnet.</p>
      </div>
    )}
  </section>
</Base>
