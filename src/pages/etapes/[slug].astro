---
import Base from "../../layouts/Base.astro";
import { etapes, dateFr, idYoutube, slugifier, type Etape } from "../../lib/data";
import { chemin } from "../../lib/paths";

interface Props { etape: Etape; }

export function getStaticPaths() {
  return etapes.map((etape) => ({
    params: { slug: etape.slug },
    props: { etape },
  }));
}

const { etape } = Astro.props;
---

<Base title={etape.titre} description={etape.texte.slice(0, 155)} active="journal">
  <article>
    <header class="page-intro container story-intro">
      <p class="eyebrow"><a href={chemin("/journal/")}>JOURNAL</a> / <a href={chemin("/pays/" + slugifier(etape.pays) + "/")}>{etape.pays}</a></p>
      <p class="story-date">{dateFr(etape.date)} · {etape.ville}</p>
      <h1>{etape.titre}<span class="heading-dot">.</span></h1>
    </header>
    <section class="container story-content">
      <p class="story-text">{etape.texte}</p>
    </section>

    {etape.photos.filter(photo => !photo.src.startsWith("/media/")).length > 0 && (
      <section class="container section">
        <div class="section-heading"><div><p class="eyebrow">SOUVENIRS EN IMAGES</p><h2>Les photos</h2></div></div>
        <div class="photo-grid">
          {etape.photos.filter(photo => !photo.src.startsWith("/media/")).map((photo) => (
            <figure class="photo-tile">
              <a href={chemin(photo.src)} target="_blank" rel="noopener noreferrer" title="Ouvrir la photo en grand">
                <img src={chemin(photo.src)} alt={photo.alt} loading="lazy" width="960" height="720" />
              </a>
              {photo.legende && <figcaption>{photo.legende}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {etape.videos.length > 0 && (
      <section class="container section">
        <div class="section-heading"><div><p class="eyebrow">CARNET VIDÉO</p><h2>Les vidéos</h2></div></div>
        <div class="video-grid">
          {etape.videos.map((video) => {
            const youtubeId = idYoutube(video.url);
            return (
              <div class="video-card">
                {youtubeId ? (
                  <div class="video-frame">
                    <iframe
                      src={"https://www.youtube-nocookie.com/embed/" + youtubeId}
                      title={video.titre}
                      loading="lazy"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    ></iframe>
                  </div>
                ) : <p>Impossible d'intégrer ce lien vidéo.</p>}
                <p><a href={video.url} target="_blank" rel="noopener noreferrer">{video.titre} ↗</a></p>
              </div>
            );
          })}
        </div>
      </section>
    )}
    <section class="container section" id="photos-r2-direct" data-etape={etape.slug} hidden>
      <div class="section-heading"><div><p class="eyebrow">NOUVELLES PHOTOS</p><h2>Ajoutées depuis l'administration</h2></div></div>
      <div class="photo-grid" id="photos-r2-grid"></div>
    </section>
    <script>
      const area = document.querySelector<HTMLElement>("#photos-r2-direct");
      const grid = document.querySelector<HTMLElement>("#photos-r2-grid");
      if (area && grid) {
        fetch("/api/public/photos?etape=" + encodeURIComponent(area.dataset.etape || ""))
          .then(r => r.ok ? r.json() : { photos: [] })
          .then(({ photos }) => {
            if (!photos.length) return;
            for (const photo of photos) {
              const figure = document.createElement("figure");
              figure.className = "photo-tile";
              const a = document.createElement("a");
              a.href = photo.src;
              a.target = "_blank";
              a.rel = "noopener noreferrer";
              const img = document.createElement("img");
              img.src = photo.src;
              img.alt = photo.alt || "Photo de voyage";
              img.loading = "lazy";
              img.width = 960;
              img.height = 720;
              a.append(img);
              figure.append(a);
              grid.append(figure);
            }
            area.hidden = false;
          })
          .catch(() => {});
      }
    </script>

    <section class="container section" id="videos-r2-direct" data-etape={etape.slug} hidden>
      <div class="section-heading"><div><p class="eyebrow">VIDÉOS YOUTUBE</p><h2>Les vidéos de l'étape</h2></div></div>
      <div id="videos-r2-grid" class="video-grid"></div>
    </section>
    <script>
      const videosSection = document.querySelector<HTMLElement>("#videos-r2-direct");
      const videosGrid = document.querySelector<HTMLElement>("#videos-r2-grid");
      const slug = videosSection?.dataset.etape || "";
      if (slug && videosGrid && videosSection) {
        fetch("/api/public/videos?etape=" + encodeURIComponent(slug), {cache:"no-store"})
          .then(r => r.ok ? r.json() : {videos:[]})
          .then(({videos}) => {
            const saved = new Set<string>(Array.from(document.querySelectorAll<HTMLIFrameElement>(".video-frame iframe")).map(f => f.src.match(/embed\/([^?]+)/)?.[1] || ""));
            for (const video of videos) {
              const id = new URL(video.url).searchParams.get("v");
              if (!id || saved.has(id) || !/^[a-zA-Z0-9_-]{11}$/.test(id)) continue;
              const card = document.createElement("div"); card.className = "video-card";
              const frame = document.createElement("div"); frame.className = "video-frame";
              const iframe = document.createElement("iframe");
              iframe.src = "https://www.youtube-nocookie.com/embed/" + id;
              iframe.title = video.titre;
              iframe.loading = "lazy";
              iframe.referrerPolicy = "strict-origin-when-cross-origin";
              iframe.allowFullscreen = true;
              iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share";
              frame.append(iframe);
              const link = document.createElement("a");
              link.href = video.url; link.target="_blank"; link.rel="noopener noreferrer"; link.textContent=video.titre+" ↗";
              card.append(frame,link);videosGrid.append(card);
              saved.add(id);
            }
            videosSection.hidden = !videosGrid.childElementCount;
          }).catch(()=>{});
      }
    </script>
    <div class="container story-end"><a class="text-link" href={chemin("/journal/")}>← Retour au journal</a></div>
  </article>
</Base>
