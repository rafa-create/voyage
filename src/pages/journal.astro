---
import Base from "../layouts/Base.astro";
---

<Base title="Journal" active="journal">
  <section class="container section journal-list" aria-label="Souvenirs par date">
    <div class="journal-date-controls">
      <label for="journal-date-picker">Choisir une journée</label>
      <input id="journal-date-picker" type="date" aria-label="Choisir une date du journal" />
    </div>
    <div id="journal-souvenirs">
      <p class="empty-state">Chargement des souvenirs…</p>
    </div>
  </section>

  <script>
    type Souvenir = {src:string;alt?:string;legende?:string;titre?:string;dateHeure?:string;datePrise?:string;ajouteLe?:string;date?:string;lieu?:string;etape?:string;kind?:"photo"|"video";key?:string};
    const root=document.querySelector<HTMLElement>("#journal-souvenirs");
    const datePicker=document.querySelector<HTMLInputElement>("#journal-date-picker");
    let selectedDay="";
    const dateOf=(p:Souvenir)=>String(p.dateHeure||p.datePrise||p.date||p.ajouteLe||"").slice(0,10);
    const formatDate=(value:string)=>new Intl.DateTimeFormat("fr-FR",{weekday:"long",day:"numeric",month:"long",year:"numeric",timeZone:"UTC"}).format(new Date(value+"T12:00:00Z"));
    async function renderJournal(){
      if(!root)return;
      const [photoResponse,videoResponse]=await Promise.all([fetch("/api/public/photos",{cache:"no-store"}),fetch("/api/public/videos-fichiers",{cache:"no-store"})]);
      const photoData=photoResponse.ok?await photoResponse.json():{photos:[]};
      const videoData=videoResponse.ok?await videoResponse.json():{videos:[]};
      const photos:Souvenir[]=(photoData.photos||[]).map((p:Souvenir)=>({...p,kind:"photo" as const}));
      const videos:Souvenir[]=(videoData.videos||[]).map((v:any)=>({src:v.src,kind:"video" as const,titre:v.titre||"Vidéo du voyage",alt:v.titre||"Vidéo du voyage",date:v.date,ajouteLe:v.ajouteLe,etape:v.etape,key:v.key}));
      const souvenirs:Souvenir[]=[...photos,...videos].filter((p:Souvenir)=>/^\d{4}-\d{2}-\d{2}$/.test(dateOf(p)));
      souvenirs.sort((a,b)=>String(b.dateHeure||b.datePrise||b.date||b.ajouteLe||"").localeCompare(String(a.dateHeure||a.datePrise||a.date||a.ajouteLe||"")));
      const groups=new Map<string,Souvenir[]>();
      for(const souvenir of souvenirs){const key=dateOf(souvenir);if(!groups.has(key))groups.set(key,[]);groups.get(key)!.push(souvenir);}
      root.replaceChildren();
      if(!groups.size){
        const empty=document.createElement("div");empty.className="empty-state";
        const title=document.createElement("h2");title.textContent="Pas encore de souvenirs datés";
        const copy=document.createElement("p");copy.textContent="Les photos et vidéos apparaîtront ici, classées par date, même sans étape associée.";
        empty.append(title,copy);root.append(empty);return;
      }
      const availableDays=[...groups.keys()].sort((a,b)=>b.localeCompare(a));
      if(datePicker){datePicker.max=availableDays[0]||new Date().toISOString().slice(0,10);datePicker.value=selectedDay;}
      const visibleGroups=selectedDay?groups.has(selectedDay)?[[selectedDay,groups.get(selectedDay)!] as [string,Souvenir[]]]:[]:[...groups.entries()];
      const list=document.createElement("ol");list.className="timeline journal-days";
      for(const [day,items] of visibleGroups){
        const entry=document.createElement("li");
        const date=document.createElement("button");date.type="button";date.className="timeline-date journal-date-button";date.textContent=formatDate(day);date.setAttribute("aria-label","Changer la date du journal, date sélectionnée : "+formatDate(day));
        date.addEventListener("click",()=>{if(!datePicker)return;datePicker.value=day;try{if(typeof datePicker.showPicker==="function")datePicker.showPicker();else datePicker.focus();}catch{datePicker.focus();datePicker.click();}});
        const card=document.createElement("div");card.className="timeline-card journal-day-card";
        const grid=document.createElement("div");grid.className="photo-grid gallery-grid journal-day-photos";
        for(const souvenir of items){
          const figure=document.createElement("figure");figure.className="photo-tile";
          if(souvenir.kind==="video"){
            const video=document.createElement("video");video.src=souvenir.src;video.controls=true;video.preload="metadata";video.playsInline=true;video.setAttribute("aria-label",souvenir.titre||"Vidéo du voyage");video.style.width="100%";video.style.aspectRatio="16/9";video.style.background="#000";figure.append(video);
          }else{
            const link=document.createElement("a");link.className="photo-open";link.href="/galerie/?photo="+encodeURIComponent(souvenir.src);link.setAttribute("aria-label","Afficher la photo dans la galerie");
            const img=document.createElement("img");img.src=souvenir.src;img.alt=souvenir.alt||"Souvenir du voyage";img.loading="lazy";img.decoding="async";link.append(img);figure.append(link);
          }
          const caption=document.createElement("figcaption");
          const timeSource=String(souvenir.dateHeure||souvenir.datePrise||souvenir.date||"");
          const timeMatch=timeSource.match(/T(\d{2}:\d{2})/);const time=timeMatch ? timeMatch[1] : "";
          const place=String(souvenir.lieu||"").trim();
          const description=String(souvenir.kind==="video"?souvenir.titre||"Vidéo du voyage":souvenir.legende||souvenir.alt||"").trim();
          caption.textContent=[description,time,place].filter(Boolean).filter((value,index,all)=>all.indexOf(value)===index).join(" · ");
          if(caption.textContent)figure.append(caption);grid.append(figure);
        }
        const count=document.createElement("p");count.className="journal-day-count";count.textContent=items.length+" "+(items.length>1?"souvenirs":"souvenir");
        card.append(count,grid);entry.append(date,card);list.append(entry);
      }
      if(selectedDay&&!groups.has(selectedDay)){
        const empty=document.createElement("div");empty.className="empty-state";
        const title=document.createElement("h2");title.textContent="Aucun souvenir pour cette journée";
        const copy=document.createElement("p");copy.textContent="Choisissez une autre date dans le calendrier ou effacez la date sélectionnée pour retrouver le journal complet.";
        empty.append(title,copy);root.append(empty);
      }else root.append(list);
    }
    datePicker?.addEventListener("change",()=>{selectedDay=datePicker.value;renderJournal().catch(()=>{});});
    renderJournal().catch(()=>{
      if(root){root.replaceChildren();const p=document.createElement("p");p.className="empty-state";p.textContent="Impossible de charger les souvenirs pour le moment.";root.append(p);}
    });
  </script>
  <style is:global>
    .journal-date-controls { display: flex; align-items: center; flex-wrap: nowrap; gap: 7px; margin-bottom: 20px; overflow-x: auto; max-width: 100%; padding: 2px 2px 5px; }
    .journal-date-controls label { color: var(--muted); font-size: .76rem; white-space: nowrap; flex: 0 0 auto; }
    .journal-date-controls input { flex: 0 0 auto; width: 138px; min-width: 138px; min-height: 34px; padding: 5px 7px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface, #fff); color: var(--text, #222); font-size: .78rem; cursor: pointer; }
    .journal-date-button { display: inline-block; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
    .journal-date-button:focus-visible, .journal-date-controls button:focus-visible, .journal-date-controls input:focus-visible { outline: 2px solid var(--accent, #426b5b); outline-offset: 3px; }
    .journal-day-card { min-width: 0; }
    .journal-day-count { color: var(--muted); font-size: .8rem; margin: 8px 0 16px; }
    .journal-day-photos { margin-top: 12px; }
    .journal-day-photos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
    .journal-day-photos .photo-open { display: block; }
    .journal-day-photos .photo-tile { min-width: 0; width: 100%; }
    .journal-day-photos .photo-open img { display: block; width: 100%; height: auto; max-height: none; aspect-ratio: auto; object-fit: contain; }
    @media (max-width: 650px) {
      .journal-day-photos { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    }
    .journal-day-photos figcaption { margin-top: 7px; color: var(--muted); font-size: .78rem; }
  </style>
</Base>
