---
import Base from "../layouts/Base.astro";
import { etapes, dateFr } from "../lib/data";
import { chemin } from "../lib/paths";
---

<Base title="Journal" active="journal">
  <section class="container section journal-list" aria-label="Souvenirs par date">
    <div id="journal-souvenirs">
      <p class="empty-state">Chargement des souvenirs…</p>
    </div>
  </section>

  {etapes.length > 0 && (
    <section class="container section journal-list journal-stages" aria-label="Étapes facultatives du voyage">
      <div class="journal-stages-heading">
        <h2>Étapes du voyage <span class="heading-dot">.</span></h2>
      </div>
      <p class="journal-stages-intro">Quelques repères pour raconter le parcours — les souvenirs n'ont pas besoin d'être associés à une étape.</p>
      <ol class="timeline">
        {etapes.map((etape) => (
          <li>
            <span class="timeline-date">{dateFr(etape.date)}</span>
            <a href={chemin("/etapes/" + etape.slug + "/")} class="timeline-card">
              <span class="eyebrow">{etape.pays} · {etape.ville}</span>
              <h3>{etape.titre}</h3>
              <p>{etape.texte.slice(0, 180)}{etape.texte.length > 180 ? "…" : ""}</p>
              <span class="card-more">Lire cette étape</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <script>
    type Souvenir = {src:string;alt?:string;legende?:string;dateHeure?:string;datePrise?:string;ajouteLe?:string;lieu?:string;etape?:string};
    const root=document.querySelector<HTMLElement>("#journal-souvenirs");
    const dateOf=(p:Souvenir)=>String(p.dateHeure||p.datePrise||p.ajouteLe||"").slice(0,10);
    const formatDate=(value:string)=>new Intl.DateTimeFormat("fr-FR",{weekday:"long",day:"numeric",month:"long",year:"numeric",timeZone:"UTC"}).format(new Date(value+"T12:00:00Z"));
    async function renderJournal(){
      if(!root)return;
      const response=await fetch("/api/public/photos",{cache:"no-store"});
      if(!response.ok)throw new Error("Chargement impossible");
      const data=await response.json();
      const photos:Souvenir[]=(data.photos||[]).filter((p:Souvenir)=>/^\d{4}-\d{2}-\d{2}$/.test(dateOf(p)));
      photos.sort((a,b)=>String(b.dateHeure||b.datePrise||b.ajouteLe||"").localeCompare(String(a.dateHeure||a.datePrise||a.ajouteLe||"")));
      const groups=new Map<string,Souvenir[]>();
      for(const photo of photos){const key=dateOf(photo);if(!groups.has(key))groups.set(key,[]);groups.get(key)!.push(photo);}
      root.replaceChildren();
      if(!groups.size){
        const empty=document.createElement("div");empty.className="empty-state";
        const title=document.createElement("h2");title.textContent="Pas encore de souvenirs datés";
        const copy=document.createElement("p");copy.textContent="Les photos apparaîtront ici, classées par date, même sans étape associée.";
        empty.append(title,copy);root.append(empty);return;
      }
      const list=document.createElement("ol");list.className="timeline journal-days";
      for(const [day,items] of groups){
        const entry=document.createElement("li");
        const date=document.createElement("span");date.className="timeline-date";date.textContent=formatDate(day);
        const card=document.createElement("div");card.className="timeline-card journal-day-card";
        const grid=document.createElement("div");grid.className="photo-grid gallery-grid journal-day-photos";
        for(const photo of items){
          const figure=document.createElement("figure");figure.className="photo-tile";
          const link=document.createElement("a");link.className="photo-open";link.href="/galerie/?photo="+encodeURIComponent(photo.src);link.setAttribute("aria-label","Afficher la photo dans la galerie");
          const img=document.createElement("img");img.src=photo.src;img.alt=photo.alt||"Souvenir du voyage";img.loading="lazy";img.decoding="async";
          link.append(img);figure.append(link);
          if(photo.legende||photo.alt||photo.lieu){
            const caption=document.createElement("figcaption");caption.textContent=[photo.legende||photo.alt,photo.lieu].filter(Boolean).join(" · ");figure.append(caption);
          }
          grid.append(figure);
        }
        const count=document.createElement("p");count.className="journal-day-count";count.textContent=items.length+" "+(items.length>1?"souvenirs":"souvenir");
        card.append(count,grid);entry.append(date,card);list.append(entry);
      }
      root.append(list);
    }
    renderJournal().catch(()=>{
      if(root){root.replaceChildren();const p=document.createElement("p");p.className="empty-state";p.textContent="Impossible de charger les souvenirs pour le moment.";root.append(p);}
    });
  </script>
  <style is:global>
    .journal-stages { border-top: 1px solid var(--line); }
    .journal-stages-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 8px; }
    .journal-stages-heading > h2 { margin: 0; }
    .journal-stages > h2 { margin: 0 0 8px; }
    .journal-stages-intro { color: var(--muted); margin: 0 0 28px; max-width: 620px; }
    .journal-day-card { min-width: 0; }
    .journal-day-count { color: var(--muted); font-size: .8rem; margin: 8px 0 16px; }
    .journal-day-photos { margin-top: 12px; }
    .journal-day-photos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .journal-day-photos .photo-open { display: block; overflow: hidden; }
    .journal-day-photos .photo-open img { display: block; width: 100%; aspect-ratio: 4/3; object-fit: cover; }
    .journal-day-photos figcaption { margin-top: 7px; color: var(--muted); font-size: .78rem; }
  </style>
</Base>
