---
import Base from "../layouts/Base.astro";
import { etapes, dateFr } from "../lib/data";
import { chemin } from "../lib/paths";
---

<Base title="Journal" active="journal">
  <section class="container section journal-list" aria-label="Souvenirs par date">
    <div id="journal-souvenirs">
      <p class="empty-state">Chargement des souvenirs…</p>
    </div>
  </section>

  <script>
    type Souvenir = {src:string;alt?:string;legende?:string;dateHeure?:string;datePrise?:string;ajouteLe?:string;lieu?:string;etape?:string};
    type VideoSouvenir = {id?:string;url:string;titre:string;date?:string|null;lieu?:string;etape?:string;stepDate?:string};
    const root=document.querySelector<HTMLElement>("#journal-souvenirs");
    const dateOf=(p:Souvenir)=>String(p.dateHeure||p.datePrise||p.ajouteLe||"").slice(0,10);
    const formatDate=(value:string)=>new Intl.DateTimeFormat("fr-FR",{weekday:"long",day:"numeric",month:"long",year:"numeric",timeZone:"UTC"}).format(new Date(value+"T12:00:00Z"));
    async function renderJournal(){
      if(!root)return;
      const [photoResponse, looseVideoResponse] = await Promise.all([
        fetch("/api/public/photos",{cache:"no-store"}),
        fetch("/api/public/videos",{cache:"no-store"})
      ]);
      if(!photoResponse.ok)throw new Error("Chargement des photos impossible");
      const photoData=await photoResponse.json();
      const photos:Souvenir[]=(photoData.photos||[]).filter((p:Souvenir)=>/^\d{4}-\d{2}-\d{2}$/.test(dateOf(p)));
      const videoGroups = await Promise.all(etapes.map(async step => {
        try {
          const response=await fetch("/api/public/videos?etape="+encodeURIComponent(step.slug),{cache:"no-store"});
          const data=response.ok?await response.json():{videos:[]};
          return (data.videos||[]).map((video:VideoSouvenir)=>({...video,etape:step.slug,stepDate:step.date}));
        } catch { return []; }
      }));
      const looseVideos:VideoSouvenir[]=looseVideoResponse.ok?(await looseVideoResponse.json()).videos||[]:[];
      const videos:VideoSouvenir[]=[...looseVideos,...videoGroups.flat()];
      const videoDate=(video:VideoSouvenir)=>String(video.date||video.stepDate||"").slice(0,10);
      const days=new Set<string>();
      for(const photo of photos)days.add(dateOf(photo));
      for(const video of videos){const day=videoDate(video);if(/^\d{4}-\d{2}-\d{2}$/.test(day))days.add(day);}
      photos.sort((a,b)=>String(b.dateHeure||b.datePrise||b.ajouteLe||"").localeCompare(String(a.dateHeure||a.datePrise||a.ajouteLe||"")));
      root.replaceChildren();
      if(!days.size){
        const empty=document.createElement("div");empty.className="empty-state";
        const title=document.createElement("h2");title.textContent="Pas encore de souvenirs datés";
        const copy=document.createElement("p");copy.textContent="Les photos et vidéos apparaîtront ici, classées par date.";
        empty.append(title,copy);root.append(empty);return;
      }
      const list=document.createElement("ol");list.className="timeline journal-days";
      for(const day of [...days].sort((a,b)=>b.localeCompare(a))){
        const dayPhotos=photos.filter(photo=>dateOf(photo)===day);
        const dayVideos=videos.filter(video=>videoDate(video)===day);
        const entry=document.createElement("li");
        const date=document.createElement("span");date.className="timeline-date";date.textContent=formatDate(day);
        const card=document.createElement("div");card.className="timeline-card journal-day-card";
        const grid=document.createElement("div");grid.className="photo-grid gallery-grid journal-day-photos";
        for(const photo of dayPhotos){
          const figure=document.createElement("figure");figure.className="photo-tile";
          const link=document.createElement("a");link.className="photo-open";link.href="/galerie/?photo="+encodeURIComponent(photo.src);link.setAttribute("aria-label","Afficher la photo dans la galerie");
          const img=document.createElement("img");img.src=photo.src;img.alt=photo.alt||"Souvenir du voyage";img.loading="lazy";img.decoding="async";
          link.append(img);figure.append(link);
          const caption=document.createElement("figcaption");
          const timeSource=String(photo.dateHeure||photo.datePrise||"");
          const timeMatch=timeSource.match(/T(\d{2}:\d{2})/);
          const time=timeMatch?timeMatch[1]:"";
          const place=String(photo.lieu||"").trim();
          const description=String(photo.legende||photo.alt||"").trim();
          caption.textContent=[description,time,place].filter(Boolean).filter((value,index,all)=>all.indexOf(value)===index).join(" · ");
          if(caption.textContent)figure.append(caption);
          grid.append(figure);
        }
        for(const video of dayVideos){
          const id=String(video.url||"").match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/))([A-Za-z0-9_-]{11})/)?.[1];
          if(!id)continue;
          const figure=document.createElement("figure");figure.className="photo-tile journal-video-tile";
          const link=document.createElement("a");link.href=video.url;link.target="_blank";link.rel="noopener noreferrer";link.className="journal-video-link";link.setAttribute("aria-label","Lire la vidéo : "+video.titre);
          const img=document.createElement("img");img.src="https://i.ytimg.com/vi/"+id+"/hqdefault.jpg";img.alt=video.titre||"Vidéo du voyage";img.loading="lazy";img.decoding="async";
          const play=document.createElement("span");play.className="journal-video-play";play.textContent="▶";play.setAttribute("aria-hidden","true");
          link.append(img,play);figure.append(link);
          const caption=document.createElement("figcaption");caption.textContent=String(video.titre||"Vidéo du voyage");figure.append(caption);grid.append(figure);
        }
        const total=dayPhotos.length+dayVideos.length;
        const count=document.createElement("p");count.className="journal-day-count";count.textContent=total+" "+(total>1?"souvenirs":"souvenir");
        card.append(count,grid);entry.append(date,card);list.append(entry);
      }
      root.append(list);
    }
    renderJournal().catch(()=>{
      if(root){root.replaceChildren();const p=document.createElement("p");p.className="empty-state";p.textContent="Impossible de charger les souvenirs pour le moment.";root.append(p);}
    });
  </script>
  <style is:global>
    .journal-stages { border-top: 1px solid var(--line); }
    .journal-stages-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 8px; }
    .journal-stages-heading > h2 { margin: 0; }
    .journal-stages > h2 { margin: 0 0 8px; }
    .journal-stages-intro { color: var(--muted); margin: 0 0 28px; max-width: 620px; }
    .journal-day-card { min-width: 0; }
    .journal-day-count { color: var(--muted); font-size: .8rem; margin: 8px 0 16px; }
    .journal-day-photos { margin-top: 12px; }
    .journal-video-link { display:block;position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:6px;background:#222; }
    .journal-video-link img { display:block;width:100%;height:100%;object-fit:cover; }
    .journal-video-play { position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:48px;height:34px;border-radius:9px;background:#d71920;color:#fff;font-size:1.2rem; }
    .journal-video-tile { min-width:0; }

    .journal-day-photos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
    .journal-day-photos .photo-open { display: block; }
    .journal-day-photos .photo-tile { min-width: 0; width: 100%; }
    .journal-day-photos .photo-open img { display: block; width: 100%; height: auto; max-height: none; aspect-ratio: auto; object-fit: contain; }
    @media (max-width: 650px) {
      .journal-day-photos { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    }
    .journal-day-photos figcaption { margin-top: 7px; color: var(--muted); font-size: .78rem; }
  </style>
</Base>
