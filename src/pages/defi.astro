---
import Base from "../layouts/Base.astro";
---

<Base title="Le défi quotidien" description="Chaque jour, une course et une partie d'échecs. Le journal du voyage, les parcours récents et l'évolution de l'ELO." active="defi">
  <section class="defi-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow"><span class="eyebrow-line"></span> LE DÉFI DU VOYAGE</p>
        <h1>Un jour.<br /><em>Deux défis.</em></h1>
        <p class="hero-lead">Une partie rapide aux échecs. Une course à pied. Chaque jour, une nouvelle occasion de réussir.</p>
      </div>
      <div class="hero-today" aria-live="polite">
        <span class="hero-today-label">LE DÉFI D'AUJOURD'HUI</span>
        <strong id="hero-today-status">Chargement…</strong>
        <span id="hero-today-description">On regarde les activités du jour.</span>
        <a href="#aujourdhui">Voir aujourd'hui <span aria-hidden="true">↘</span></a>
      </div>
    </div>
  </section>

  <main class="container defi-main">
    <p id="defi-loading" class="source-line" role="status">Synchronisation des échecs et des courses…</p>
    <div id="defi-empty" class="empty-state" hidden>Le défi sera bientôt disponible.</div>
    <div id="defi-content" hidden>
      <div class="kpi-grid" aria-label="Statistiques du défi">
        <div class="kpi"><small>JOURS ÉCOULÉS</small><strong id="kpi-days">—</strong><span>depuis le départ</span></div>
        <div class="kpi"><small>ÉCHECS</small><strong id="kpi-chess">—</strong><span>jours joués</span></div>
        <div class="kpi"><small>ACTIVITÉS</small><strong id="kpi-runs">—</strong><span>jours actifs</span></div>
        <div class="kpi kpi-accent"><small>DÉFIS RÉUSSIS</small><strong id="kpi-success">—</strong><span id="kpi-success-note">journées complètes</span></div>
      </div>

      <section id="aujourdhui" class="today-section" aria-labelledby="today-title">
        <div class="section-top">
          <div><p class="eyebrow">LE POINT DU JOUR</p><h2 id="today-title">Aujourd'hui<span class="dot">.</span></h2></div>
          <span id="today-date" class="muted-date"></span>
        </div>
        <div id="today-panel" class="today-panel" aria-live="polite"></div>
      </section>

      <section id="elo" class="elo-section" aria-labelledby="elo-title">
        <div class="section-top">
          <div><p class="eyebrow">LE CLASSEMENT RAPIDE</p><h2 id="elo-title">Mon ELO<span class="dot">.</span></h2></div>
          <a id="chess-profile" href="https://www.chess.com/member/rafaelorset" target="_blank" rel="noopener noreferrer" class="quiet-link">Chess.com ↗</a>
        </div>
        <div class="elo-panel">
          <div class="elo-numbers">
            <span id="elo-mode" class="eyebrow">ELO RAPIDE</span>
            <strong id="elo-current">—</strong>
            <span id="elo-change" class="elo-change">En attente des parties classées</span>
            <p class="panel-note">Évolution du classement pour une même cadence, sans mélanger blitz et rapid.</p>
          </div>
          <div class="elo-chart">
            <svg id="elo-spark" viewBox="0 0 540 180" preserveAspectRatio="none" role="img" aria-label="Évolution du classement ELO dans les dernières parties">
              <path id="elo-path" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
              <g id="elo-dots"></g>
            </svg>
            <div class="chart-range"><span id="elo-first">Première partie</span><span id="elo-last">Dernière partie</span></div>
          </div>
        </div>
      </section>

      <section id="courses" class="courses-section" aria-labelledby="courses-title">
        <div class="section-top">
          <div><p class="eyebrow">LE VOYAGE EN MOUVEMENT</p><h2 id="courses-title">Où j'ai couru<span class="dot">.</span></h2></div>
          <span class="section-hint">Dernières courses publiques</span>
        </div>
        <p class="section-description">Choisis une date pour retrouver le parcours. Carte interactive, libre et zoomable.</p>
        <div class="map-layout">
          <div class="map-sidebar">
            <div id="recent-runs" class="recent-runs" aria-label="Courses récentes classées par date"></div>
            <a class="quiet-link" href="https://www.strava.com/athletes/149399419" target="_blank" rel="noopener noreferrer">Voir toutes mes sorties ↗</a>
          </div>
          <div class="map-area">
            <div id="run-map" class="run-map" role="region" aria-label="Carte interactive des derniers parcours de course"></div>
            <div id="map-placeholder" class="map-placeholder">
              <span class="map-placeholder-icon" aria-hidden="true">⌁</span>
              <p id="map-help">Choisis une activité pour afficher son parcours.</p>
            </div>
            <div class="map-caption" aria-live="polite"><span id="map-caption-title">Parcours récent</span><span id="map-caption-detail">Carte OpenFreeMap</span></div>
          </div>
        </div>
        <p id="runs-note" class="data-note"></p>
      </section>

      <section id="journal" class="journal-section" aria-labelledby="journal-title">
        <div class="section-top">
          <div><p class="eyebrow">UN DÉFI, CHAQUE JOUR</p><h2 id="journal-title">Jour après jour<span class="dot">.</span></h2></div>
          <button id="refresh-defi" class="refresh-button" type="button">↻ Actualiser</button>
        </div>
        <p class="section-description">Une seule course et une seule partie rapide par jour : les plus récentes. Le résultat aux échecs n'a pas besoin d'être une victoire.</p>
        <div id="days-list" class="days-list" aria-live="polite"></div>
        <p id="source-line" class="data-note"></p>
      </section>

      <section class="widgets-section">
        <details id="strava-widgets" class="widgets-details">
          <summary>Voir les activités et le résumé <span aria-hidden="true">⌄</span></summary>
          <div class="widget-grid">
            <div><h3>Dernières sorties</h3><iframe id="strava-feed" title="Dernières activités sportives" loading="lazy" scrolling="no"></iframe></div>
            <div><h3>Résumé des sorties</h3><iframe id="strava-summary" title="Résumé des activités de course" loading="lazy" scrolling="no"></iframe></div>
          </div>
        </details>
      </section>
    </div>
  </main>

  <script>
    import "maplibre-gl/dist/maplibre-gl.css";
    type Chess = {date:string;result:string;url:string;fin:number;rating?:number|null;mode?:string|null;eloDelta?:number|null};
    type Run = {id?:string;date:string;fin?:number;km:number;kmTotal?:number;titre:string;minutes?:number;url:string;source?:string};
    type Day = {date:string;echecs:Chess|null;activite:Run|null;resultat:"reussi"|"en_cours"|"manque"};
    type Elo = {rating:number|null;mode:string;delta:number|null;tendance:string;historique:{date:string;rating:number;fin:number}[]};
    type Defi = {configured:boolean;username?:string;stats?:{jours:number;joursEchecs:number;joursActivites:number;joursComplets:number;reussite:number|null;joursTermines:number};jours?:Day[];elo?:Elo;coursesRecentes?:Run[];stravaFeed?:string;stravaSummary?:string;misAJour?:string;derniereCourseSynchro?:string|null;stravaSynchronisation?:{etat:string}};
    const $=(id:string)=>document.getElementById(id);
    const write=(id:string,value:string)=>{const node=$(id);if(node)node.textContent=value;};
    const shortDate=(date:string)=>new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"short",timeZone:"UTC"}).format(new Date(date+"T12:00:00Z"));
    const fullDate=(date:string)=>new Intl.DateTimeFormat("fr-FR",{weekday:"long",day:"numeric",month:"long",timeZone:"UTC"}).format(new Date(date+"T12:00:00Z"));
    const km=(value:number)=>Number(value).toLocaleString("fr-FR",{maximumFractionDigits:2})+" km";
    const eloModes:Record<string,string>={rapid:"Rapide",blitz:"Blitz",bullet:"Bullet",daily:"Quotidien"};
    let mapModule:any=null;
    let activeMap:any=null;
    let selectedId:string|null=null;
    let routeTurn=0;
    let knownRuns:Run[]=[];
    let widgetUrls={feed:"",summary:""};

    function el<K extends keyof HTMLElementTagNameMap>(tag:K,className?:string,content?:string):HTMLElementTagNameMap[K]{
      const node=document.createElement(tag);if(className)node.className=className;
      if(content!==undefined)node.textContent=content;return node;
    }
    function external(href:string,text:string){
      const a=el("a","detail-link",text);a.href=href;a.target="_blank";a.rel="noopener noreferrer";return a;
    }
    function statusOf(day:Day){
      if(day.resultat==="reussi")return {label:"Réussi",css:"win"};
      if(day.resultat==="en_cours")return {label:day.echecs||day.activite?"En cours · 1/2":"En cours",css:"pending"};
      return day.echecs||day.activite?{label:"Partiel",css:"partial"}:{label:"Manqué",css:"miss"};
    }
    function statusChip(day:Day){
      const status=statusOf(day);return el("span","status-chip "+status.css,status.label);
    }
    function task(kind:"chess"|"run",day:Day){
      const task=el("div","day-task");
      const symbol=el("span","task-symbol "+((kind==="chess"?day.echecs:day.activite)?"complete":"waiting"),
        (kind==="chess"?day.echecs:day.activite)?"✓":"·");
      const copy=el("div","task-copy");
      copy.append(el("span","task-category",kind==="chess"?"ÉCHECS":"COURSE"));
      const main=kind==="chess"
        ?day.echecs?(day.echecs.result+(day.echecs.rating?" · "+day.echecs.rating+" ELO":"")):"Pas encore jouée"
        :day.activite?km(day.activite.km):"Pas encore couru";
      copy.append(el("strong",undefined,main));
      if(kind==="chess"&&day.echecs?.eloDelta!=null){
        const delta=day.echecs.eloDelta;copy.append(el("small","task-extra "+(delta>0?"positive":delta<0?"negative":""),
          (delta>0?"+":"")+delta+" ELO · "+(eloModes[day.echecs.mode||""]||"classement")));
      }
      if(kind==="run"&&day.activite){
        copy.append(el("small","task-extra",day.activite.titre+(day.activite.minutes?" · "+day.activite.minutes+" min":"")));
      }
      task.append(symbol,copy);
      if(kind==="chess"&&day.echecs?.url)task.append(external(day.echecs.url,"↗"));
      else if(kind==="run"&&day.activite?.id){
        const go=el("button","route-jump","Carte ↗");
        go.type="button";go.addEventListener("click",()=>{
          document.getElementById("courses")?.scrollIntoView({behavior:"smooth"});
          chooseRun(day.activite!);
        });task.append(go);
      }else if(kind==="run"&&day.activite?.url)task.append(external(day.activite.url,"↗"));
      return task;
    }
    function dayCard(day:Day,index:number,total:number){
      const article=el("article","day-card");
      const header=el("div","day-card-header");
      const date=el("div","day-date");
      date.append(el("span","day-number","J"+(total-index)),el("strong",undefined,fullDate(day.date)));
      header.append(date,statusChip(day));
      const grid=el("div","day-tasks");grid.append(task("chess",day),task("run",day));
      article.append(header,grid);return article;
    }
    function todayCard(day:Day){
      const panel=$("today-panel");if(!panel)return;
      panel.replaceChildren();
      const header=el("div","today-top");
      const copy=el("div");
      copy.append(el("span","today-overline","OBJECTIF : 1 PARTIE + 1 ACTIVITÉ"));
      copy.append(el("strong","today-outcome",statusOf(day).label));
      header.append(copy,statusChip(day));
      const body=el("div","today-tasks");body.append(task("chess",day),task("run",day));
      panel.append(header,body);
      write("today-date",fullDate(day.date));
      write("hero-today-status",day.resultat==="reussi"?"Défi réussi ✓":day.echecs||day.activite?"1 objectif sur 2":"Défi en cours");
      write("hero-today-description",day.resultat==="reussi"?"Les deux objectifs sont validés.":
        day.echecs?"Échecs joués · course en attente":
        day.activite?"Course faite · partie en attente":"Une partie et une course à accomplir.");
    }
    function rating(elo:Elo|undefined){
      write("elo-mode",elo?.mode?"ELO RAPIDE":"ELO CHESS.COM");
      write("elo-current",elo?.rating!=null?String(elo.rating):"—");
      const delta=elo?.delta;
      const change=$("elo-change");
      if(change){
        change.textContent=delta==null?"Premières parties suivies":delta>0?"↗ +"+delta+" points":delta<0?"↘ "+delta+" points":"→ Stable";
        change.className="elo-change "+(delta==null?"":delta>0?"positive":delta<0?"negative":"");
      }
      const entries=(elo?.historique||[]).filter(e=>Number.isFinite(e.rating));
      const path=$("elo-path") as unknown as SVGPathElement|null;
      const dots=$("elo-dots") as unknown as SVGGElement|null;
      if(!path||!dots)return;
      dots.replaceChildren();if(entries.length<2){path.setAttribute("d","");return;}
      const min=Math.min(...entries.map(e=>e.rating))-10;
      const max=Math.max(...entries.map(e=>e.rating))+10;
      const project=(item:{rating:number},i:number)=>{
        const x=15+i/(entries.length-1)*510;
        const y=157-(item.rating-min)/(max-min)*135;
        return [x,y];
      };
      path.setAttribute("d",entries.map((item,i)=>{
        const [x,y]=project(item,i);return (i?"L":"M")+x.toFixed(1)+" "+y.toFixed(1);
      }).join(" "));
      const ns="http://www.w3.org/2000/svg";
      const [cx,cy]=project(entries[entries.length-1],entries.length-1);
      const last=document.createElementNS(ns,"circle");last.setAttribute("cx",String(cx));last.setAttribute("cy",String(cy));last.setAttribute("r","7");
      dots.append(last);
      write("elo-first",shortDate(entries[0].date));
      write("elo-last",shortDate(entries[entries.length-1].date));
    }
    function renderRuns(runs:Run[]){
      const list=$("recent-runs");if(!list)return;
      list.replaceChildren();
      // Les courses antérieures au lancement du défi restent consultables sur la carte.
      const latestByDay=new Map<string,Run>();
      for(const run of [...runs].sort((a,b)=>Number(b.fin||0)-Number(a.fin||0))){
        if(!latestByDay.has(run.date))latestByDay.set(run.date,run);
      }
      knownRuns=[...latestByDay.values()];
      if(!knownRuns.length){
        list.append(el("p","map-empty","Les parcours récents apparaîtront ici dès leur publication."));
        write("map-help","Aucun tracé public disponible pour le moment.");
        return;
      }
      for(const run of knownRuns){
        const button=el("button","recent-run");
        button.type="button";button.dataset.runId=run.id||"";
        const top=el("div","recent-date");
        top.append(el("span",undefined,shortDate(run.date)),el("span",undefined,km(run.km)));
        button.append(top,el("strong",undefined,run.titre));
        button.addEventListener("click",()=>chooseRun(run));
        list.append(button);
      }
      void chooseRun(knownRuns[0]);
    }
    async function chooseRun(run:Run){
      const turn=++routeTurn;
      selectedId=run.id||null;
      for(const button of document.querySelectorAll<HTMLButtonElement>(".recent-run"))
        button.classList.toggle("selected",button.dataset.runId===selectedId);
      const placeholder=$("map-placeholder"),message=$("map-help");
      if(placeholder)placeholder.hidden=false;
      if(message)message.textContent="Chargement du parcours…";
      write("map-caption-title",run.titre);
      write("map-caption-detail",shortDate(run.date)+" · "+km(run.km)+(run.minutes?" · "+run.minutes+" min":""));
      if(!run.id){if(message)message.textContent="Parcours indisponible pour cette activité.";return;}
      try{
        const response=await fetch("/api/public/defi/parcours/"+encodeURIComponent(run.id),{cache:"no-store"});
        if(!response.ok)throw Error("Tracé GPS non disponible.");
        const data:{route?:number[][]}=await response.json();
        if(turn!==routeTurn)return;
        const coords=(data.route||[]).filter(p=>Array.isArray(p)&&p.length===2&&p.every(Number.isFinite));
        if(coords.length<2)throw Error("Tracé absent.");
        if(!mapModule){const mod=await import("maplibre-gl");mapModule=mod.default;}
        if(turn!==routeTurn)return;
        const mapEl=$("run-map");if(!mapEl)return;
        if(activeMap){activeMap.remove();activeMap=null;}
        activeMap=new mapModule.Map({container:mapEl,
          style:"https://tiles.openfreemap.org/styles/liberty",
          center:[coords[0][1],coords[0][0]],zoom:11});
        activeMap.addControl(new mapModule.NavigationControl({showCompass:false}),"top-right");
        activeMap.addControl(new mapModule.FullscreenControl({container:mapEl}),"top-right");
        const points=coords.map(p=>[p[1],p[0]]);
        activeMap.on("load",()=>{
          if(turn!==routeTurn)return;
          activeMap.addSource("trace",{type:"geojson",data:{type:"Feature",properties:{},
            geometry:{type:"LineString",coordinates:points}}});
          activeMap.addLayer({id:"trace",type:"line",source:"trace",
            layout:{"line-join":"round","line-cap":"round"},
            paint:{"line-color":"#c86f4d","line-width":5}});
          const bounds=new mapModule.LngLatBounds();
          for(const pt of points)bounds.extend(pt);
          activeMap.fitBounds(bounds,{padding:48,maxZoom:15,duration:0});
          activeMap.resize();
          if(placeholder)placeholder.hidden=true;
        });
      }catch(err){if(turn===routeTurn&&message)message.textContent=
        err instanceof Error?err.message:"Impossible de charger la carte.";}
    }
    function loadWidgets(){
      const details=$("strava-widgets") as HTMLDetailsElement|null;
      for(const [id,url] of [["strava-feed",widgetUrls.feed],["strava-summary",widgetUrls.summary]]){
        const frame=$(id) as HTMLIFrameElement|null;
        if(frame&&details?.open&&url){if(frame.src!==url)frame.src=url;}
        else if(frame&&frame.hasAttribute("src"))frame.removeAttribute("src");
      }
    }
    $("strava-widgets")?.addEventListener("toggle",loadWidgets);

    async function load(){
      const refresh=$("refresh-defi") as HTMLButtonElement|null;
      if(refresh)refresh.disabled=true;
      write("defi-loading","Mise à jour du défi…");
      try{
        const response=await fetch("/api/public/defi",{cache:"no-store"});
        if(!response.ok)throw Error("Le défi est momentanément indisponible.");
        const data:Defi=await response.json();
        const content=$("defi-content"),empty=$("defi-empty");
        if(content)content.hidden=!data.configured;
        if(empty)empty.hidden=!!data.configured;
        if(!data.configured){write("defi-loading","Défi en préparation");return;}
        const stats=data.stats!;
        write("kpi-days",String(stats.jours));
        write("kpi-chess",String(stats.joursEchecs));
        write("kpi-runs",String(stats.joursActivites));
        write("kpi-success",stats.reussite===null?"—":stats.reussite+" %");
        write("kpi-success-note",stats.joursComplets+" journées réussies");
        const days=data.jours||[];
        const today=days[0];if(today)todayCard(today);
        rating(data.elo);
        const profile=$("chess-profile") as HTMLAnchorElement|null;
        if(profile&&data.username)profile.href="https://www.chess.com/member/"+encodeURIComponent(data.username);
        renderRuns(data.coursesRecentes||[]);
        const list=$("days-list");
        if(list){list.replaceChildren();days.forEach((d,i)=>list.append(dayCard(d,i,days.length)));}
        widgetUrls={feed:data.stravaFeed||"",summary:data.stravaSummary||""};loadWidgets();
        const time=data.misAJour?new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit",
          timeZone:"Europe/Paris"}).format(new Date(data.misAJour)):"en attente";
        write("source-line","Échecs rapides actualisés : "+time+" · Parcours mis à jour périodiquement.");
        write("runs-note",data.stravaSynchronisation?.etat==="erreur"
          ?"Les dernières courses enregistrées restent affichées même si la synchronisation échoue."
          :"Les parcours présentés ici ne constituent pas une géolocalisation en direct.");
        write("defi-loading","Défi synchronisé · dernière partie et dernière course retenues pour chaque date.");
      }catch(err){write("defi-loading",err instanceof Error?err.message:"Chargement impossible.");}
      finally{if(refresh)refresh.disabled=false;}
    }
    $("refresh-defi")?.addEventListener("click",load);
    void load();
  </script>

  <style is:global>
    .defi-hero{background:var(--forest);color:#fff;padding:clamp(48px,7vw,88px) 0}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(250px,.65fr);gap:clamp(30px,7vw,90px);align-items:end}
    .defi-hero .eyebrow{color:#e2a789}
    .defi-hero h1{font:500 clamp(3rem,7.5vw,6.6rem)/1.04 'Playfair Display',Georgia,serif;letter-spacing:-.045em;margin:20px 0}
    .defi-hero h1 em{font-weight:400;color:#edaf8b}
    .hero-lead{max-width:410px;color:#d2e0dc;line-height:1.7;font-size:clamp(.95rem,1.6vw,1.13rem)}
    .hero-today{border-top:1px solid #6f8a80;padding-top:20px;display:flex;flex-direction:column;align-items:start;gap:11px}
    .hero-today-label,.today-overline{font-size:.68rem;letter-spacing:.14em;font-weight:800}
    .hero-today-label{color:#dfad93}
    .hero-today strong{font:500 clamp(1.75rem,3vw,2.7rem)/1.2 'Playfair Display',Georgia,serif}
    .hero-today>span:nth-of-type(2){color:#d0ded9;font-size:.85rem}
    .hero-today a{color:#fff;text-decoration:underline;text-underline-offset:5px;font-weight:700;margin-top:7px;font-size:.83rem}
    .defi-main{padding-top:32px;padding-bottom:110px}
    .source-line,.data-note{color:var(--muted);font-size:.78rem;line-height:1.65}
    .source-line{margin:0 0 24px}
    #defi-content[hidden],#defi-empty[hidden],.map-placeholder[hidden]{display:none}
    .empty-state{background:var(--white);border:1px solid var(--line);padding:40px}
    .kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .kpi{background:var(--white);border:1px solid var(--line);padding:clamp(16px,2.7vw,26px);display:flex;flex-direction:column;min-width:0}
    .kpi small{font-size:.65rem;letter-spacing:.095em;font-weight:800;color:var(--muted)}
    .kpi strong{font:500 clamp(2.3rem,4vw,3.3rem)/1.2 'Playfair Display',Georgia,serif;margin:12px 0 6px;color:var(--forest)}
    .kpi>span{font-size:.73rem;color:var(--muted)}
    .kpi-accent{background:#e7eee5}
    .today-section,.elo-section,.courses-section,.journal-section{margin-top:clamp(52px,7vw,80px)}
    .section-top{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:18px}
    .section-top h2{font:500 clamp(2rem,4.6vw,3.55rem)/1.17 'Playfair Display',Georgia,serif;margin:9px 0 0;letter-spacing:-.03em;color:var(--forest)}
    .section-top .eyebrow{margin:0;font-size:.7rem;letter-spacing:.14em;color:var(--orange)}
    .dot{color:var(--orange)}
    .muted-date,.section-hint{color:var(--muted);font-size:.82rem}
    .section-description{color:var(--muted);font-size:.88rem;max-width:680px;line-height:1.7;margin:0 0 22px}
