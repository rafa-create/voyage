---
import Base from "../layouts/Base.astro";
import { chemin } from "../lib/paths";
---

<Base title="Défi quotidien" description="Une activité Strava et une partie d'échecs par jour pendant le voyage." active="defi">
  <section class="challenge-intro">
    <div class="container">
      <p class="eyebrow"><span class="eyebrow-line"></span> UN JOUR, DEUX OBJECTIFS</p>
      <div class="challenge-heading">
        <h1>Courir. Jouer.<br /><em>Recommencer.</em></h1>
        <p>Chaque jour de voyage : une activité physique et une partie d'échecs. Peu importe le résultat de la partie, l'important est de jouer.</p>
      </div>
      <div class="challenge-progress" id="challenge-status" role="status">Chargement du défi…</div>
    </div>
  </section>

  <section class="container challenge-section">
    <div id="challenge-empty" class="challenge-empty" hidden>
      <p class="eyebrow">DÉFI EN PRÉPARATION</p>
      <h2>Prêt pour le premier jour.</h2>
      <p>Les statistiques apparaîtront une fois la date de début du voyage et le compte Chess.com renseignés dans l'administration. Aucun résultat fictif n'est affiché.</p>
      <a class="text-link" href={chemin("/connexion/")}>Espace de connexion ↗</a>
    </div>

    <div id="challenge-data" hidden>
      <div class="challenge-stats">
        <article class="challenge-stat"><span>JOURS DE VOYAGE</span><strong id="c-jours">—</strong><small>depuis le départ</small></article>
        <article class="challenge-stat"><span>ÉCHECS</span><strong id="c-echecs">—</strong><small>jours avec une partie</small></article>
        <article class="challenge-stat"><span>ACTIVITÉS</span><strong id="c-strava">—</strong><small>jours avec Strava</small></article>
        <article class="challenge-stat challenge-stat-score"><span>RÉUSSITE DU DÉFI</span><strong id="c-reussite">—</strong><small id="c-reussite-note">journées complètes</small></article>
      </div>

      <div class="challenge-list-head">
        <div>
          <p class="eyebrow">LE CARNET DES OBJECTIFS</p>
          <h2>Jour après jour<span class="heading-dot">.</span></h2>
          <p id="challenge-source" class="challenge-source"></p>
        </div>
        <button type="button" id="challenge-refresh" class="challenge-refresh">↻ Actualiser</button>
      </div>

      <div id="challenge-calendar" class="challenge-calendar" aria-live="polite"></div>
      <p class="challenge-method">Le défi est réussi uniquement si une partie d'échecs a été terminée <strong>et</strong> une activité réalisée le même jour. La journée en cours n'est pas comptée comme un échec. Le taux de réussite est calculé sur les journées terminées.</p>
    </div>
  </section>

  <script>
    type Game = {date:string;result:string;url:string;count?:number};
    type Activity = {date:string;km:number;kmTotal:number;url:string;titre:string;count?:number};
    type Day = {date:string;echecs:Game|null;activite:Activity|null;resultat:"reussi"|"en_cours"|"manque"};
    type Summary = {configured:boolean;stats?:{jours:number;joursEchecs:number;joursActivites:number;joursComplets:number;reussite:number|null;joursTermines:number};jours?:Day[];username?:string;misAJour?:string|null;historiquePartiel?:boolean};

    function dateLabel(value:string) {
      return new Intl.DateTimeFormat("fr-FR",{weekday:"short",day:"numeric",month:"short",timeZone:"UTC"}).format(new Date(value+"T12:00:00Z"));
    }
    function line(icon:string,label:string,sub:string,url?:string){
      const wrap=document.createElement("div");wrap.className="challenge-task";
      const marker=document.createElement("span");marker.className="challenge-task-icon "+(icon==="✓"?"yes":"no");
      marker.textContent=icon;
      const body=document.createElement("div");
      const title=document.createElement("strong");title.textContent=label;
      const hint=document.createElement("span");hint.textContent=sub;
      body.append(title,hint);
      wrap.append(marker,body);
      if(url){
        const anchor=document.createElement("a");anchor.href=url;anchor.target="_blank";anchor.rel="noopener noreferrer";anchor.className="challenge-external";anchor.setAttribute("aria-label","Ouvrir le détail");anchor.textContent="↗";
        wrap.append(anchor);
      }
      return wrap;
    }
    function render(days:Day[]){
      const list=document.getElementById("challenge-calendar");
      if(!list)return;
      list.replaceChildren();
      for(const [index,day] of days.entries()){
        const card=document.createElement("article");card.className="challenge-day";
        const date=document.createElement("div");date.className="challenge-day-date";
        const small=document.createElement("small");small.textContent="J"+(days.length-index);
        const title=document.createElement("strong");title.textContent=dateLabel(day.date);
        date.append(small,title);
        const tasks=document.createElement("div");tasks.className="challenge-tasks";
        tasks.append(
          line(day.echecs?"✓":"✕",day.echecs?(day.echecs.count>1?day.echecs.count+" parties":"1 partie"):"Échecs non joués",day.echecs?day.echecs.result:"Aucune partie terminée",day.echecs?.url),
          line(day.activite?"✓":"✕",day.activite?day.activite.kmTotal.toFixed(1).replace(".",",")+" km":"Aucune activité",day.activite?day.activite.titre:"Strava",day.activite?.url)
        );
        const result=document.createElement("span");result.className="challenge-result "+day.resultat;
        result.textContent=day.resultat==="reussi"?"✓ Réussi":day.resultat==="en_cours"?"◷ En cours":"✕ Manqué";
        card.append(date,tasks,result);
        list.append(card);
      }
    }
    async function load(){
      const message=document.getElementById("challenge-status");
      const button=document.querySelector<HTMLButtonElement>("#challenge-refresh");
      if(button)button.disabled=true;
      if(message)message.textContent="Actualisation des statistiques…";
      try{
        const res=await fetch("/api/public/defi",{cache:"no-store"});
        if(!res.ok)throw Error("Statistiques temporairement indisponibles");
        const data:Summary=await res.json();
        const empty=document.getElementById("challenge-empty");
        const page=document.getElementById("challenge-data");
        if(empty)empty.hidden=data.configured;
        if(page)page.hidden=!data.configured;
        if(!data.configured){if(message)message.textContent="En attente de configuration";return;}
        const stats=data.stats!;
        const set=(id:string,text:string)=>{const target=document.getElementById(id);if(target)target.textContent=text;};
        set("c-jours",String(stats.jours));
        set("c-echecs",String(stats.joursEchecs));
        set("c-strava",String(stats.joursActivites));
        set("c-reussite",stats.reussite===null?"—":String(stats.reussite)+" %");
        set("c-reussite-note",stats.joursComplets+" journées complètes · "+stats.joursTermines+" jours terminés");
        set("challenge-source",(data.historiquePartiel?"Historique des échecs partiel. ":"")+"Chess.com : "+data.username+" · Strava : activités renseignées depuis l'admin");
        render(data.jours||[]);
        if(message)message.textContent="Défi en cours · données rafraîchies";
      }catch(e){if(message)message.textContent=e instanceof Error?e.message:"Chargement impossible";}
      finally{if(button)button.disabled=false;}
    }
    document.getElementById("challenge-refresh")?.addEventListener("click",load);
    load();
  </script>
  <style>
    .challenge-intro{background:var(--forest);color:white;padding:72px 0 62px}
    .challenge-intro .eyebrow{color:#d89d77}
    .challenge-heading{display:flex;justify-content:space-between;align-items:end;gap:40px}
    .challenge-heading h1{margin:19px 0 0;font-size:clamp(3rem,6.6vw,6rem);line-height:1.07}
    .challenge-heading h1 em{font-weight:500;color:#e6a782}
    .challenge-heading p{margin:0 0 8px;max-width:300px;line-height:1.75;color:#d0dfd9}
    .challenge-progress{font-size:.75rem;color:#bed1c7;margin-top:35px}
    .challenge-section{padding-top:38px;padding-bottom:110px}
    .challenge-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
    .challenge-stat{background:var(--white);border:1px solid var(--line);padding:23px;display:flex;flex-direction:column;min-width:0}
    .challenge-stat>span{font-size:.7rem;color:var(--muted);font-weight:700;letter-spacing:.08em}
    .challenge-stat strong{font:500 clamp(2.1rem,4vw,3.6rem)/1.2 'Playfair Display',Georgia,serif;margin:17px 0 9px}
    .challenge-stat small{font-size:.73rem;color:var(--muted);line-height:1.5}
    .challenge-stat-score{background:#e6ede2}
    .challenge-list-head{display:flex;justify-content:space-between;gap:24px;align-items:end;margin:74px 0 24px}
    .challenge-list-head h2{margin:9px 0 0}
    .challenge-list-head .eyebrow{margin:0}
    .challenge-source{margin-top:9px;color:var(--muted);font-size:.8rem}
    .challenge-refresh{border:1px solid var(--line);background:transparent;color:var(--forest);padding:11px 16px;font-weight:700;cursor:pointer;white-space:nowrap}
    .challenge-day{border-top:1px solid var(--line);display:grid;grid-template-columns:140px 1fr 115px;align-items:center;gap:20px;padding:20px 6px}
    .challenge-day:last-child{border-bottom:1px solid var(--line)}
    .challenge-day-date{display:flex;flex-direction:column;gap:6px}
    .challenge-day-date small{color:var(--orange);font-weight:700;letter-spacing:.08em}
    .challenge-day-date strong{font-size:.91rem;font-weight:700}
    .challenge-tasks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .challenge-task{display:flex;gap:10px;align-items:center;background:var(--white);padding:12px;min-width:0}
    .challenge-task-icon{border-radius:50%;width:25px;height:25px;display:grid;place-items:center;flex-shrink:0;font-weight:700}
    .challenge-task-icon.yes{background:#d8e9d6;color:#225d40}
    .challenge-task-icon.no{background:#f1dfd8;color:#a6533c}
    .challenge-task>div{display:flex;flex-direction:column;gap:4px;min-width:0}
    .challenge-task strong{font-size:.81rem}
    .challenge-task>div span{font-size:.73rem;color:var(--muted)}
    .challenge-external{margin-left:auto;align-self:center;font-weight:700}
    .challenge-result{font-size:.76rem;font-weight:700;text-align:right}
    .challenge-result.reussi{color:#2d7653}
    .challenge-result.manque{color:#b06349}
    .challenge-result.en_cours{color:#8a7c61}
    .challenge-method{font-size:.78rem;line-height:1.7;color:var(--muted);max-width:650px;margin-top:26px}
    .challenge-empty{border:1px dashed #c9cdbf;padding:clamp(25px,5vw,60px);min-height:260px;background:var(--white)}
    .challenge-empty h2{font-size:2.4rem;margin:16px 0}
    .challenge-empty p:not(.eyebrow){max-width:600px;color:var(--muted);line-height:1.8}
    .challenge-empty .text-link{margin-top:16px}
    #challenge-empty[hidden],#challenge-data[hidden]{display:none}
    @media(max-width:950px){.challenge-stats{grid-template-columns:repeat(2,1fr)}.challenge-day{grid-template-columns:115px 1fr}.challenge-result{grid-column:2;text-align:left}}
    @media(max-width:650px){
      .challenge-intro{padding:43px 0}
      .challenge-heading{flex-direction:column;align-items:start;gap:18px}
      .challenge-heading h1{font-size:3.25rem}
      .challenge-stats{gap:8px}
      .challenge-stat{padding:17px}
      .challenge-stat strong{font-size:2.7rem}
      .challenge-list-head{align-items:start;gap:15px;flex-direction:column;margin-top:55px}
      .challenge-day{grid-template-columns:1fr;gap:10px;padding:17px 0}
      .challenge-day-date{flex-direction:row;gap:10px;align-items:center}
      .challenge-tasks{grid-template-columns:1fr;gap:7px}
      .challenge-result{grid-column:auto;text-align:left}
    }
  </style>
</Base>
