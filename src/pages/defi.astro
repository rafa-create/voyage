---
import Base from "../layouts/Base.astro";
---

<Base title="Le défi quotidien" description="Une partie rapide et une activité par jour : consulte le résultat quotidien, l'évolution ELO et les cartes à la demande." active="defi">
  <section class="defi-hero">
    <div class="container hero-inner">
      <div>
        <p class="eyebrow">LE DÉFI DU VOYAGE</p>
        <p class="hero-subtitle">Une partie mode rapide d’échec et une activité physique par jour.</p>
      </div>
    </div>
  </section>

  <main class="container defi-page">
    <p id="defi-loading" class="update-note" role="status">Actualisation du carnet…</p>
    <div id="defi-empty" hidden>Le défi sera bientôt disponible.</div>
    <div id="defi-content" hidden>
      <div class="score-grid compact-score-grid" aria-label="Bilan du défi">
        <div class="score"><small>JOURS SUIVIS</small><strong id="score-days">—</strong></div>
        <div class="score"><small>JOURS AVEC PARTIE</small><strong id="score-chess">—</strong></div>
        <div class="score"><small>JOURS AVEC ACTIVITÉ</small><strong id="score-activities">—</strong></div>
        <div class="score score-highlight"><small>JOURNÉES COMPLÈTES</small><strong id="score-completed">—</strong></div>
      </div>
      

      <section id="aujourdhui" class="today-section">
        <div id="today-panel" class="day-panel today-panel"></div>
      </section>

      <section id="journal" class="journal-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">LE CARNET</p>
            <h2>Jour après jour<span class="period">.</span></h2>
          </div>
        </div>
        <div id="days-list" class="day-list"></div>
        <p id="source-note" class="update-note"></p>
      </section>

      <section id="older-section" class="older-section" hidden>
        <details class="archive-details">
          <summary>Activités avant le début du défi <span aria-hidden="true">⌄</span></summary>
          <div id="older-list" class="day-list"></div>
        </details>
      </section>

      <section class="widget-section">
        <details id="sport-widgets" class="archive-details">
          <summary>Afficher les widgets sportifs <span aria-hidden="true">⌄</span></summary>
          <div class="widget-grid">
            <div><p>Dernières sorties</p><iframe id="sport-feed" title="Dernières sorties sportives" loading="lazy" scrolling="no"></iframe></div>
            <div><p>Résumé</p><iframe id="sport-summary" title="Résumé des sorties sportives" loading="lazy" scrolling="no"></iframe></div>
          </div>
          <a class="outside-link" href="https://www.strava.com/athletes/149399419" target="_blank" rel="noopener noreferrer">Toutes mes sorties</a>
        </details>
      </section>
    </div>
  </main>

  <script>
    import "maplibre-gl/dist/maplibre-gl.css";

    type Chess = {date:string;result:string;url:string;fin:number;rating?:number|null;mode?:string|null;eloDelta?:number|null};
    type Run = {id?:string;date:string;fin?:number;km:number;titre:string;minutes?:number|null;url?:string|null;source?:string;sport?:string;parcours?:boolean};
    type Day = {date:string;echecs:Chess|null;partiesEchecs?:Chess[];activite:Run|null;resultat:"reussi"|"en_cours"|"manque"};
    type Elo = {rating:number|null;mode:string;delta:number|null;historique:{date:string;fin:number;rating:number}[]};
    type Data = {configured:boolean;username?:string;debut?:string;stats?:{
      jours:number;joursEchecs:number;joursActivites:number;joursComplets:number;reussite:number|null
    };jours?:Day[];elo?:Elo;coursesRecentes?:Run[];stravaFeed?:string;stravaSummary?:string;
      synchronisation?:{etat:string};stravaSynchronisation?:{etat:string}};
    const get=(id:string)=>document.getElementById(id);
    const set=(id:string,value:string)=>{const node=get(id);if(node)node.textContent=value;};
    function create<K extends keyof HTMLElementTagNameMap>(tag:K,className?:string,text?:string):HTMLElementTagNameMap[K]{
      const node=document.createElement(tag);
      if(className)node.className=className;
      if(text!==undefined)node.textContent=text;
      return node;
    }
    const shortDate=(s:string)=>new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"short",timeZone:"UTC"})
      .format(new Date(s+"T12:00:00Z"));
    const longDate=(s:string)=>new Intl.DateTimeFormat("fr-FR",{weekday:"long",day:"numeric",month:"long",timeZone:"UTC"})
      .format(new Date(s+"T12:00:00Z"));
    const km=(n:number)=>Number(n||0).toLocaleString("fr-FR",{maximumFractionDigits:2})+" km";
    const sportNames:Record<string,string>={course:"Course",kitesurf:"Kitesurf",velo:"Vélo",football:"Football",
      marche:"Marche",natation:"Natation",autre:"Activité"};
    let state:Data={configured:false};
    let mapModule:any=null;
    let activeMap:any=null;
    let mapOwner:HTMLDetailsElement|null=null;
    let routeSerial=0;
    let sportWidgets={feed:"",summary:""};

    function validLink(raw:unknown,kind:"chess"|"activity"){
      if(typeof raw!=="string")return null;
      try{
        const uri=new URL(raw);
        if(uri.protocol!=="https:")return null;
        if(kind==="chess"&&["chess.com","www.chess.com"].includes(uri.hostname))return uri.href;
        if(kind==="activity"&&["strava.com","www.strava.com"].includes(uri.hostname))return uri.href;
      }catch{}
      return null;
    }
    function externalLink(raw:unknown,kind:"chess"|"activity",label:string){
      const address=validLink(raw,kind);
      if(!address)return null;
      const a=create("a","original-link",label);
      a.href=address;a.target="_blank";a.rel="noopener noreferrer";
      return a;
    }
    function status(day:Day){
      if(day.resultat==="reussi")return {name:"Complet · 2/2 objectifs",css:"win"};
      if(day.date===state.jours?.[0]?.date){
        const score=Number(Boolean(day.echecs))+Number(Boolean(day.activite));
        return {name:"Aujourd’hui · "+score+"/2 objectifs",css:"pending"};
      }
      if(day.echecs||day.activite)return {name:"Partiel · 1/2 objectif",css:"partial"};
      return {name:"Incomplet · 0/2 objectif",css:"miss"};
    }
    function statusBadge(day:Day){const v=status(day);return create("span","day-status "+v.css,v.name);}
    function detailLine(label:string,value:string){
      const row=create("div","detail-line");
      row.append(create("span",undefined,label),create("strong",undefined,value));
      return row;
    }
    function expandElo(day:Day,body:HTMLElement){
      body.replaceChildren();
      const games=day.partiesEchecs?.length?day.partiesEchecs:(day.echecs?[day.echecs]:[]);
      if(!games.length){body.append(create("p","empty-text","Aucune partie rapide ce jour-là."));return;}
      body.append(create("p","tiny-label",games.length+" PARTIE"+(games.length>1?"S":"")+" RAPIDE"+(games.length>1?"S":"")+" JOUÉE"+(games.length>1?"S":"")));
      const list=create("div","chess-game-list");
      games.forEach((game,index)=>{
        const row=create("div","chess-game-row");
        const details=create("div","chess-game-info");
        const time=Number.isFinite(game.fin)?new Intl.DateTimeFormat("fr-FR",{hour:"2-digit",minute:"2-digit"}).format(new Date(game.fin*1000)):"";
        details.append(create("strong",undefined,"Partie "+(index+1)+" · "+game.result));
        const metadata=[time,game.rating==null?"ELO non disponible":game.rating+" ELO"];
        if(game.eloDelta!==null&&game.eloDelta!==undefined)
          metadata.push((game.eloDelta>0?"+":"")+game.eloDelta+" points");
        details.append(create("small",undefined,metadata.filter(Boolean).join(" · ")));
        row.append(details);
        const origin=externalLink(game.url,"chess","Voir la partie");
        if(origin)row.append(origin);
        list.append(row);
      });
      body.append(list);
      const chart=chessGraph(day.date);
      if(chart)body.append(chart);
    }
    function chessGraph(date:string){
      const entries=(state.elo?.historique||[])
        .filter(p=>p.date<=date&&Number.isFinite(p.rating));
      if(!entries.length)return null;
      const wrapper=create("div","elo-inline");
      wrapper.append(create("span","tiny-label","ÉVOLUTION ELO JUSQU'AU "+shortDate(date).toUpperCase()));
      const svg=document.createElementNS("http://www.w3.org/2000/svg","svg");
      svg.setAttribute("viewBox","0 0 540 140");
      svg.setAttribute("preserveAspectRatio","none");
      svg.setAttribute("role","img");svg.setAttribute("aria-label","Historique ELO jusqu'au "+longDate(date));
      const min=Math.min(...entries.map(x=>x.rating))-15;
      const max=Math.max(...entries.map(x=>x.rating))+15;
      const coords=entries.map((point,index)=>{
        const x=entries.length===1?270:12+index*516/(entries.length-1);
        const y=124-(point.rating-min)*107/(max-min||1);
        return {x,y};
      });
      const path=document.createElementNS("http://www.w3.org/2000/svg","path");
      path.setAttribute("d",coords.map((p,i)=>(i?"L":"M")+p.x.toFixed(1)+" "+p.y.toFixed(1)).join(" "));
      path.setAttribute("fill","none");path.setAttribute("stroke","#4e7a63");
      path.setAttribute("stroke-width","3.5");path.setAttribute("stroke-linecap","round");
      svg.append(path);
      for(const i of [0,coords.length-1]){
        const p=coords[i];
        const circle=document.createElementNS("http://www.w3.org/2000/svg","circle");
        circle.setAttribute("cx",String(p.x));circle.setAttribute("cy",String(p.y));
        circle.setAttribute("r",i===coords.length-1?"5":"3");circle.setAttribute("fill","#c8714c");
        svg.append(circle);
      }
      wrapper.append(svg);
      const scale=create("div","elo-scale");
      scale.append(create("span",undefined,shortDate(entries[0].date)+" · "+entries[0].rating),
        create("span",undefined,shortDate(entries[entries.length-1].date)+" · "+entries[entries.length-1].rating));
      wrapper.append(scale);
      return wrapper;
    }
    function runsForDay(day:Day){
      const known=(state.coursesRecentes||[]).filter(a=>a.date===day.date);
      const all=[...known];
      const selected=day.activite;
      if(selected&&!all.some(a=>a.id&&a.id===selected.id))all.push(selected);
      return all.sort((a,b)=>Number(b.fin||0)-Number(a.fin||0));
    }
    function showActivity(day:Day,body:HTMLElement,details:HTMLDetailsElement){
      body.replaceChildren();
      const runs=runsForDay(day);
      if(!runs.length){body.append(create("p","empty-text","Aucune activité enregistrée ce jour-là."));return;}
      const chooser=create("div","run-chooser");
      const mapArea=create("div","inline-map-area");
      const canvas=create("div","inline-map");
      const hint=create("p","map-hint","Sélectionne une activité pour voir son parcours.");
      mapArea.append(canvas,hint);
      body.append(chooser,mapArea);
      const select=(run:Run)=>{
        chooser.querySelectorAll<HTMLButtonElement>("button").forEach(b=>{
          b.classList.toggle("selected",b.dataset.id===String(run.id||run.fin));
        });
        const old=body.querySelector(".source-actions");
        if(old)old.remove();
        const actions=create("div","source-actions");
        const link=externalLink(run.url,"activity","Voir l'activité originale");
        if(link)actions.append(link);
        if(actions.childNodes.length)body.append(actions);
        void drawRoute(run,canvas,hint,details);
      };
      for(const run of runs){
        const item=create("button","run-choice");
        item.type="button";item.dataset.id=String(run.id||run.fin);
        const name=sportNames[run.sport||""]||"Activité";
        const title=create("strong",undefined,run.titre||name);
        const meta=create("span",undefined,name+" · "+km(run.km)+(run.minutes?" · "+run.minutes+" min":""));
        item.append(title,meta);
        if(!run.parcours)item.append(create("small",undefined,"Sans tracé GPS"));
        item.addEventListener("click",()=>select(run));
        chooser.append(item);
      }
      select(runs.find(a=>a.parcours)||runs[0]);
    }
    async function drawRoute(run:Run,container:HTMLElement,hint:HTMLElement,details:HTMLDetailsElement){
      const serial=++routeSerial;
      mapOwner=details;
      if(activeMap){activeMap.remove();activeMap=null;}
      if(!run.parcours||!run.id){
        hint.textContent="Pas de tracé GPS pour cette activité.";
        container.hidden=true;return;
      }
      container.hidden=false;
      hint.textContent="Chargement de la carte…";
      try{
        const response=await fetch("/api/public/defi/parcours/"+encodeURIComponent(run.id),{cache:"no-store"});
        if(!response.ok)throw Error("Tracé non disponible.");
        const data:{route?:number[][]}=await response.json();
        const points=(data.route||[]).filter(p=>Array.isArray(p)&&p.length===2&&
          p.every(Number.isFinite)&&Math.abs(p[0])<=85&&Math.abs(p[1])<=180);
        if(points.length<2)throw Error("Pas de GPS pour cette sortie.");
        if(!mapModule){const module=await import("maplibre-gl");mapModule=module.default;}
        if(serial!==routeSerial||!details.open||!container.isConnected)return;
        const coordinates=points.map(p=>[p[1],p[0]]);
        const map=new mapModule.Map({container,style:"https://tiles.openfreemap.org/styles/liberty",
          center:coordinates[0],zoom:11,attributionControl:true});
        activeMap=map;
        map.addControl(new mapModule.NavigationControl({showCompass:false}),"top-right");
        map.addControl(new mapModule.FullscreenControl({container}),"top-right");
        map.on("load",()=>{
          if(serial!==routeSerial||!details.open)return;
          map.addSource("parcours",{type:"geojson",data:{type:"Feature",properties:{},
            geometry:{type:"LineString",coordinates}}});
          map.addLayer({id:"parcours",type:"line",source:"parcours",
            layout:{"line-cap":"round","line-join":"round"},
            paint:{"line-width":5,"line-color":"#c8714c"}});
          const bounds=new mapModule.LngLatBounds();
          for(const position of coordinates)bounds.extend(position);
          map.fitBounds(bounds,{padding:35,maxZoom:16,duration:0});
          map.resize();
          hint.textContent="Carte interactive · bouton plein écran en haut à droite.";
        });
      }catch(error){
        if(serial!==routeSerial)return;
        container.hidden=true;
        hint.textContent=error instanceof Error?error.message:"Carte indisponible.";
      }
    }
    function goal(kind:"chess"|"activity",day:Day){
      const isChess=kind==="chess";
      const done=Boolean(isChess?day.echecs:day.activite);
      const details=create("details","goal "+(isChess?"goal-chess":"goal-activity"));
      const summary=create("summary","goal-summary");
      const icon=create("span","goal-marker "+(done?"done":"undone"),done?"":"·");
      const description=create("span","goal-info");
      description.append(create("small",undefined,isChess?"ÉCHECS RAPIDES":"ACTIVITÉ PHYSIQUE"));
      const chessCount=day.partiesEchecs?.length||Number(Boolean(day.echecs));
      description.append(create("strong",undefined,isChess
        ?done?chessCount+" partie"+(chessCount>1?"s":"")+" jouée"+(chessCount>1?"s":""):"Pas de partie"
        :done?km(day.activite!.km):"Pas d'activité"));
      const caret=create("span","goal-caret","⌄");
      summary.append(icon,description,caret);
      const body=create("div","goal-body");
      details.append(summary,body);
      details.addEventListener("toggle",()=>{
        if(details.open){
          if(isChess)expandElo(day,body);
          else{
            document.querySelectorAll<HTMLDetailsElement>("details.goal-activity[open]").forEach(other=>{
              if(other!==details)other.open=false;
            });
            showActivity(day,body,details);
          }
        }else if(!isChess&&mapOwner===details){
          ++routeSerial;
          if(activeMap){activeMap.remove();activeMap=null;}
          mapOwner=null;
        }
      });
      return details;
    }
    function dailyPanel(day:Day,index:number,isToday=false){
      const card=create("article","day-panel"+(isToday?" today-panel":""));
      const header=create("div","day-header");
      const label=create("span","day-title",(isToday?"AUJOURD'HUI · ":"J"+index+" · ")+longDate(day.date));
      header.append(label,statusBadge(day));
      const goals=create("div","goal-grid");
      goals.append(goal("chess",day),goal("activity",day));
      card.append(header,goals);
      return card;
    }
    function renderArchive(runs:Run[],dateLimit:string){
      const before=runs.filter(run=>run.date<dateLimit);
      const group=new Map<string,Run[]>();
      for(const run of before){
        const bucket=group.get(run.date)||[];bucket.push(run);group.set(run.date,bucket);
      }
      const list=get("older-list"),section=get("older-section");
      if(!list||!section)return;
      section.hidden=group.size===0;
      list.replaceChildren();
      for(const [date,items] of [...group.entries()].sort((a,b)=>b[0].localeCompare(a[0]))){
        const day:Day={date,echecs:null,activite:items[0],resultat:"manque"};
        const card=create("article","day-panel older-panel");
        const header=create("div","day-header");
        header.append(create("strong","day-title",longDate(date)));
        card.append(header,goal("activity",day));
        list.append(card);
      }
    }
    function loadWidgets(){
      const details=get("sport-widgets") as HTMLDetailsElement|null;
      for(const [id,url] of [["sport-feed",sportWidgets.feed],["sport-summary",sportWidgets.summary]]){
        const iframe=get(id) as HTMLIFrameElement|null;
        if(!iframe)continue;
        if(details?.open&&url){if(iframe.src!==url)iframe.src=url;}
        else iframe.removeAttribute("src");
      }
    }
    get("sport-widgets")?.addEventListener("toggle",loadWidgets);
    let backgroundChecks=0;
    async function load(force=false,statusOnly=false){
      // Ne pas reconstruire les cartes pendant que l'utilisateur consulte un détail ouvert.
      if(statusOnly&&document.querySelector("details.goal[open]")){
        set("defi-loading","Actualisation automatique en pause pendant la consultation.");
        return;
      }
      const button=get("refresh-defi") as HTMLButtonElement|null;
      if(button)button.disabled=true;
      set("defi-loading","Synchronisation…");
      ++routeSerial;if(activeMap){activeMap.remove();activeMap=null;}mapOwner=null;
      try{
        const response=await fetch("/api/public/defi"+(statusOnly?"?statut=1":force?"?actualiser=1":""),{cache:"no-store"});
        if(!response.ok)throw Error("Impossible d'actualiser le défi.");
        state=await response.json() as Data;
        get("defi-content")!.hidden=!state.configured;
        get("defi-empty")!.hidden=state.configured;
        if(!state.configured){set("defi-loading","Défi en préparation.");return;}
        const stats=state.stats!;
        set("score-days",String(stats.jours));
        set("score-chess",String(stats.joursEchecs));
        set("score-activities",String(stats.joursActivites));
        set("score-completed",(stats.joursComplets||0)+" / "+(stats.jours||0));
        const days=state.jours||[];
        set("hero-status",days[0]?status(days[0]).name:"En attente");
        if(days[0]){
          set("today-date",longDate(days[0].date));
          const today=get("today-panel");if(today)today.replaceChildren(...Array.from(dailyPanel(days[0],days.length,true).childNodes));
        }
        const list=get("days-list");
        if(list){
          list.replaceChildren();
          days.slice(1).forEach((day,i)=>list.append(dailyPanel(day,days.length-i-1)));
          const journal=get("journal");
          if(journal)journal.hidden=days.length<2;
        }
        renderArchive(state.coursesRecentes||[],state.debut||days.at(-1)?.date||"");
        sportWidgets={feed:state.stravaFeed||"",summary:state.stravaSummary||""};
        loadWidgets();
        const note=state.stravaSynchronisation?.etat==="erreur"?
          "Données affichées · synchronisation à réessayer.":"";
        set("defi-loading",note);
        set("source-note","Une partie rapide et une activité comptent par jour. Appuie pour les détails.");
        if(!statusOnly){backgroundChecks=0;setTimeout(()=>void load(false,true),60000);}
        else if(backgroundChecks<3){backgroundChecks++;setTimeout(()=>void load(false,true),60000);}
      }catch(error){set("defi-loading",error instanceof Error?error.message:"Chargement impossible.");}
      finally{if(button)button.disabled=false;}
    }
    void load();
  </script>

  <style is:global>
    .defi-hero{background:var(--forest);color:#fff;padding:clamp(28px,4vw,46px) 0}
    .hero-inner{display:flex;align-items:end;justify-content:space-between;gap:48px}
    .defi-hero .eyebrow{color:#e4ad8f;font-size:.7rem;letter-spacing:.16em}
    .defi-hero h1{font:500 clamp(2.15rem,4.5vw,3.65rem)/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.035em;margin:12px 0}
    .defi-hero h1 em{font-weight:400;color:#ecaa86}
    .hero-subtitle{font-size:clamp(.92rem,1.6vw,1.08rem);color:#d1e1dc;line-height:1.6;max-width:440px}
    .hero-progress{display:flex;flex-direction:column;gap:8px;border-top:1px solid #748e83;padding-top:12px;min-width:210px}
    .hero-progress span{font-size:.68rem;letter-spacing:.13em;color:#d5a48a;font-weight:800}
    .hero-progress strong{font:500 1.65rem/1.2 'Playfair Display',Georgia,serif}
    .hero-progress a{color:#f9f6f2;font-size:.84rem;text-decoration:underline;text-underline-offset:4px}
    .defi-page{padding-top:25px;padding-bottom:95px}
    .update-note{font-size:.77rem;line-height:1.5;color:var(--muted);margin:0 0 18px}
    #defi-empty[hidden],#defi-content[hidden],#older-section[hidden],#journal[hidden]{display:none}
    .score-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .score{background:var(--white);border:1px solid var(--line);padding:20px;min-width:0}
    .score small{display:block;letter-spacing:.1em;color:var(--muted);font-weight:800;font-size:.68rem}
    .score strong{display:block;font:500 clamp(2.1rem,3.9vw,3rem)/1.15 'Playfair Display',Georgia,serif;color:var(--forest);margin-top:12px}
    .score-highlight{background:#e8efe7}
    .score-note{display:block;margin-top:5px;color:var(--muted);font-size:.72rem;line-height:1.4}
    .today-section,.journal-section{margin-top:clamp(38px,6vw,65px)}
    .section-heading{display:flex;justify-content:space-between;align-items:end;gap:14px;margin-bottom:16px}
    .section-heading .eyebrow{color:var(--orange);letter-spacing:.15em;font-weight:800;font-size:.68rem;margin:0 0 7px}
    .section-heading h2{font:500 clamp(2rem,4.5vw,3.25rem)/1.12 'Playfair Display',Georgia,serif;color:var(--forest);letter-spacing:-.03em;margin:0}
    .period{color:var(--orange)}
    .section-date{color:var(--muted);font-size:.81rem;text-transform:capitalize}
    .refresh-button{background:var(--white);border:1px solid var(--line);font-weight:800;font-size:.82rem;
      padding:10px 15px;color:var(--forest);cursor:pointer}
    .refresh-button:disabled{opacity:.5}
    .day-panel{background:var(--white);border:1px solid var(--line);padding:clamp(13px,2.4vw,24px);min-width:0}
    .day-header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px}
    .day-title{font-size:.85rem;font-weight:800;color:var(--forest);text-transform:capitalize}
