---
import Base from "../layouts/Base.astro";
import { chemin } from "../lib/paths";
---
<Base title="Connexion" description="Connexion administrateur ou visiteur au carnet de voyage.">
  <section class="container connection-page">
    <div class="connection-content">
      <p class="eyebrow">CARNET DE VOYAGE</p>
      <h1>Se connecter<span class="heading-dot">.</span></h1>
      <p class="connection-intro">Choisis ton espace pour continuer.</p>
      <div class="connection-options">
        <article class="connection-option">
          <p class="option-label">POUR GÉRER LE CARNET</p>
          <h2>Administrateur</h2>
          <p>Modifier les étapes, les textes, les photos et les paramètres du site.</p>
          <a class="button button-primary" href={chemin("/admin/")}>Connexion admin <span aria-hidden="true">↗</span></a>
        </article>
        <article class="connection-option">
          <p class="option-label">POUR CONSULTER LE VOYAGE</p>
          <h2>Visiteur</h2>
          <p>Accéder au carnet lorsque le site est restreint, avec une adresse autorisée.</p>
          <a class="button button-secondary" href={chemin("/demander-acces/")}>Connexion visiteur <span aria-hidden="true">↗</span></a>
          <a class="request-link" href={chemin("/demander-acces/")}>Pas encore d’accès ? En demander un</a>
        </article>
      </div>
    </div>
  </section>
  <style>
    .connection-page { min-height: 65vh; display: flex; align-items: center; padding: 72px 0 110px; }
    .connection-content { width: 100%; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
    .connection-content h1 { font-size: clamp(2.8rem,5.5vw,5rem); line-height: 1.05; margin: 0; }
    .connection-intro { color: var(--muted); margin: 0 0 16px; }
    .connection-options { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; width: 100%; }
    .connection-option { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: clamp(22px,4vw,38px); border: 1px solid var(--line); background: var(--white); min-height: 300px; }
    .option-label { font-size: .72rem; letter-spacing: .12em; font-weight: 700; color: var(--muted); margin: 0; }
    .connection-option h2 { font-size: clamp(1.7rem,3vw,2.4rem); margin: 0; }
    .connection-option p:not(.option-label) { color: var(--muted); line-height: 1.7; margin: 0 0 8px; max-width: 440px; }
    .button-secondary { display: inline-flex; align-items: center; gap: 12px; border: 1px solid var(--forest); color: var(--forest); padding: 14px 18px; text-decoration: none; font-weight: 700; }
    .request-link { font-size: .84rem; text-decoration: underline; text-underline-offset: 4px; margin-top: 4px; }
    @media(max-width:680px) { .connection-page { padding: 48px 0 80px; } .connection-options { grid-template-columns: 1fr; } .connection-option { min-height: auto; } }
  </style>
</Base>
