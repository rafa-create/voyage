---
import Base from "../layouts/Base.astro";
---
<Base title="Espace Admin">
  <section class="container connection-page">
    <h1>Espace Admin</h1>
  </section>
  <style>
    .connection-page { min-height: 65vh; display: flex; align-items: center; padding: 90px 0 120px; }
    .connection-page h1 { font-size: clamp(2.8rem,5.5vw,5rem); line-height: 1.15; margin: 0; }
    @media(max-width:780px) { .connection-page { padding: 44px 0 80px; } }
  </style>
</Base>
