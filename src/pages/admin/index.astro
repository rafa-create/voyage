    let ffmpegInstance:any=null;
    let ffmpegLogs:string[]=[];
    const VIDEO_CORE_URLS=["https://unpkg.com/@ffmpeg/core-st@0.11.0/dist/ffmpeg-core.js","https://cdn.jsdelivr.net/npm/@ffmpeg/core-st@0.11.0/dist/ffmpeg-core.js"];
    const VIDEO_FFMPEG_URLS=["https://unpkg.com/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js","https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js"];
    const VIDEO_CORE_URL=VIDEO_CORE_URLS[0];
    const VIDEO_FFMPEG_URL=VIDEO_FFMPEG_URLS[0];
    function videoEnvironment(){
      const nav=navigator as any;
      return [
        "Navigateur : "+(nav.userAgent||"inconnu"),
        "Plateforme : "+(nav.platform||"inconnue"),
        "Langue : "+(nav.language||"inconnue"),
        "Environnement sécurisé : "+window.isSecureContext,
        "crossOriginIsolated : "+String(window.crossOriginIsolated),
        "SharedArrayBuffer disponible : "+String(typeof SharedArrayBuffer!=="undefined"),
        "Mémoire JS estimée : "+(nav.deviceMemory?nav.deviceMemory+" Go":"non exposée"),
        "Nombre de cœurs : "+(nav.hardwareConcurrency||"non exposé"),
        "Cores FFmpeg (ordre de tentative) : "+VIDEO_CORE_URLS.join(" ; "),
        "Wrappers FFmpeg (ordre de tentative) : "+VIDEO_FFMPEG_URLS.join(" ; ")
      ].join("\n");
    }
    function ffmpegLog(line:unknown){
      ffmpegLogs.push(String(line));
      if(ffmpegLogs.length>100)ffmpegLogs=ffmpegLogs.slice(-100);
    }
    function errorDetails(error:unknown):string{
      if(error instanceof Error)return error.name+": "+error.message+(error.stack?"\nStack :\n"+error.stack:"");
      try{return JSON.stringify(error);}catch{return String(error);}
    }
    async function getFFmpeg(){
      if(ffmpegInstance?.isLoaded?.())return ffmpegInstance;
      const w=window as any;
      let stage="initialisation";
      const attempts:string[]=[];
      ffmpegLogs=[];
      try{
        if(!w.FFmpeg){
          stage="chargement du script FFmpeg depuis les CDN";
          for(const scriptUrl of VIDEO_FFMPEG_URLS){
            try{
              await new Promise<void>((resolve,reject)=>{
                const script=document.createElement("script");
                script.src=scriptUrl;
                script.onload=()=>resolve();
                script.onerror=(event)=>{script.remove();reject(new Error("script.onerror pour "+scriptUrl+" ; type="+(event as Event).type));};
                document.head.append(script);
              });
              if(w.FFmpeg?.createFFmpeg)break;
              attempts.push("Wrapper chargé sans FFmpeg.createFFmpeg : "+scriptUrl);
            }catch(error){attempts.push("Wrapper "+scriptUrl+" : "+errorDetails(error));}
          }
        }
        if(!w.FFmpeg?.createFFmpeg)throw new Error("Chargement du wrapper FFmpeg impossible. "+attempts.join(" | "));
        let lastError:unknown=null;
        for(const coreUrl of VIDEO_CORE_URLS){
          stage="chargement du core WebAssembly via "+coreUrl;
          try{
            // Utilise une nouvelle instance après chaque échec de chargement.
            const instance=w.FFmpeg.createFFmpeg({
              log:true,
              mainName:"main",
              corePath:coreUrl,
              logger:({type,message:line}:any)=>ffmpegLog("["+String(type||"log")+"] "+String(line))
            });
            await instance.load();
            ffmpegInstance=instance;
            ffmpegLogs.push("Chargement FFmpeg terminé via "+coreUrl);
            return ffmpegInstance;
          }catch(error){
            lastError=error;
            attempts.push("Core "+coreUrl+" : "+errorDetails(error));
            ffmpegInstance=null;
          }
        }
        throw new Error("Échec du chargement du core via tous les CDN. "+(lastError?errorDetails(lastError):""));
      }catch(error){
        const diagnostic=[
          "ÉCHEC FFmpeg",
          "Étape : "+stage,
          "Erreur brute : "+errorDetails(error),
          "",
          "ENVIRONNEMENT",
          videoEnvironment(),
          "",
          "TENTATIVES CDN",
          attempts.length?attempts.join("\n"):"Aucune tentative alternative nécessaire.",
          "",
          "DERNIÈRES LIGNES FFmpeg",
          ffmpegLogs.length?ffmpegLogs.join("\n"):"Aucun log FFmpeg reçu avant l'échec.",
          "",
          "Pistes : vérifier l'accès réseau aux CDN, les extensions/bloqueurs, la politique CSP et la compatibilité WebAssembly du navigateur."
        ].join("\n");
        showVideoDiagnostic(diagnostic);
        throw new Error("Échec du moteur vidéo à l’étape « "+stage+" » : "+(error instanceof Error?error.message:String(error))+". Ouvre « Diagnostic technique détaillé » pour le rapport complet.");
      }
    }
    async function makeBrowserCompatible(file:File,index:number,total:number):Promise<File>{
      let stage="préparation";
      const inputName="input_"+index+"_"+file.name.replace(/[^a-zA-Z0-9._-]/g,"_").slice(-80);
      const outputName="output_"+index+".mp4";
      let ffmpeg:any=null;
      try{
        stage="chargement du moteur FFmpeg";
        ffmpeg=await getFFmpeg();
        stage="lecture du fichier en mémoire";
        const bytes=new Uint8Array(await file.arrayBuffer());
        ffmpeg.FS("writeFile",inputName,bytes);
        message("video-file-feedback","Vérification du codec "+(index+1)+"/"+total+" · "+file.name);
        stage="analyse des codecs avec FFmpeg";
        try{await ffmpeg.run("-i",inputName);}catch{/* L'appel sans sortie sert à afficher les métadonnées des flux. */}
        const report=ffmpegLogs.join("\n");
        const videoLine=report.split("\n").find(line=>/Video:/.test(line))||"";
        const audioLine=report.split("\n").find(line=>/Audio:/.test(line))||"";
        const isH264=/Video:.*\b(h264|avc1)\b/i.test(videoLine);
        const isAac=!audioLine||/Audio:.*\baac\b/i.test(audioLine);
        if(isH264&&isAac){
          try{ffmpeg.FS("unlink",inputName);}catch{}
          return file;
        }
        stage="transcodage en H.264/AAC MP4";
        message("Conversion en MP4/H.264 "+(index+1)+"/"+total+" · "+file.name+" — garde cette page ouverte.");
        try {
          await ffmpeg.run("-i",inputName,"-c:v","libx264","-preset","ultrafast","-crf","23","-c:a","aac","-b:a","128k","-movflags","+faststart",outputName);
        } catch (runError:any) {
          // Certaines versions de ffmpeg.wasm sur Safari remontent ExitStatus
          // même pour exit(0). Le fichier de sortie permet de confirmer le succès.
          const status=runError?.status;
          const exitZero=status===0 || String(runError?.message||runError).includes("exit(0)");
          let outputExists=false;
          try { const candidate=ffmpeg.FS("readFile",outputName); outputExists=Boolean(candidate?.length); } catch {}
          if (!(exitZero && outputExists)) throw runError;
          ffmpegLog("FFmpeg a terminé avec exit(0) malgré une exception du wrapper ; sortie présente, poursuite de la validation.");
        }
        stage="lecture et validation du fichier converti";
        const output=ffmpeg.FS("readFile",outputName);
        if(!output?.length)throw new Error("FFmpeg n’a produit aucun octet en sortie.");
        const baseName=file.name.replace(/\.[^.]+$/,"").slice(0,150)||"video";
        const converted=new File([output.buffer.slice(output.byteOffset,output.byteOffset+output.byteLength)],baseName+".mp4",{type:"video/mp4",lastModified:Date.now()});
        try{ffmpeg.FS("unlink",inputName);}catch{}
        try{ffmpeg.FS("unlink",outputName);}catch{}
        return converted;
      }catch(error){
        try{if(ffmpeg){ffmpeg.FS("unlink",inputName);ffmpeg.FS("unlink",outputName);}}catch{}
        const diagnostic=[
          "ÉCHEC IMPORT VIDÉO",
          "Étape : "+stage,
          "Fichier : "+file.name,
          "Type MIME : "+(file.type||"(vide)"),
          "Extension : "+(file.name.split(".").pop()||"(aucune)"),
          "Taille : "+file.size+" octets ("+(file.size/1024/1024).toFixed(2)+" Mio)",
          "Fichier modifié le : "+new Date(file.lastModified).toISOString(),
          "Erreur brute : "+errorDetails(error),
          "",
          "ENVIRONNEMENT",
          videoEnvironment(),
          "",
          "DERNIÈRES LIGNES FFmpeg",
          ffmpegLogs.length?ffmpegLogs.join("\n"):"Aucun log FFmpeg reçu.",
          "",
          "Conseil : garde ce rapport complet pour diagnostiquer le problème. Il ne contient pas le contenu de la vidéo."
        ].join("\n");
        showVideoDiagnostic(diagnostic);
        throw new Error("Échec pour « "+file.name+" » à l’étape « "+stage+" » : "+(error instanceof Error?error.message:String(error))+". Le rapport technique détaillé est affiché plus bas.");
      }
    }
