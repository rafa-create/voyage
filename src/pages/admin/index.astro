      e.preventDefault();
      try{
        await post("/api/prive/admin/video-ajouter",{
          slug:$<HTMLSelectElement>("video-etape")?.value||"sans-etape",
          titre:$<HTMLInputElement>("video-title")?.value,
          url:$<HTMLInputElement>("video-url")?.value,
        });
        message("video-feedback",($<HTMLSelectElement>("video-etape")?.value==="sans-etape"?"Vidéo ajoutée sans étape.":"Vidéo ajoutée à l'étape."));
        for(const id of ["video-title","video-url"]){const el=$<HTMLInputElement>(id);if(el)el.value="";}
        await renderVideos();
      }catch(err){message("video-feedback",err instanceof Error?err.message:"Erreur.");}
    });

    $<HTMLFormElement>("active-form")?.addEventListener("submit",async e=>{
      e.preventDefault();
      try{await post("/api/prive/admin/actuelle",{slug:$<HTMLSelectElement>("active-select")?.value});await refresh();message("admin-status","Étape actuelle mise à jour.");}
      catch(err){message("admin-status",err instanceof Error?err.message:"Erreur.");}
    });
    $("edit-story-step")?.addEventListener("change",async()=>{try{const slug=$<HTMLSelectElement>("edit-story-step")?.value;const data=await api("/api/prive/etapes");const step=data.etapes.find((e:Etape)=>e.slug===slug);const field=$<HTMLTextAreaElement>("edit-story-text");if(field)field.value=step?.texte||"";}catch(err){message("edit-story-feedback",String(err));}});
    $<HTMLFormElement>("edit-story-form")?.addEventListener("submit",async e=>{e.preventDefault();try{await post("/api/prive/admin/etape-modifier",{slug:$<HTMLSelectElement>("edit-story-step")?.value,texte:$<HTMLTextAreaElement>("edit-story-text")?.value||""});message("edit-story-feedback","Récit enregistré.");}catch(err){message("edit-story-feedback",err instanceof Error?err.message:"Erreur de sauvegarde.");}});
    $("find-coordinates")?.addEventListener("click",async()=>{
      const ville=$<HTMLInputElement>("step-ville")?.value.trim();
      const pays=$<HTMLInputElement>("step-pays")?.value.trim();
      if(!ville||!pays){message("step-feedback","Renseigne la ville et le pays.");return;}
      try{
        message("step-feedback","Recherche des coordonnées…");
        const r=await fetch("https://nominatim.openstreetmap.org/search?format=json&limit=1&q="+encodeURIComponent(ville+", "+pays));
        if(!r.ok)throw Error("Service cartographique temporairement indisponible.");
        const found=await r.json();
        if(!found.length)throw Error("Lieu introuvable. Tu peux renseigner les coordonnées manuellement.");
        const lat=$<HTMLInputElement>("step-lat"),lon=$<HTMLInputElement>("step-lon");
        if(lat)lat.value=found[0].lat;
        if(lon)lon.value=found[0].lon;
        message("step-feedback","Coordonnées trouvées. Vérifie qu'elles correspondent au bon lieu.");
      }catch(e){message("step-feedback",e instanceof Error?e.message:"Recherche impossible.");}
    });
    function slugify(text:string){return text.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");}
    $<HTMLFormElement>("step-form")?.addEventListener("submit",async e=>{
      e.preventDefault();
      const form=e.currentTarget as HTMLFormElement;
      const val=(id:string)=>($<HTMLInputElement|HTMLTextAreaElement>(id)?.value||"").trim();
      const input={
        slug:slugify(val("step-ville"))+"-"+val("step-date"),
        ville:val("step-ville"),pays:val("step-pays"),titre:val("step-titre"),
        date:val("step-date"),dateFin:val("step-end")||null,
        latitude:Number(val("step-lat")),longitude:Number(val("step-lon")),texte:val("step-texte")
      };
      try{
        await post("/api/prive/admin/etapes",input);
        await refresh();
        form.reset();
        message("step-feedback","Étape créée ! Elle apparaît sur la carte et dans le choix des destinations.");
      }catch(err){message("step-feedback",err instanceof Error?err.message:"Erreur.");}
    });
  </script>
  <script>
    // En mode intégré, ne montrer que l’action correspondant à la page publique d’origine.
    const adminContext = new URLSearchParams(window.location.search).get("context");
    if (adminContext === "photos" || adminContext === "videos" || adminContext === "etapes") {
      const journey = document.querySelector<HTMLElement>(".admin-journey");
      const head = document.querySelector<HTMLElement>(".admin-head");
      const topline = document.querySelector<HTMLElement>(".admin-topline");
      const app = document.querySelector<HTMLElement>("#admin-app");
      if (journey) { journey.style.maxWidth = "none"; journey.style.width = "100%"; journey.style.paddingTop = "18px"; }
      if (head) head.hidden = true;
      if (topline) topline.hidden = true;
      if (app) { app.style.gridTemplateColumns = "minmax(0, 1fr)"; app.style.gap = "0"; }
      const panels = Array.from(document.querySelectorAll<HTMLElement>("#admin-app .admin-panel"));
      panels.forEach((panel, index) => {
        const keep = adminContext === "photos" ? index === 1 : adminContext === "videos" ? index === 2 : index === 6;
        panel.hidden = !keep;
        if (keep) { panel.style.gridColumn = "1 / -1"; panel.style.width = "100%"; }
      });
      const dock = document.getElementById("admin-quick-tools");
      if (dock) dock.hidden = true;
    }
  </script>
  <script>
    // Chaque rubrique admin peut se replier sans quitter la page ni perdre les formulaires.
    document.querySelectorAll<HTMLElement>("#admin-app .admin-panel").forEach((panel, index) => {
      const heading = panel.querySelector<HTMLElement>(".admin-section-title");
      if (!heading || heading.dataset.collapseReady) return;
      heading.dataset.collapseReady = "true";
      const content = document.createElement("div");
      content.className = "admin-panel-content";
      const siblings = Array.from(panel.children).filter((node) => node !== heading);
      siblings.forEach((node) => content.append(node));
      panel.append(content);
      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.className = "admin-collapse-toggle";
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Replier cette rubrique");
      toggle.textContent = "−";
      heading.append(toggle);
      toggle.addEventListener("click", () => {
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        toggle.setAttribute("aria-label", expanded ? "Déplier cette rubrique" : "Replier cette rubrique");
        toggle.textContent = expanded ? "+" : "−";
        content.hidden = expanded;
        panel.classList.toggle("is-collapsed", expanded);
      });
    });
  </script>
