---
import Base from "../layouts/Base.astro";
import { galerie } from "../lib/data";
import photosAClasser from "../data/photos-a-classer.json";
import { chemin } from "../lib/paths";
---

<Base title="Galerie photo" active="galerie">
  <section class="page-intro container gallery-page-heading">
    <h1>La galerie photo<span class="heading-dot">.</span></h1>
    <div class="gallery-admin-actions" id="gallery-admin-actions" hidden aria-label="Ajouter du contenu">
      <button type="button" class="gallery-add-button" id="gallery-add-photo" aria-label="Ajouter des photos" title="Ajouter des photos">+</button>
      <button type="button" class="gallery-add-button" id="gallery-add-video" aria-label="Ajouter une vidéo" title="Ajouter une vidéo">+</button>
    </div>
  </section>
  <div id="gallery-admin-dialog" class="gallery-admin-dialog" hidden role="dialog" aria-modal="true" aria-label="Ajouter du contenu à la galerie">
    <div class="gallery-admin-dialog-head">
      <strong id="gallery-admin-dialog-title">Ajouter du contenu</strong>
      <button type="button" id="gallery-admin-close" aria-label="Fermer">×</button>
    </div>
    <iframe id="gallery-admin-frame" title="Outils d’administration de la galerie" loading="lazy"></iframe>
  </div>

  <section class="container section">
    <div id="galerie-unifiee-grid" class="gallery-months">
      {photosAClasser.map((photo) => (
        <figure class="photo-tile" data-date={(photo as any).date || ""}>
          <button type="button" class="photo-open" data-photo={chemin(photo.src)} data-alt={photo.alt} aria-label={"Afficher en grand : " + photo.alt}>
            <img src={chemin(photo.src)} alt={photo.alt} loading="lazy" decoding="async" width="960" height="720" />
          </button>
          {photo.legende && <figcaption class="photo-caption">{photo.legende}</figcaption>}
        </figure>
      ))}
      {galerie.filter(photo => !photo.src.startsWith("/media/")).map((photo) => (
        <figure class="photo-tile" data-date={photo.etape.date}>
          <button type="button" class="photo-open" data-photo={chemin(photo.src)} data-alt={photo.alt} aria-label={"Afficher en grand : " + photo.alt}>
            <img src={chemin(photo.src)} alt={photo.alt} loading="lazy" decoding="async" width="960" height="720" />
          </button>
          <figcaption><a href={chemin("/etapes/" + photo.etape.slug + "/")}>{photo.etape.pays} · {photo.etape.ville}</a>{photo.legende ? " — " + photo.legende : ""}</figcaption>
        </figure>
      ))}
    </div>
    <p id="galerie-vide" class="empty-state" hidden>Les souvenirs apparaîtront ici dès qu'ils seront ajoutés au carnet.</p>
  </section>
  <script>
    const galleryAdminActions = document.querySelector<HTMLElement>("#gallery-admin-actions");
    const galleryAdminDialog = document.querySelector<HTMLElement>("#gallery-admin-dialog");
    const galleryAdminFrame = document.querySelector<HTMLIFrameElement>("#gallery-admin-frame");
    const galleryAdminTitle = document.querySelector<HTMLElement>("#gallery-admin-dialog-title");
    const closeGalleryAdmin = () => {
      if (galleryAdminDialog) galleryAdminDialog.hidden = true;
      document.body.classList.remove("gallery-admin-dialog-open");
    };
    fetch("/api/prive/moi", { credentials: "same-origin", cache: "no-store" })
      .then(async response => response.ok ? response.json() : null)
      .then(user => { if (user?.isAdmin && galleryAdminActions) galleryAdminActions.hidden = false; })
      .catch(() => {});
    const openGalleryAdmin = (context: "photos" | "videos", title: string) => {
      if (!galleryAdminDialog || !galleryAdminFrame) return;
      if (galleryAdminTitle) galleryAdminTitle.textContent = title;
      const src = "/admin/?context=" + context;
      if (galleryAdminFrame.getAttribute("src") !== src) galleryAdminFrame.src = src;
      galleryAdminDialog.hidden = false;
      document.body.classList.add("gallery-admin-dialog-open");
    };
    document.querySelector("#gallery-add-photo")?.addEventListener("click", () => openGalleryAdmin("photos", "02 / UN NOUVEAU SOUVENIR · Ajouter des photos"));
    document.querySelector("#gallery-add-video")?.addEventListener("click", () => openGalleryAdmin("videos", "03 / YOUTUBE · Ajouter une vidéo"));
    document.querySelector("#gallery-admin-close")?.addEventListener("click", closeGalleryAdmin);
    galleryAdminDialog?.addEventListener("click", event => { if (event.target === galleryAdminDialog) closeGalleryAdmin(); });
    document.addEventListener("keydown", event => { if (event.key === "Escape" && galleryAdminDialog && !galleryAdminDialog.hidden) closeGalleryAdmin(); });

    const unifiedGrid = document.querySelector<HTMLElement>("#galerie-unifiee-grid");
    const sortUnified = () => {
      if (!unifiedGrid) return;
      const items = Array.from(unifiedGrid.querySelectorAll<HTMLElement>("figure.photo-tile"));
      items.sort((a, b) => String(b.dataset.date || "").localeCompare(String(a.dataset.date || "")));
      const groups = new Map<string, HTMLElement[]>();
      for (const item of items) {
        const rawDate = String(item.dataset.date || "");
        const match = rawDate.match(/^(\d{4})[-/](\d{1,2})/);
        const monthKey = match ? match[1] + "-" + match[2].padStart(2, "0") : "sans-date";
        if (!groups.has(monthKey)) groups.set(monthKey, []);
        groups.get(monthKey)!.push(item);
      }
      unifiedGrid.replaceChildren();
      for (const [monthKey, monthItems] of groups) {
        const section = document.createElement("details");
        section.className = "gallery-month";
        section.open = monthKey === groups.keys().next().value;
        const summary = document.createElement("summary");
        const title = document.createElement("span");
        if (monthKey === "sans-date") title.textContent = "Date inconnue";
        else {
          const [year, month] = monthKey.split("-");
          const date = new Date(Number(year), Number(month) - 1, 1);
          title.textContent = new Intl.DateTimeFormat("fr-FR", { month: "long", year: "numeric" }).format(date);
          title.textContent = title.textContent.charAt(0).toLocaleUpperCase("fr-FR") + title.textContent.slice(1);
        }
        const count = document.createElement("span");
        count.className = "gallery-month-count";
        count.textContent = monthItems.length + (monthItems.length > 1 ? " souvenirs" : " souvenir");
        summary.append(title, count);
        const grid = document.createElement("div");
        grid.className = "photo-grid gallery-grid";
        monthItems.forEach(item => grid.append(item));
        section.append(summary, grid);
        unifiedGrid.append(section);
      }
      const empty = document.querySelector<HTMLElement>("#galerie-vide");
      if (empty) empty.hidden = items.length > 0;
    };
    const videoDate = (video: any, step: any) => String(video.dateHeure || video.datePrise || video.date || step.date || "");
    async function loadUnifiedGallery() {
      if (!unifiedGrid) return;
      const [stepsResponse, photosResponse] = await Promise.all([
        fetch("/api/public/etapes"),
        fetch("/api/public/photos")
      ]);
      const stepsData = stepsResponse.ok ? await stepsResponse.json() : { etapes: [] };
      const photosData = photosResponse.ok ? await photosResponse.json() : { photos: [] };
      const steps = stepsData.etapes || [];
      const videosByStep = await Promise.all(steps.map(async (step: any) => {
        try {
          const response = await fetch("/api/public/videos?etape=" + encodeURIComponent(step.slug));
          if (!response.ok) return [];
          const data = await response.json();
          return (data.videos || []).map((video: any) => ({ ...video, etape: step.slug, ville: step.ville, pays: step.pays, date: videoDate(video, step) }));
        } catch { return []; }
      }));
      let looseVideos: any[] = [];
      try {
        const looseResponse = await fetch("/api/public/videos");
        if (looseResponse.ok) {
          const looseData = await looseResponse.json();
          looseVideos = (looseData.videos || []).map((video: any) => ({ ...video, etape: null, date: videoDate(video, {}) }));
        }
      } catch {}
      const seenVideos = new Set<string>();
      for (const video of [...videosByStep.flat(), ...looseVideos]) {
        const match = String(video.url || "").match(/(?:youtu\.be\/|[?&]v=|\/(?:embed|shorts|live)\/)([a-zA-Z0-9_-]{11})/);
        const id = match?.[1];
        if (!id || seenVideos.has(id)) continue;
        seenVideos.add(id);
        const figure = document.createElement("figure");
        figure.className = "photo-tile";
        figure.dataset.date = video.date || "";
        const button = document.createElement("button");
        button.type = "button"; button.className = "photo-open";
        button.dataset.video = id;
        button.dataset.videoTitle = video.titre || "Vidéo du voyage";
        button.dataset.videoRecordId = String(video.id || video.key || id);
        button.dataset.alt = button.dataset.videoTitle;
        button.dataset.date = video.date || "";
        button.dataset.lieu = video.lieu || [video.ville, video.pays].filter(Boolean).join(" · ");
        button.dataset.latitude = video.latitude == null ? "" : String(video.latitude);
        button.dataset.longitude = video.longitude == null ? "" : String(video.longitude);
        button.dataset.etape = video.etape || "";
        button.dataset.videoUrl = video.url || "";
        button.setAttribute("aria-label", "Lire la vidéo : " + button.dataset.videoTitle);
        const poster = document.createElement("img");
        poster.src = "https://i.ytimg.com/vi/" + id + "/hqdefault.jpg";
        poster.alt = button.dataset.videoTitle; poster.loading = "lazy";
        button.append(poster); figure.append(button);
        const caption = document.createElement("figcaption");
        const dateLabel = video.date ? " · " + String(video.date).replace("T", " ").slice(0, 16) : "";
        caption.textContent = button.dataset.videoTitle + (button.dataset.lieu ? " · " + button.dataset.lieu : "") + dateLabel;
        const linkedStep = steps.find((step: any) => step.slug === video.etape);
        const videoLat = Number(video.latitude ?? linkedStep?.latitude);
        const videoLon = Number(video.longitude ?? linkedStep?.longitude);
        if (Number.isFinite(videoLat) && Math.abs(videoLat) <= 85 &&
            Number.isFinite(videoLon) && Math.abs(videoLon) <= 180 &&
            (video.latitude != null || video.longitude != null || linkedStep)) {
          const mapLink = document.createElement("button");
          mapLink.type = "button";
          mapLink.className = "gallery-view-on-map";
          mapLink.textContent = "Voir sur la carte";
          mapLink.addEventListener("click", () => {
            window.location.href = "/?videoMap=" + encodeURIComponent(String(video.id || video.key || id)) +
              "&date=" + encodeURIComponent(String(video.date || "").slice(0, 10)) +
              "&lat=" + encodeURIComponent(String(videoLat)) +
              "&lon=" + encodeURIComponent(String(videoLon));
          });
          caption.append(document.createElement("br"), mapLink);
        }
        figure.append(caption); unifiedGrid.append(figure);
      }
      for (const photo of (photosData.photos || [])) {
        const figure = document.createElement("figure");
        figure.className = "photo-tile";
        const photoStep = steps.find((step: any) => step.slug === photo.etape);
        const stamp = String(photo.dateHeure || photo.datePrise || photo.ajouteLe || photoStep?.date || "");
        figure.dataset.date = stamp || "";
        const button = document.createElement("button");
        button.type = "button"; button.className = "photo-open";
        button.dataset.photo = photo.src;
        button.dataset.alt = photo.alt || "Photo de voyage";
        button.dataset.date = stamp;
        button.setAttribute("aria-label", "Afficher " + (photo.alt || "la photo"));
        const img = document.createElement("img");
        img.src = photo.src; img.alt = photo.alt || "Photo de voyage"; img.loading = "lazy"; img.decoding = "async";
        button.append(img);
        const cap = document.createElement("figcaption");
        const lieu = photo.etape ? "Étape : " + photo.etape : "";
        const heure = stamp ? " · " + stamp.replace("T", " ").slice(0, 16) : "";
        cap.textContent = (photo.legende || photo.commentaire || photo.alt || "Photo de voyage") + (lieu ? " · " + lieu : "") + heure;
        const latitude = Number(photo.latitude);
        const longitude = Number(photo.longitude);
        const photoDate = stamp.slice(0, 10);
        if (Number.isFinite(latitude) && Math.abs(latitude) <= 85 &&
            Number.isFinite(longitude) && Math.abs(longitude) <= 180 &&
            /^\d{4}-\d{2}-\d{2}$/.test(photoDate)) {
          const mapLink = document.createElement("button");
          mapLink.type = "button";
          mapLink.className = "gallery-view-on-map";
          mapLink.textContent = "Voir sur la carte";
          mapLink.addEventListener("click", () => {
            window.location.href = "/?photoMap=" + encodeURIComponent(photo.src) +
              "&date=" + encodeURIComponent(photoDate) +
              "&lat=" + encodeURIComponent(String(latitude)) +
              "&lon=" + encodeURIComponent(String(longitude));
          });
          cap.append(document.createElement("br"), mapLink);
        }
        figure.append(button, cap); unifiedGrid.append(figure);
      }
      sortUnified();
      const requested = new URLSearchParams(location.search).get("photo");
      if (requested) {
        const target = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo-open"))
          .find(button => button.dataset.photo === requested || decodeURIComponent(button.dataset.photo || "") === requested);
        target?.click();
        if (target && new URLSearchParams(location.search).get("edit") === "1") {
          let attempts = 0;
          const openEditor = () => {
            const editButton = document.querySelector<HTMLButtonElement>(".lightbox-edit");
            if (editButton && !editButton.hidden) { editButton.click(); return; }
            if (++attempts < 30) window.setTimeout(openEditor, 100);
          };
          window.setTimeout(openEditor, 100);
        }
      }
    }
    loadUnifiedGallery().catch(() => sortUnified());
  </script>
  <dialog id="visionneuse" class="lightbox" aria-label="Photo agrandie">
    <button type="button" class="lightbox-close" aria-label="Fermer la photo" title="Fermer">✕</button>
    <button type="button" class="lightbox-edit" aria-label="Modifier cette photo" title="Modifier cette photo" hidden>✎</button>
    <button type="button" class="lightbox-prev" aria-label="Photo précédente">←</button>
    <img src="" alt="" />
    <iframe class="lightbox-video" title="Vidéo YouTube" hidden allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    <button type="button" class="lightbox-next" aria-label="Photo suivante">→</button>
    <p class="lightbox-counter" aria-live="polite"></p>
    <p class="lightbox-details" id="lightbox-details"></p>
    <form id="photo-editor" class="photo-editor" hidden>
      <div class="photo-editor-head">
        <p class="eyebrow">MODIFICATION ADMIN</p>
        <button type="button" id="edit-photo-close" class="photo-editor-close" aria-label="Fermer la modification" title="Fermer">✕</button>
      </div>
      <label for="edit-photo-date">Date de prise de vue</label><input id="edit-photo-date" type="date"/>
      <label for="edit-photo-place">Lieu</label><input id="edit-photo-place" maxlength="240" placeholder="Ville, lieu…"/>
      <label for="edit-photo-comment">Commentaire</label><textarea id="edit-photo-comment" rows="3" maxlength="2000" placeholder="Raconter ce souvenir…"></textarea>
      <label for="edit-photo-stage">Étape du journal</label><select id="edit-photo-stage"><option value="">— Sans étape —</option></select>
      <label for="edit-photo-map-search">Rechercher sur Google Maps</label>
      <div class="photo-map-search"><input id="edit-photo-map-search" type="search" maxlength="240" placeholder="Nom du lieu, adresse…"/><button type="button" id="edit-photo-map-open">Rechercher</button></div>
      <label for="edit-photo-map-url">Lien Google Maps du point choisi</label>
      <input id="edit-photo-map-url" type="text" inputmode="text" autocomplete="off" placeholder="Lien Google Maps ou coordonnées (lat, lon)"/>
      <button type="button" id="edit-photo-map-use">Récupérer les coordonnées depuis le lien</button>
      <p class="photo-map-help">Ouvre Maps, choisis le lieu puis copie son lien. Si le lien contient les coordonnées, elles seront ajoutées ci-dessous. Vérifie le point avant d’enregistrer.</p>
      <label for="edit-photo-lat">Latitude</label><input id="edit-photo-lat" type="number" step="any" min="-85" max="85"/>
      <label for="edit-photo-lon">Longitude</label><input id="edit-photo-lon" type="number" step="any" min="-180" max="180"/>
      <button type="submit" class="admin-primary">Enregistrer les modifications</button>
      <button type="button" id="edit-photo-delete" class="admin-danger" hidden>Supprimer définitivement cette photo</button>
      <p id="edit-photo-status" role="status"></p>
    </form>
  </dialog>
  <style>
    .gallery-page-heading { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:0; padding-bottom:0; }
    .gallery-page-heading + section { padding-top:16px; }
    .gallery-page-heading h1 { margin-right:auto; }
    .gallery-admin-actions { display:flex; align-items:center; gap:9px; }
    .gallery-admin-actions[hidden] { display:none !important; }
    .gallery-add-button { display:inline-grid; place-items:center; width:36px; height:36px; border:1px solid var(--line); border-radius:50%; background:var(--white); color:var(--forest); font:400 1.5rem/1 'DM Sans',sans-serif; cursor:pointer; transition:background .18s ease,color .18s ease,border-color .18s ease; }
    .gallery-add-button:hover { background:var(--forest); border-color:var(--forest); color:#fff; }
    .gallery-add-button:focus-visible { outline:2px solid var(--forest); outline-offset:3px; }
    .gallery-admin-dialog[hidden] { display:none !important; }
    .gallery-admin-dialog { position:fixed; z-index:1000; inset:0; display:flex; flex-direction:column; background:var(--paper,#f6f3eb); padding:min(4vh,28px) max(12px,3vw); }
    .gallery-admin-dialog-head { display:flex; align-items:center; justify-content:space-between; gap:16px; max-width:980px; width:100%; margin:0 auto; padding:12px 16px; background:var(--white); border:1px solid var(--line); }
    .gallery-admin-dialog-head strong { font-size:.88rem; }
    .gallery-admin-dialog-head button { border:0; background:transparent; color:var(--forest); font-size:1.5rem; cursor:pointer; }
    .gallery-admin-dialog iframe { display:block; width:100%; max-width:980px; flex:1; min-height:0; margin:0 auto; border:1px solid var(--line); border-top:0; background:var(--white); }
    body.gallery-admin-dialog-open { overflow:hidden; }
    @media(max-width:560px) { .gallery-page-heading { align-items:flex-start; } .gallery-admin-actions { gap:6px; } .gallery-add-button { width:32px; height:32px; } }
  </style>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>("#visionneuse");
    const agrandissement = dialog?.querySelector("img");
    const videoPlayer = dialog?.querySelector<HTMLIFrameElement>(".lightbox-video");
    const compteur = dialog?.querySelector<HTMLElement>(".lightbox-counter");
    const details = dialog?.querySelector<HTMLElement>("#lightbox-details");
    let photos: HTMLButtonElement[] = [];
    let index = -1;
    let touchX = 0;
    let isAdmin = false;
    let adminPhotos: any[] = [];
    const editor = document.querySelector<HTMLFormElement>("#photo-editor");
    const editDate = document.querySelector<HTMLInputElement>("#edit-photo-date");
    const editPlace = document.querySelector<HTMLInputElement>("#edit-photo-place");
    const editComment = document.querySelector<HTMLTextAreaElement>("#edit-photo-comment");
    const editStage = document.querySelector<HTMLSelectElement>("#edit-photo-stage");
    const editLat = document.querySelector<HTMLInputElement>("#edit-photo-lat");
    const editLon = document.querySelector<HTMLInputElement>("#edit-photo-lon");
    const editStatus = document.querySelector<HTMLElement>("#edit-photo-status");
    const editMapSearch = document.querySelector<HTMLInputElement>("#edit-photo-map-search");
    const editMapUrl = document.querySelector<HTMLInputElement>("#edit-photo-map-url");
    document.querySelector<HTMLButtonElement>("#edit-photo-map-open")?.addEventListener("click", () => {
      const query = editMapSearch?.value.trim();
      if (!query) { if (editStatus) editStatus.textContent = "Saisis d’abord un lieu à rechercher."; return; }
      if (editPlace && !editPlace.value.trim()) editPlace.value = query;
      window.open("https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(query), "_blank", "noopener,noreferrer");
    });
    const extraireCoordonneesMaps = (raw: string): [number, number] | null => {
      // Accepte aussi un copier-coller direct du type (43.2089488, 5.5977903).
      let coordinates: RegExpMatchArray | null = raw.match(/^\s*\(?\s*(-?\d{1,2}(?:\.\d+)?)\s*,\s*(-?\d{1,3}(?:\.\d+)?)\s*\)?\s*$/);
      if (!coordinates) coordinates = raw.match(/@(-?\d{1,2}(?:\.\d+)?),\s*(-?\d{1,3}(?:\.\d+)?)/);
      if (!coordinates) coordinates = raw.match(/!3d(-?\d{1,2}(?:\.\d+)?)!4d(-?\d{1,3}(?:\.\d+)?)/);
      if (!coordinates) {
        try {
          const parsed = new URL(raw);
          const q = parsed.searchParams.get("query") || parsed.searchParams.get("q") || "";
          const pair = q.match(/^\s*(-?\d{1,2}(?:\.\d+)?)\s*,\s*(-?\d{1,3}(?:\.\d+)?)\s*$/);
          if (pair) coordinates = pair;
        } catch {}
      }
      if (!coordinates) return null;
      const lat = Number(coordinates[1]), lon = Number(coordinates[2]);
      return Number.isFinite(lat) && Number.isFinite(lon) && Math.abs(lat) <= 85 && Math.abs(lon) <= 180 ? [lat, lon] : null;
    };
    document.querySelector<HTMLButtonElement>("#edit-photo-map-use")?.addEventListener("click", async () => {
      const raw = editMapUrl?.value.trim() || "";
      if (!raw) { if (editStatus) editStatus.textContent = "Colle un lien Google Maps ou des coordonnées (latitude, longitude)."; return; }
      if (editStatus) editStatus.textContent = "Recherche des coordonnées…";
      let coords = extraireCoordonneesMaps(raw);
      if (!coords) {
        try {
          const response = await fetch("/api/public/resolve-maps-link?url=" + encodeURIComponent(raw), { headers: { "Accept": "application/json" } });
          const result = await response.json() as { url?: string; error?: string };
          if (response.ok && result.url) coords = extraireCoordonneesMaps(result.url);
          if (!coords && editStatus) editStatus.textContent = result.error || "Le lien a été résolu, mais Google Maps n’a pas fourni de coordonnées lisibles. Essaie le lien complet ou saisis-les manuellement.";
        } catch {
          if (editStatus) editStatus.textContent = "Impossible de résoudre ce lien maintenant. Essaie le lien complet ou saisis les coordonnées manuellement.";
          return;
        }
      }
      if (!coords) {
        if (editStatus && editStatus.textContent === "Recherche des coordonnées…") editStatus.textContent = "Coordonnées introuvables. Ouvre le point dans Google Maps et copie le lien complet, ou saisis-les manuellement.";
        return;
      }
      if (editLat) editLat.value = String(coords[0]);
      if (editLon) editLon.value = String(coords[1]);
      if (editPlace && editMapSearch?.value.trim()) editPlace.value = editMapSearch.value.trim();
      if (editStatus) editStatus.textContent = "Coordonnées récupérées. Vérifie le point puis enregistre la photo.";
    });
    const selectedPhoto = () => { const button=photos[index]; return adminPhotos.find(p=>p.src===button?.dataset.photo) || null; };
    const afficher = (next: number) => {
      if (!agrandissement || !photos.length) return;
      index = (next + photos.length) % photos.length;
      const bouton = photos[index];
      const videoId = bouton.dataset.video;
      if (videoPlayer) {
        videoPlayer.hidden = !videoId;
        videoPlayer.title = bouton.dataset.videoTitle || "Vidéo YouTube";
        videoPlayer.src = videoId ? "https://www.youtube-nocookie.com/embed/" + encodeURIComponent(videoId) + "?autoplay=1&rel=0" : "";
      }
      agrandissement.hidden = !!videoId;
      agrandissement.src = videoId ? "" : (bouton.dataset.photo || "");
      agrandissement.alt = bouton.dataset.alt || "";
      if (compteur) compteur.textContent = (index + 1) + " / " + photos.length;
      const item=selectedPhoto();
      if(details){details.replaceChildren();const bits=[item?.datePrise||bouton.dataset.date,bouton.dataset.videoTitle||item?.lieu,item?.commentaire||item?.legende].filter(Boolean);for(const bit of bits){const line=document.createElement("span");line.textContent=String(bit);details.append(line);}details.hidden=!bits.length;}
      const editButton=dialog?.querySelector<HTMLButtonElement>(".lightbox-edit");
