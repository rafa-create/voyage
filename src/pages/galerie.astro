---
import Base from "../layouts/Base.astro";
import { galerie } from "../lib/data";
import photosAClasser from "../data/photos-a-classer.json";
import { chemin } from "../lib/paths";
---

<Base title="Galerie photo" active="galerie">
  <section class="page-intro container">
    <p class="eyebrow">INSTANTS CAPTURÉS</p>
    <h1>La galerie photo<span class="heading-dot">.</span></h1>
    <p>Les images du voyage, réunies au même endroit. Cliquez sur une photo pour l'afficher en grand.</p>
  </section>

  <section class="container section">
    {photosAClasser.length > 0 && (
      <>
        <div class="section-heading">
          <div>
            <p class="eyebrow">PREMIER ESSAI · CLOUDFLARE R2</p>
            <h2>Album de test<span class="heading-dot">.</span></h2>
            <p class="gallery-description">{photosAClasser.length} photos déjà hébergées dans R2, en attente de leur pays et de leur étape.</p>
          </div>
        </div>
        <div class="photo-grid gallery-grid">
          {photosAClasser.map((photo) => (
            <figure class="photo-tile">
              <button
                type="button"
                class="photo-open"
                data-photo={chemin(photo.src)}
                data-alt={photo.alt}
                aria-label={"Afficher en grand : " + photo.alt}
              >
                <img src={chemin(photo.src)} alt={photo.alt} loading="lazy" decoding="async" width="960" height="720" />
              </button>
              {photo.legende && <figcaption class="photo-caption">{photo.legende}</figcaption>}
            </figure>
          ))}
        </div>
      </>
    )}

    {galerie.filter(photo => !photo.src.startsWith("/media/")).length > 0 && (
      <>
        <div class="section-heading" style={photosAClasser.length ? "margin-top: 5rem;" : undefined}>
          <div>
            <p class="eyebrow">PHOTOS CLASSÉES PAR ÉTAPE</p>
            <h2>Le voyage en images<span class="heading-dot">.</span></h2>
          </div>
        </div>
        <div class="photo-grid gallery-grid">
          {galerie.filter(photo => !photo.src.startsWith("/media/")).map((photo) => (
            <figure class="photo-tile">
              <button
                type="button"
                class="photo-open"
                data-photo={chemin(photo.src)}
                data-alt={photo.alt}
                aria-label={"Afficher en grand : " + photo.alt}
              >
                <img src={chemin(photo.src)} alt={photo.alt} loading="lazy" decoding="async" width="960" height="720" />
              </button>
              <figcaption><a href={chemin("/etapes/" + photo.etape.slug + "/")}>{photo.etape.pays} · {photo.etape.ville}</a>{photo.legende ? " — " + photo.legende : ""}</figcaption>
            </figure>
          ))}
        </div>
      </>
    )}

    {galerie.length === 0 && photosAClasser.length === 0 && (
      <div class="empty-state">
        <div class="empty-symbol" aria-hidden="true">▧</div>
        <h2>Une galerie à remplir</h2>
        <p>Les photos apparaîtront ici dès qu'elles seront ajoutées au carnet.</p>
      </div>
    )}
  </section>

  <section id="galerie-r2-direct" class="container section" hidden>
    <div class="section-heading"><div><p class="eyebrow">AJOUTÉES EN COURS DE ROUTE</p><h2>Nouveaux souvenirs<span class="heading-dot">.</span></h2></div></div>
    <div id="galerie-r2-grid" class="photo-grid gallery-grid"></div>
  </section>
  <script>
    const gallery = document.querySelector<HTMLElement>("#galerie-r2-direct");
    const grid = document.querySelector<HTMLElement>("#galerie-r2-grid");
    if (gallery && grid) {
      fetch("/api/public/photos")
        .then(response => response.ok ? response.json() : { photos: [] })
        .then(({ photos }) => {
          if (!photos.length) return;
          // Les photos de l’API sont affichées des plus récentes aux plus anciennes.
          photos.sort((a: any, b: any) => {
            const da = String(a.dateHeure || a.datePrise || a.ajouteLe || "");
            const db = String(b.dateHeure || b.datePrise || b.ajouteLe || "");
            return db.localeCompare(da);
          });
          for (const photo of photos) {
            const figure = document.createElement("figure");
            figure.className = "photo-tile";
            const button = document.createElement("button");
            button.type = "button";
            button.className = "photo-open";
            button.dataset.photo = photo.src;
            button.dataset.alt = photo.alt || "Photo de voyage";
            button.setAttribute("aria-label", "Afficher " + (photo.alt || "la photo"));
            const img = document.createElement("img");
            img.src = photo.src;
            img.alt = photo.alt || "Photo de voyage";
            img.loading = "lazy";
            button.append(img);
            const cap = document.createElement("figcaption");
            cap.textContent = "Étape : " + photo.etape;
            figure.append(button, cap);
            grid.append(figure);
          }
          gallery.hidden = false;
        })
        .catch(() => {});
    }
  </script>
  <dialog id="visionneuse" class="lightbox" aria-label="Photo agrandie">
    <button type="button" class="lightbox-close" aria-label="Fermer la photo">Fermer ✕</button>
    <button type="button" class="lightbox-prev" aria-label="Photo précédente">←</button>
    <img src="" alt="" />
    <button type="button" class="lightbox-next" aria-label="Photo suivante">→</button>
    <p class="lightbox-counter" aria-live="polite"></p>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>("#visionneuse");
    const agrandissement = dialog?.querySelector("img");
    const compteur = dialog?.querySelector<HTMLElement>(".lightbox-counter");
    let photos: HTMLButtonElement[] = [];
    let index = -1;
    let touchX = 0;
    const afficher = (next: number) => {
      if (!agrandissement || !photos.length) return;
      index = (next + photos.length) % photos.length;
      const bouton = photos[index];
      agrandissement.src = bouton.dataset.photo || "";
      agrandissement.alt = bouton.dataset.alt || "";
      if (compteur) compteur.textContent = (index + 1) + " / " + photos.length;
    };
    const ouvrirPhoto = (bouton: HTMLButtonElement) => {
      if (!dialog) return;
      photos = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo-open"))
        .filter(item => !!item.dataset.photo);
      index = photos.indexOf(bouton);
      if (index < 0) photos = [bouton], index = 0;
      afficher(index);
      if (!dialog.open) dialog.showModal();
    };
    document.addEventListener("click", (evenement) => {
      const bouton = (evenement.target as HTMLElement).closest<HTMLButtonElement>(".photo-open");
      if (bouton) ouvrirPhoto(bouton);
    });
    dialog?.querySelector(".lightbox-prev")?.addEventListener("click", () => afficher(index - 1));
    dialog?.querySelector(".lightbox-next")?.addEventListener("click", () => afficher(index + 1));
    document.addEventListener("keydown", (evenement) => {
      if (!dialog?.open) return;
      if (evenement.key === "ArrowLeft") afficher(index - 1);
      if (evenement.key === "ArrowRight") afficher(index + 1);
    });
    dialog?.addEventListener("touchstart", (event) => {
      touchX = event.changedTouches[0]?.clientX || 0;
    }, { passive: true });
    dialog?.addEventListener("touchend", (event) => {
      const delta = (event.changedTouches[0]?.clientX || 0) - touchX;
      if (Math.abs(delta) > 45) afficher(index + (delta < 0 ? 1 : -1));
    }, { passive: true });
    dialog?.querySelector(".lightbox-close")?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (evenement) => {
      if (evenement.target === dialog) dialog.close();
    });
    dialog?.addEventListener("close", () => {
      if (agrandissement) agrandissement.removeAttribute("src");
      index = -1;
    });
  </script>
</Base>
