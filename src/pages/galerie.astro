---
import Base from "../layouts/Base.astro";
import { galerie } from "../lib/data";
import photosAClasser from "../data/photos-a-classer.json";
import { chemin } from "../lib/paths";
---

<Base title="Galerie photo" active="galerie">
  <section class="page-intro container">
    <p class="eyebrow">INSTANTS CAPTURÉS</p>
    <h1>La galerie photo<span class="heading-dot">.</span></h1>
    <p>Les images du voyage, réunies au même endroit. Cliquez sur une photo pour l'afficher en grand.</p>
  </section>

  <section class="container section">
    {photosAClasser.length > 0 && (
      <>
        <div class="section-heading">
          <div>
            <p class="eyebrow">PREMIER ESSAI · CLOUDFLARE R2</p>
            <h2>Album de test<span class="heading-dot">.</span></h2>
            <p class="gallery-description">{photosAClasser.length} photos déjà hébergées dans R2, en attente de leur pays et de leur étape.</p>
          </div>
        </div>
        <div class="photo-grid gallery-grid">
          {photosAClasser.map((photo) => (
            <figure class="photo-tile">
              <button
                type="button"
                class="photo-open"
                data-photo={chemin(photo.src)}
                data-alt={photo.alt}
                aria-label={"Afficher en grand : " + photo.alt}
              >
                <img src={chemin(photo.src)} alt={photo.alt} loading="lazy" decoding="async" width="960" height="720" />
              </button>
              {photo.legende && <figcaption class="photo-caption">{photo.legende}</figcaption>}
            </figure>
          ))}
        </div>
      </>
    )}

    {galerie.filter(photo => !photo.src.startsWith("/media/")).length > 0 && (
      <>
        <div class="section-heading" style={photosAClasser.length ? "margin-top: 5rem;" : undefined}>
          <div>
            <p class="eyebrow">PHOTOS CLASSÉES PAR ÉTAPE</p>
            <h2>Le voyage en images<span class="heading-dot">.</span></h2>
          </div>
        </div>
        <div class="photo-grid gallery-grid">
          {galerie.filter(photo => !photo.src.startsWith("/media/")).map((photo) => (
            <figure class="photo-tile">
              <button
                type="button"
                class="photo-open"
                data-photo={chemin(photo.src)}
                data-alt={photo.alt}
                aria-label={"Afficher en grand : " + photo.alt}
              >
                <img src={chemin(photo.src)} alt={photo.alt} loading="lazy" decoding="async" width="960" height="720" />
              </button>
              <figcaption><a href={chemin("/etapes/" + photo.etape.slug + "/")}>{photo.etape.pays} · {photo.etape.ville}</a>{photo.legende ? " — " + photo.legende : ""}</figcaption>
            </figure>
          ))}
        </div>
      </>
    )}

    {galerie.length === 0 && photosAClasser.length === 0 && (
      <div class="empty-state">
        <div class="empty-symbol" aria-hidden="true">▧</div>
        <h2>Une galerie à remplir</h2>
        <p>Les photos apparaîtront ici dès qu'elles seront ajoutées au carnet.</p>
      </div>
    )}
  </section>

  <section id="galerie-r2-direct" class="container section" hidden>
    <div class="section-heading"><div><p class="eyebrow">AJOUTÉES EN COURS DE ROUTE</p><h2>Nouveaux souvenirs<span class="heading-dot">.</span></h2></div></div>
    <div id="galerie-r2-grid" class="photo-grid gallery-grid"></div>
  </section>
  <script>
    const gallery = document.querySelector<HTMLElement>("#galerie-r2-direct");
    const grid = document.querySelector<HTMLElement>("#galerie-r2-grid");
    if (gallery && grid) {
      fetch("/api/public/photos")
        .then(response => response.ok ? response.json() : { photos: [] })
        .then(({ photos }) => {
          if (!photos.length) return;
          // Les photos de l’API sont affichées des plus récentes aux plus anciennes.
          photos.sort((a: any, b: any) => {
            const da = String(a.dateHeure || a.datePrise || a.ajouteLe || "");
            const db = String(b.dateHeure || b.datePrise || b.ajouteLe || "");
            return db.localeCompare(da);
          });
          for (const photo of photos) {
            const figure = document.createElement("figure");
            figure.className = "photo-tile";
            const button = document.createElement("button");
            button.type = "button";
            button.className = "photo-open";
            button.dataset.photo = photo.src;
            button.dataset.alt = photo.alt || "Photo de voyage";
            button.setAttribute("aria-label", "Afficher " + (photo.alt || "la photo"));
            const img = document.createElement("img");
            img.src = photo.src;
            img.alt = photo.alt || "Photo de voyage";
            img.loading = "lazy";
            button.append(img);
            const cap = document.createElement("figcaption");
            const lieu = photo.etape ? "Étape : " + photo.etape : "";
            const horodatage = photo.dateHeure || photo.datePrise || "";
            const heure = horodatage ? " · " + String(horodatage).replace("T", " ").slice(0, 16) : "";
            cap.textContent = lieu + heure;
            figure.append(button, cap);
            grid.append(figure);
          }
          gallery.hidden = false;
          // Une photo ouverte depuis la carte est sélectionnée dès son insertion.
          const requested = new URLSearchParams(location.search).get("photo");
          if (requested) {
            const target = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo-open"))
              .find(button => button.dataset.photo === requested || decodeURIComponent(button.dataset.photo || "") === requested);
            target?.click();
          }
        })
        .catch(() => {});
    }
  </script>
  <dialog id="visionneuse" class="lightbox" aria-label="Photo agrandie">
    <button type="button" class="lightbox-close" aria-label="Fermer la photo" title="Fermer">✕</button>
    <button type="button" class="lightbox-edit" aria-label="Modifier cette photo" title="Modifier cette photo" hidden>✎</button>
    <button type="button" class="lightbox-prev" aria-label="Photo précédente">←</button>
    <img src="" alt="" />
    <button type="button" class="lightbox-next" aria-label="Photo suivante">→</button>
    <p class="lightbox-counter" aria-live="polite"></p>
    <form id="photo-editor" class="photo-editor" hidden>
      <p class="eyebrow">MODIFICATION ADMIN</p>
      <label for="edit-photo-date">Date de prise de vue</label><input id="edit-photo-date" type="date"/>
      <label for="edit-photo-place">Lieu</label><input id="edit-photo-place" maxlength="240" placeholder="Ville, lieu…"/>
      <label for="edit-photo-comment">Commentaire</label><textarea id="edit-photo-comment" rows="3" maxlength="2000" placeholder="Raconter ce souvenir…"></textarea>
      <label for="edit-photo-stage">Étape du journal</label><select id="edit-photo-stage"><option value="">Sans étape</option></select>
      <label for="edit-photo-lat">Latitude (facultatif)</label><input id="edit-photo-lat" type="number" step="any" min="-85" max="85"/>
      <label for="edit-photo-lon">Longitude (facultatif)</label><input id="edit-photo-lon" type="number" step="any" min="-180" max="180"/>
      <button type="submit" class="admin-primary">Enregistrer les modifications</button><p id="edit-photo-status" role="status"></p>
    </form>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>("#visionneuse");
    const agrandissement = dialog?.querySelector("img");
    const compteur = dialog?.querySelector<HTMLElement>(".lightbox-counter");
    let photos: HTMLButtonElement[] = [];
    let index = -1;
    let touchX = 0;
    let isAdmin = false;
    let adminPhotos: any[] = [];
    const editor = document.querySelector<HTMLFormElement>("#photo-editor");
    const editDate = document.querySelector<HTMLInputElement>("#edit-photo-date");
    const editPlace = document.querySelector<HTMLInputElement>("#edit-photo-place");
    const editComment = document.querySelector<HTMLTextAreaElement>("#edit-photo-comment");
    const editStage = document.querySelector<HTMLSelectElement>("#edit-photo-stage");
    const editLat = document.querySelector<HTMLInputElement>("#edit-photo-lat");
    const editLon = document.querySelector<HTMLInputElement>("#edit-photo-lon");
    const editStatus = document.querySelector<HTMLElement>("#edit-photo-status");
    const selectedPhoto = () => { const button=photos[index]; return adminPhotos.find(p=>p.src===button?.dataset.photo) || null; };
    const afficher = (next: number) => {
      if (!agrandissement || !photos.length) return;
      index = (next + photos.length) % photos.length;
      const bouton = photos[index];
      agrandissement.src = bouton.dataset.photo || "";
      agrandissement.alt = bouton.dataset.alt || "";
      if (compteur) compteur.textContent = (index + 1) + " / " + photos.length;
      const item=selectedPhoto();
      const editButton=dialog?.querySelector<HTMLButtonElement>(".lightbox-edit");
      if(editButton)editButton.hidden=!(isAdmin&&item);
      if(editor){editor.hidden=true;if(item){if(editDate)editDate.value=item.datePrise||"";if(editPlace)editPlace.value=item.lieu||"";if(editComment)editComment.value=item.commentaire||item.legende||"";if(editLat)editLat.value=item.latitude==null?"":String(item.latitude);if(editLon)editLon.value=item.longitude==null?"":String(item.longitude);if(editStage)editStage.value=item.etape||"";}if(editStatus)editStatus.textContent="";}
    };
    const ouvrirPhoto = (bouton: HTMLButtonElement) => {
      if (!dialog) return;
      photos = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo-open"))
        .filter(item => !!item.dataset.photo);
      index = photos.indexOf(bouton);
      if (index < 0) photos = [bouton], index = 0;
      afficher(index);
      if (!dialog.open) dialog.showModal();
    };
    document.addEventListener("click", (evenement) => {
      const bouton = (evenement.target as HTMLElement).closest<HTMLButtonElement>(".photo-open");
      if (bouton) ouvrirPhoto(bouton);
    });
    dialog?.querySelector(".lightbox-prev")?.addEventListener("click", () => afficher(index - 1));
    dialog?.querySelector(".lightbox-next")?.addEventListener("click", () => afficher(index + 1));
    document.addEventListener("keydown", (evenement) => {
      if (!dialog?.open) return;
      if (evenement.key === "ArrowLeft") afficher(index - 1);
      if (evenement.key === "ArrowRight") afficher(index + 1);
    });
    dialog?.addEventListener("touchstart", (event) => {
      touchX = event.changedTouches[0]?.clientX || 0;
    }, { passive: true });
    dialog?.addEventListener("touchend", (event) => {
      const delta = (event.changedTouches[0]?.clientX || 0) - touchX;
      if (Math.abs(delta) > 45) afficher(index + (delta < 0 ? 1 : -1));
    }, { passive: true });
    dialog?.querySelector(".lightbox-close")?.addEventListener("click", () => dialog.close());
    dialog?.querySelector(".lightbox-edit")?.addEventListener("click", () => { if(editor) editor.hidden=!editor.hidden; });
    dialog?.addEventListener("click", (evenement) => {
      if (evenement.target === dialog) dialog.close();
    });
    dialog?.addEventListener("close", () => {
      if (agrandissement) agrandissement.removeAttribute("src");
      if(editor)editor.hidden=true;
      index = -1;
    });
        async function initPhotoEditor(){
      try{
        const me=await fetch("/api/prive/moi",{credentials:"same-origin",cache:"no-store"});
        if(!me.ok)return;const user=await me.json();if(!user.isAdmin)return;isAdmin=true;
        const [library,steps]=await Promise.all([fetch("/api/prive/admin/media",{credentials:"same-origin",cache:"no-store"}),fetch("/api/prive/etapes",{credentials:"same-origin",cache:"no-store"})]);
        if(!library.ok||!steps.ok)return;adminPhotos=(await library.json()).photos||[];
        const allSteps=(await steps.json()).etapes||[];
        if(editStage){for(const step of allSteps){const option=document.createElement("option");option.value=step.slug;option.textContent=step.ville+" · "+step.pays;editStage.append(option);}}
        for(const button of document.querySelectorAll<HTMLButtonElement>(".photo-open")){const p=adminPhotos.find(item=>item.src===button.dataset.photo);if(p){button.dataset.key=p.key;button.dataset.visibility=p.visibilite;button.dataset.alt=p.alt||button.dataset.alt||"";}}
        if(editor)editor.hidden=true;
      }catch{}
    }
    editor?.addEventListener("submit",async event=>{
      event.preventDefault();const p=selectedPhoto();if(!p||!editDate||!editPlace||!editComment||!editStage||!editLat||!editLon||!editStatus)return;
      editStatus.textContent="Enregistrement…";
      try{const response=await fetch("/api/prive/admin/photo-modifier",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json","X-Voyage-Admin":"1"},body:JSON.stringify({key:p.key,visibilite:p.visibilite,datePrise:editDate.value,lieu:editPlace.value,commentaire:editComment.value,legende:editComment.value,etape:editStage.value,latitude:editLat.value,longitude:editLon.value})});const data=await response.json().catch(()=>({}));if(!response.ok)throw Error(data.error||"Enregistrement impossible.");Object.assign(p,{datePrise:editDate.value||null,lieu:editPlace.value,commentaire:editComment.value,legende:editComment.value,etape:editStage.value||null,latitude:editLat.value?Number(editLat.value):null,longitude:editLon.value?Number(editLon.value):null});editStatus.textContent="Modifications enregistrées.";if(compteur)compteur.textContent=(index+1)+" / "+photos.length;
      }catch(error){editStatus.textContent=error instanceof Error?error.message:"Erreur de sauvegarde.";}
    });
    initPhotoEditor();
    // Gère aussi les photos déjà présentes dans le HTML statique.
    const requestedPhoto = new URLSearchParams(location.search).get("photo");
    if (requestedPhoto) {
      const target = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo-open"))
        .find(button => button.dataset.photo === requestedPhoto || decodeURIComponent(button.dataset.photo || "") === requestedPhoto);
      target?.click();
    }
  </script>
  <style>
    .lightbox:not([open]){display:none}
    .lightbox{box-sizing:border-box;width:min(96vw,1100px);max-width:96vw;max-height:96dvh;overflow:auto;padding:3.5rem 1rem 1rem;position:relative}
    .lightbox img{display:block;max-height:60vh;max-width:90vw;width:auto;height:auto;object-fit:contain;margin:0 auto}
    .lightbox-close,.lightbox-edit{position:sticky;top:0;z-index:5;width:42px;height:42px;border:0;border-radius:50%;background:#fff;color:#222;box-shadow:0 2px 12px #0002;font-size:1.35rem;cursor:pointer}
    .lightbox-close{position:absolute;top:.65rem;right:.65rem}.lightbox-edit{position:absolute;top:.65rem;right:3.8rem}
    .photo-editor{width:100%;max-width:640px;max-height:none;box-sizing:border-box;overflow:visible;background:var(--surface,#fff);color:var(--text,#222);padding:1rem;border-radius:12px;text-align:left;display:grid;gap:.55rem;margin:1rem auto 0}
    .photo-editor[hidden]{display:none}.photo-editor input,.photo-editor textarea,.photo-editor select{box-sizing:border-box;width:100%;min-width:0;padding:.65rem;border:1px solid #bbb;border-radius:8px;font:inherit}.photo-editor label{font-size:.85rem;font-weight:600}.photo-editor button{padding:.75rem;border:0;border-radius:8px;cursor:pointer}
    @media(max-width:600px) and (orientation:portrait){
      .lightbox{position:fixed;inset:0;margin:0;width:100vw;height:100dvh;max-width:none;max-height:none;border:0;border-radius:0;padding:3.7rem 1rem max(1rem,env(safe-area-inset-bottom));display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:.65rem}
      .lightbox img{flex:0 1 auto;width:100%;max-width:100%;max-height:40dvh;object-fit:contain;margin:auto}
      .lightbox-counter{margin:.2rem 0;text-align:center}
      .lightbox-prev,.lightbox-next{flex:0 0 auto;align-self:center}
      .photo-editor{flex:1 1 auto;min-height:0;max-width:none;max-height:none;overflow-y:auto;margin:0;padding:.75rem}
      .photo-editor .eyebrow{margin:.1rem 0}
      .photo-editor textarea{resize:vertical}
    }
  </style>
</Base>
