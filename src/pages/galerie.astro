          body: JSON.stringify({ key: photo.key, visibilite: photo.visibilite })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw Error(data.error || "Suppression impossible.");
        const removedButton = photos[index];
        removedButton?.closest("figure")?.remove();
        adminPhotos = adminPhotos.filter(item => !(item.key === photo.key && item.visibilite === photo.visibilite));
        photos = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo-open"))
