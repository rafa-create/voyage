---
import Base from "../layouts/Base.astro";
import CarteItineraire from "../components/CarteItineraire.astro";
import { etapes } from "../lib/data";

const points = etapes.filter((e) => Number.isFinite(e.latitude) && Number.isFinite(e.longitude));
---

<Base title="Hier" headerTitle="Hier" active="ir">
  <section class="container section daily-view daily-map-controls" aria-label="Carte du voyage">
    <h1 id="home-map-heading">Où j'étais hier</h1>
  </section>
  <section class="route-section home-map-only" aria-labelledby="home-map-heading">
    <div class="route-map-card home-full-width-map">
      <CarteItineraire etapes={etapes}/>
    </div>
  </section>
  <section class="container section daily-view daily-map-controls daily-map-controls-bottom" aria-label="Choisir le jour du souvenir">
    <div class="home-map-control-row">
      <div class="section-heading">
        <div>
          <div class="daily-heading-title daily-heading-visible">
            <button type="button" id="day-previous" class="daily-arrow" aria-label="Jour précédent" title="Jour précédent" disabled>←</button>
            <h2 id="daily-heading-prefix">Souvenir du</h2>
            <input type="date" id="daily-date-picker" aria-label="Choisir la journée mise en avant" title="Choisir une journée" />
            <button type="button" id="day-next" class="daily-arrow" aria-label="Jour suivant" title="Jour suivant" disabled>→</button>
          </div>
        </div>
      </div>
      <button type="button" id="map-visibility-toggle" aria-expanded="true">Masquer la carte</button>
    </div>
  </section>

  <section id="daily-view" class="container section daily-view" aria-label="Photos du jour">
    <div id="daily-photos" class="photo-grid gallery-grid" aria-live="polite"></div>
    <p id="daily-empty" hidden>Aucune photo ni vidéo.</p>
    <section id="daily-activities-wrap" class="daily-activities" hidden aria-label="Activités du jour">
      <h3>Activités</h3>
      <div id="daily-activities"></div>
    </section>
  </section>

  <script>
    // Défense contre un ancien rendu qui ajouterait encore un second bouton dans la carte.
    document.querySelectorAll<HTMLButtonElement>("#map-visibility-toggle").forEach((button, index) => {
      if (index > 0) button.remove();
    });
    type DailyPhoto = {src:string;alt?:string;legende?:string;commentaire?:string;etape?:string;datePrise?:string;dateHeure?:string;ajouteLe?:string;latitude?:number;longitude?:number};
    const dateLabel = (value:string) => "Souvenir du " + new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"long",timeZone:"Europe/Paris"}).format(new Date(value+"T12:00:00"));
    const dateKey = (p:DailyPhoto) => String(p.dateHeure || p.datePrise || p.ajouteLe || "").slice(0,10);
    const grid = document.querySelector<HTMLElement>("#daily-photos");
    const dateText = document.querySelector<HTMLElement>("#daily-date");
    const headingDate = document.querySelector<HTMLElement>("#daily-heading-date");
    const empty = document.querySelector<HTMLElement>("#daily-empty");
    const activitiesWrap = document.querySelector<HTMLElement>("#daily-activities-wrap");
    const activitiesGrid = document.querySelector<HTMLElement>("#daily-activities");
    const previous = document.querySelector<HTMLButtonElement>("#day-previous");
    const next = document.querySelector<HTMLButtonElement>("#day-next");
    const dailyDatePicker = document.querySelector<HTMLInputElement>("#daily-date-picker");
    async function initDailyView() {
      if (!grid || !empty || !previous || !next) return;
      const safeJson = async (url:string) => {
        try {
          const response = await fetch(url,{cache:"no-store"});
          if (!response.ok) return {};
          return await response.json();
        } catch { return {}; }
      };
      const [photoData, eventData, fileVideoData, stageData] = await Promise.all([
        safeJson("/api/public/photos"),
        safeJson("/api/public/carte-evenements"),
        safeJson("/api/public/videos-fichiers"),
        safeJson("/api/public/etapes")
      ]);
      const photos:DailyPhoto[] = photoData.photos || [];
      const fileVideos:any[] = fileVideoData.videos || [];
      const stages:any[] = Array.isArray(stageData.etapes) ? stageData.etapes : [];
      const videoDateKey = (video:any) => String(video.date || video.ajouteLe || "").slice(0,10);
      const youtubeVideos:any[] = (await Promise.all(stages.map(async (stage:any) => {
        if (!stage.slug) return [];
        const data = await safeJson("/api/public/videos?etape="+encodeURIComponent(stage.slug));
        return (Array.isArray(data.videos) ? data.videos : []).map((video:any) => {
          const match = String(video.url || "").match(/(?:youtu\.be\/|[?&]v=|\/(?:embed|shorts|live)\/)([a-zA-Z0-9_-]{11})/);
          const youtubeId = match?.[1];
          const date = String(video.dateHeure || video.datePrise || video.date || stage.date || "").slice(0,10);
          return youtubeId && /^\d{4}-\d{2}-\d{2}$/.test(date) ? {...video, youtubeId, dailyDate:date} : null;
        }).filter(Boolean);
      }))).flat();
      const courses = eventData.courses || [];
      const dates = new Set<string>();
      for (const photo of photos) { const d=dateKey(photo); if (/^\d{4}-\d{2}-\d{2}$/.test(d)) dates.add(d); }
      for (const video of fileVideos) { const d=videoDateKey(video); if (/^\d{4}-\d{2}-\d{2}$/.test(d)) dates.add(d); }
      for (const video of youtubeVideos) dates.add(video.dailyDate);
      const activityDate = (course:any) => String(course.date || (course.fin ? new Intl.DateTimeFormat("en-CA",{timeZone:"Europe/Paris",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date(Number(course.fin))) : "")).slice(0,10);
      for (const course of courses) {
        const d=activityDate(course);
        if (/^\d{4}-\d{2}-\d{2}$/.test(d)) dates.add(d);
      }
      // Chronologie partagée par les commandes de la carte : photos, vidéos et activités.
      type NavigationItem = {date:string;kind:"photo"|"sport"|"video-fichier";key:string;time:number|null;sequence:number};
      const navigationItems:NavigationItem[] = [];
      let navigationSequence = 0;
      const eventTime = (value:unknown):number|null => {
        if (value === null || value === undefined || value === "") return null;
        if (typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value.trim())) return null;
        const parsed = typeof value === "number" ? new Date(value < 1e12 ? value * 1000 : value).getTime() : new Date(String(value)).getTime();
        return Number.isFinite(parsed) ? parsed : null;
      };
      for (const photo of photos) {
        const date = dateKey(photo);
        if (photo.src && /^\d{4}-\d{2}-\d{2}$/.test(date)) navigationItems.push({date,kind:"photo",key:String(photo.src),time:eventTime(photo.dateHeure||photo.datePrise),sequence:navigationSequence++});
      }
      for (const video of fileVideos) {
        const date = videoDateKey(video);
        if (video.key && /^\d{4}-\d{2}-\d{2}$/.test(date)) navigationItems.push({date,kind:"video-fichier",key:"video-file:"+String(video.key),time:eventTime(video.date||video.ajouteLe),sequence:navigationSequence++});
      }
      for (const activity of courses) {
        const date = activityDate(activity);
        const timestamp = activity.debut||activity.start_time||activity.start||activity.dateDebut||activity.fin||activity.end_time||activity.end;
        if (/^\d{4}-\d{2}-\d{2}$/.test(date) && activity.id !== undefined && activity.id !== null) navigationItems.push({date,kind:"sport",key:String(activity.id),time:eventTime(timestamp),sequence:navigationSequence++});
      }
      navigationItems.sort((a,b) => a.date.localeCompare(b.date) || (a.time !== null && b.time !== null ? a.time-b.time : a.time !== null ? -1 : b.time !== null ? 1 : a.sequence-b.sequence) || a.sequence-b.sequence);
      const todayParts = new Intl.DateTimeFormat("fr-FR",{timeZone:"Europe/Paris",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date());
      const part = (type:string) => todayParts.find(p=>p.type===type)?.value || "";
      const todayKey = part("year")+"-"+part("month")+"-"+part("day");
      const yesterdayDate = new Date(Date.UTC(Number(part("year")), Number(part("month")) - 1, Number(part("day")) - 1));
      const yesterdayKey = [yesterdayDate.getUTCFullYear(), String(yesterdayDate.getUTCMonth()+1).padStart(2,"0"), String(yesterdayDate.getUTCDate()).padStart(2,"0")].join("-");
      // Toujours inclure aujourd'hui et hier, même sans photo ni activité associée.
      dates.add(todayKey);
      dates.add(yesterdayKey);
      let ordered = Array.from(dates).sort((a,b)=>b.localeCompare(a));
      const todayIndex = ordered.indexOf(todayKey);
      const yesterdayIndex = ordered.indexOf(yesterdayKey);
      // À l’arrivée, afficher les souvenirs d’hier, comme le bouton « Hier » de la carte.
      let index = yesterdayIndex >= 0 ? yesterdayIndex : todayIndex;
      const initialDay = ordered[index] || yesterdayKey;
      let navigationIndex = -1;
      for (let i=0;i<navigationItems.length;i++) { if (navigationItems[i].date === initialDay) { navigationIndex=i; break; } }
      if (navigationIndex < 0) for (let i=navigationItems.length-1;i>=0;i--) { if (navigationItems[i].date <= initialDay) { navigationIndex=i; break; } }
      if (navigationIndex < 0 && navigationItems.length) navigationIndex=0;
      if (navigationIndex >= 0 && navigationItems[navigationIndex].date !== initialDay) {
        const alignedDayIndex = ordered.indexOf(navigationItems[navigationIndex].date);
        if (alignedDayIndex >= 0) index = alignedDayIndex;
      }
      const render = () => {
        const day = ordered[index];
        if (dailyDatePicker) dailyDatePicker.value = day || "";
        if (dateText) dateText.textContent = dateLabel(day);
        const heading = document.querySelector<HTMLElement>("#daily-heading");
        if (heading) heading.textContent = dateLabel(day);
        if (headingDate) headingDate.textContent = new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"long",timeZone:"Europe/Paris"}).format(new Date(day+"T12:00:00"));
        grid.replaceChildren();
        const dayPhotos = photos.filter(p=>dateKey(p)===day)
          .sort((a,b)=>String(b.dateHeure||b.datePrise||b.ajouteLe||"").localeCompare(String(a.dateHeure||a.datePrise||a.ajouteLe||"")));
        for (const photo of dayPhotos) {
          const figure=document.createElement("figure");figure.className="photo-tile";
          const button=document.createElement("button");button.type="button";button.className="photo-open";
          button.dataset.photo=photo.src;button.dataset.alt=photo.alt||"Photo du voyage";
          button.setAttribute("aria-label","Afficher cette photo sur la carte : "+(photo.alt||"photo du voyage"));
          const photoDay=dateKey(photo);
          const linkedStage=photo.etape?stages.find(stage=>stage.slug===photo.etape):undefined;
          const fallbackStage=linkedStage||[...stages].filter(stage=>String(stage.date||"")<=photoDay).sort((a,b)=>String(b.date).localeCompare(String(a.date)))[0]||stages.find(stage=>stage.date===photoDay);
          const hasPhotoGps=photo.latitude!==null&&photo.latitude!==undefined&&photo.latitude!==""&&photo.longitude!==null&&photo.longitude!=="";
          const photoMapLat=hasPhotoGps?Number(photo.latitude):Number(fallbackStage?.latitude);
          const photoMapLon=hasPhotoGps?Number(photo.longitude):Number(fallbackStage?.longitude);
          const hasMapPosition=Number.isFinite(photoMapLat)&&Math.abs(photoMapLat)<=85&&Number.isFinite(photoMapLon)&&Math.abs(photoMapLon)<=180&&(hasPhotoGps||!!fallbackStage);
          button.addEventListener("click",()=>window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte",{detail:{
            date:day,kind:"photo",key:photo.src,
            ...(hasMapPosition?{latitude:photoMapLat,longitude:photoMapLon}:{})
          }})));
          const img=document.createElement("img");img.src=photo.src;img.alt=photo.alt||"Photo du voyage";img.loading="lazy";img.decoding="async";
          button.append(img);figure.append(button);
          const caption=document.createElement("figcaption");
          const place = String(photo.legende || photo.commentaire || photo.alt || photo.etape || "Photo").replace(/-/g," ").replace(/\b\p{L}/gu, (letter:string) => letter.toLocaleUpperCase("fr-FR"));
          const time=photo.dateHeure? " · "+photo.dateHeure.slice(11,16):"";
          caption.textContent=place+time;
          figure.append(caption);grid.append(figure);
        }
        const dayVideos = fileVideos.filter(video=>videoDateKey(video)===day)
          .sort((a,b)=>String(b.date||b.ajouteLe||"").localeCompare(String(a.date||a.ajouteLe||"")));
        const dayYoutubeVideos = youtubeVideos.filter(video=>video.dailyDate===day)
          .sort((a,b)=>String(b.dateHeure||b.datePrise||b.date||"").localeCompare(String(a.dateHeure||a.datePrise||a.date||"")));
        for (const video of dayVideos) {
          const figure=document.createElement("figure");figure.className="photo-tile daily-video-tile";
          const player=document.createElement("video");player.src=video.src;player.controls=true;player.preload="metadata";player.playsInline=true;
          player.setAttribute("aria-label",video.titre||"Vidéo du voyage");
          player.style.width="100%";player.style.aspectRatio="16/9";player.style.background="#000";
          figure.append(player);
          const caption=document.createElement("figcaption");
          caption.textContent=(video.titre||"Vidéo du voyage")+(video.date?" · "+String(video.date).slice(11,16):"");
          figure.append(caption);
          const linkedStage=video.etape?stages.find(stage=>stage.slug===video.etape):undefined;
          const videoDay=videoDateKey(video);
          const mapStage=linkedStage||[...stages].filter(stage=>String(stage.date||"")<=videoDay).sort((a,b)=>String(b.date).localeCompare(String(a.date)))[0]||stages.find(stage=>stage.date===videoDay);
          const hasVideoGps=video.latitude!==null&&video.latitude!==undefined&&video.latitude!==""&&video.longitude!==null&&video.longitude!==undefined&&video.longitude!=="";
          const mapLat=hasVideoGps?Number(video.latitude):Number(mapStage?.latitude);
          const mapLon=hasVideoGps?Number(video.longitude):Number(mapStage?.longitude);
          if(video.key&&Number.isFinite(mapLat)&&Math.abs(mapLat)<=85&&Number.isFinite(mapLon)&&Math.abs(mapLon)<=180&&(hasVideoGps||!!mapStage)){
            const mapButton=document.createElement("button");
            mapButton.type="button";
            mapButton.className="daily-video-map-link";
            mapButton.textContent="Voir sur la carte";
            mapButton.setAttribute("aria-label","Voir sur la carte : "+(video.titre||"Vidéo du voyage"));
            mapButton.addEventListener("click",()=>window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte",{detail:{date:videoDay,kind:"video-fichier",key:"video-file:"+String(video.key)}})));
            figure.append(mapButton);
          }
          grid.append(figure);
        }
        for (const video of dayYoutubeVideos) {
          const figure=document.createElement("figure");figure.className="photo-tile daily-video-tile daily-youtube-tile";
          const frame=document.createElement("iframe");
          frame.src="https://www.youtube-nocookie.com/embed/"+video.youtubeId;
          frame.title=video.titre||"Vidéo YouTube du voyage";
          frame.loading="lazy";
          frame.allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          frame.allowFullscreen=true;
          frame.referrerPolicy="strict-origin-when-cross-origin";
          frame.style.width="100%";frame.style.aspectRatio="16/9";frame.style.border="0";frame.style.background="#000";
          figure.append(frame);
          const caption=document.createElement("figcaption");
          caption.textContent=(video.titre||"Vidéo YouTube du voyage")+(video.dateHeure?" · "+String(video.dateHeure).slice(11,16):"");
          figure.append(caption);grid.append(figure);
        }
        empty.hidden = dayPhotos.length>0 || dayVideos.length>0 || dayYoutubeVideos.length>0;
        if (activitiesWrap && activitiesGrid) {
          activitiesGrid.replaceChildren();
          const dayActivities = courses.filter((course:any) => activityDate(course) === day)
            .sort((a:any,b:any) => Number(b.fin||0)-Number(a.fin||0));
          for (const activity of dayActivities) {
            const item = document.createElement("article");
            item.className = "daily-activity";
            const copy = document.createElement("div");
            copy.className = "daily-activity-copy";
            const name = document.createElement("button");
            name.type = "button";
            name.className = "daily-activity-title";
            name.textContent = activity.titre || "Activité";
            name.addEventListener("click",()=>window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte",{detail:{date:activityDate(activity),kind:"sport",key:activity.id ? String(activity.id) : ""}})));
            const details = document.createElement("span");
            const parts = [String(activity.sport || "").replace(/^./, (c:string) => c.toLocaleUpperCase("fr-FR"))];
            if (typeof activity.km === "number" && activity.km > 0) parts.push(activity.km.toLocaleString("fr-FR",{maximumFractionDigits:2})+" km");
            if (typeof activity.minutes === "number" && activity.minutes > 0) parts.push(activity.minutes+" min");
            if (activity.fin) {
              const clock = new Intl.DateTimeFormat("fr-FR",{hour:"2-digit",minute:"2-digit",timeZone:"Europe/Paris"}).format(new Date(Number(activity.fin)));
              if (clock) parts.push(clock);
            }
            details.textContent = parts.filter(Boolean).join(" · ");
            copy.append(name, details);
            item.append(copy);
            const actions = document.createElement("div");
            actions.className = "daily-activity-actions";
            if (activity.url && /^https:\/\/(www\.)?strava\.com\//.test(activity.url)) {
              const link = document.createElement("a");
              link.href = activity.url; link.target = "_blank"; link.rel = "noopener noreferrer";
              link.textContent = "Strava";
              actions.append(link);
            }
            item.append(actions);
            activitiesGrid.append(item);
          }
          activitiesWrap.hidden = dayActivities.length === 0;
        }
        previous.disabled = navigationIndex <= 0 || navigationItems.length === 0;
        next.disabled = navigationIndex < 0 || navigationIndex >= navigationItems.length-1;
        previous.title = "Souvenir précédent";
        previous.setAttribute("aria-label","Souvenir précédent");
        next.title = "Souvenir suivant";
        next.setAttribute("aria-label","Souvenir suivant");
        document.documentElement.dataset.voyageDay = day;
        window.dispatchEvent(new CustomEvent("voyage:jour",{detail:{date:day}}));
      };
      // Les sélections venant de la carte doivent aussi changer le contenu du souvenir du jour.
      window.addEventListener("voyage:jour",(event)=>{
        const detail=(event as CustomEvent<{date?:string}>).detail;
        const target=detail?.date ? ordered.indexOf(detail.date) : -1;
        if(target>=0 && target!==index){
          index=target;
          const first=navigationItems.findIndex(item=>item.date===detail.date);
          if(first>=0) navigationIndex=first;
          render();
        }
      });
      const selectNavigationItem = (targetIndex:number) => {
        if (targetIndex < 0 || targetIndex >= navigationItems.length) return;
        navigationIndex = targetIndex;
        const selected = navigationItems[navigationIndex];
        const dayIndex = ordered.indexOf(selected.date);
        if (dayIndex >= 0) index = dayIndex;
        render();
        window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte",{detail:{date:selected.date,kind:selected.kind,key:selected.key}}));
      };
      const goPrevious = () => selectNavigationItem(navigationIndex-1);
      const goNext = () => selectNavigationItem(navigationIndex+1);
      dailyDatePicker?.addEventListener("change",()=>{
        const day=dailyDatePicker.value;
        if(!/^\d{4}-\d{2}-\d{2}$/.test(day))return;
        if(!ordered.includes(day)) ordered=[...ordered,day].sort((a,b)=>b.localeCompare(a));
        index=ordered.indexOf(day);
        const matchingIndex=navigationItems.findIndex(item=>item.date===day);
        if(matchingIndex>=0) navigationIndex=matchingIndex;
        render();
      });
      previous.addEventListener("click",goPrevious);
      next.addEventListener("click",goNext);
      window.addEventListener("voyage:aujourdhui",()=>{index=todayIndex;const first=navigationItems.findIndex(item=>item.date===todayKey);if(first>=0)navigationIndex=first;render();});
      window.addEventListener("voyage:hier",()=>{if(yesterdayIndex>=0){index=yesterdayIndex;const first=navigationItems.findIndex(item=>item.date===yesterdayKey);if(first>=0)navigationIndex=first;render();}});
      render();
    }
    initDailyView().catch(()=>{ if(dateText) dateText.textContent="Impossible de charger les souvenirs pour le moment."; });
  </script>
  <style is:global>
    .daily-map-controls { padding-top: 18px; padding-bottom: 8px; }
    .daily-map-controls-bottom { padding-top: 12px; padding-bottom: 4px; }
    .daily-map-controls > h1 { margin: 0 0 12px; color: var(--forest); font-size: clamp(1.55rem, 2.5vw, 2rem); line-height: 1.2; }
    .home-map-control-row { display: flex; align-items: center; justify-content: flex-start; gap: 6px; flex-wrap: nowrap; min-width: 0; }
    .home-map-control-row .section-heading { display: flex; align-items: center; gap: 3px; margin: 0; min-width: 0; flex: 0 1 auto; flex-wrap: nowrap; }
    .home-map-control-row .section-heading > div { min-width: 0; }
    .home-map-control-row .section-heading h2 { margin: 0; white-space: nowrap; font: 600 .84rem 'DM Sans',sans-serif; letter-spacing: 0; }
    .daily-map-controls .daily-heading-title { display: flex; align-items: center; gap: 3px; white-space: nowrap; flex-wrap: nowrap; }
    #daily-date-picker { width: 112px; min-width: 112px; height: 32px; padding: 3px 5px; border: 1px solid var(--line); border-radius: 4px; background: var(--white); color: var(--forest); cursor: pointer; }
    #daily-date-picker:focus-visible { outline: 2px solid var(--forest); outline-offset: 3px; }
    .home-map-control-row #daily-date { margin: 0; }
    .home-map-control-row .daily-arrow { display: grid; place-items: center; flex: 0 0 auto; width: auto; min-width: 0; height: 32px; min-height: 32px; padding: 0; margin: 0; font-size: 1.15rem; line-height: 1; }
    /* Deux colonnes donnent plus de place aux photos ; les vidéos occupent toute la largeur. */
    .daily-view .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .daily-view .gallery-grid .daily-video-tile { grid-column: 1 / -1; }
    .daily-video-map-link { display:inline-block;margin-top:.5rem;padding:.35rem .65rem;border:1px solid var(--line);border-radius:3px;background:var(--white);color:var(--forest);font:600 .78rem 'DM Sans',sans-serif;cursor:pointer; }
    .daily-video-map-link:hover { background:var(--forest);color:#fff; }
    .daily-view .daily-video-tile iframe,
    .daily-view .daily-video-tile video { display: block; width: 100%; aspect-ratio: 16 / 9; }

    #map-visibility-toggle { flex: 0 0 auto; margin-left: auto; width: auto; min-height: 32px; padding: 6px 11px; border: 1px solid var(--line); border-radius: 4px; background: transparent; color: var(--forest); font: 600 .76rem 'DM Sans',sans-serif; cursor: pointer; white-space: nowrap; transition: background-color .16s ease, border-color .16s ease; }
    #map-visibility-toggle:hover { background: var(--white); border-color: #b9b3a5; }
    #map-visibility-toggle:active { background: #f2f0e9; }
    #map-visibility-toggle:focus-visible { outline: 2px solid var(--forest); outline-offset: 3px; }
    .daily-view:not(.daily-map-controls) { padding-top: 28px; }
    .daily-heading-title { display: flex; }
    .daily-view #daily-date { margin-top: 8px; font-size: .8rem; }
    .daily-activities { margin-top: 22px; }
    .daily-activities[hidden] { display: none !important; }
    .daily-activities h3 { font: 700 .8rem 'DM Sans',sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
    #daily-activities { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
    .daily-activity { display: flex; justify-content: space-between; gap: 14px; align-items: center; padding: 14px 16px; border: 1px solid var(--line); background: var(--white); }
    .daily-activity-copy { display: grid; gap: 5px; min-width: 0; }
    .daily-activity-title { border: 0; padding: 0; background: transparent; color: var(--forest); font: inherit; font-size: .9rem; line-height: 1.35; font-weight: 700; text-align: left; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
