---
import Base from "../layouts/Base.astro";
import { etapes, pays, galerie, dateFr } from "../lib/data";
import photosAClasser from "../data/photos-a-classer.json";
import { chemin } from "../lib/paths";

const recentes = etapes.slice(0, 3);
---

<Base title="Accueil" active="accueil">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> LE CARNET DE ROUTE</p>
        <h1>Des kilomètres.<br />Des rencontres.<br /><em>Des souvenirs.</em></h1>
        <p class="lead">Un endroit pour garder les traces du voyage : les paysages, les histoires, les petits instants et tout ce qu'on ne veut pas oublier.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={chemin("/journal/")}>Explorer le journal <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={chemin("/galerie/")}>Voir la galerie <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="art-coordinates">SOUVENIRS / EN MOUVEMENT</span>
        <div class="sun"></div>
        <div class="ridge ridge-back"></div>
        <div class="ridge ridge-front"></div>
        <span class="art-stamp">01<br /><small>LE DÉPART</small></span>
      </div>
    </div>
    <div class="container stat-line">
      <span>{etapes.length} {etapes.length > 1 ? "étapes" : "étape"}</span>
      <span class="stat-dot">✳</span>
      <span>{pays.length} {pays.length > 1 ? "pays" : "pays"}</span>
      <span class="stat-dot">✳</span>
      <span>{galerie.length + photosAClasser.length} {galerie.length + photosAClasser.length > 1 ? "photos" : "photo"}</span>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LE FIL DU VOYAGE</p>
        <h2>Les dernières étapes<span class="heading-dot">.</span></h2>
      </div>
      <a class="text-link" href={chemin("/journal/")}>Tout le journal <span aria-hidden="true">↗</span></a>
    </div>
    {recentes.length > 0 ? (
      <div class="cards-grid">
        {recentes.map((etape, index) => (
          <a class="step-card" href={chemin("/etapes/" + etape.slug + "/")}>
            {etape.photos[0] ? (
              <img src={chemin(etape.photos[0].src)} alt={etape.photos[0].alt} loading="lazy" width="720" height="480" />
            ) : (
              <div class="card-illustration"><span>✳</span></div>
            )}
            <div class="card-body">
              <span class="card-meta">{dateFr(etape.date)} · {etape.pays}</span>
              <h3>{etape.titre}</h3>
              <span class="card-more">Découvrir l'étape <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-symbol" aria-hidden="true">✺</div>
        <h3>La première page reste à écrire.</h3>
        {photosAClasser.length > 0 ? (
          <>
            <p>Les premières photos sont déjà dans la galerie. Le journal sera enrichi dès que les étapes du voyage seront renseignées.</p>
            <a class="text-link" style="margin-top: 22px;" href={chemin("/galerie/")}>Voir les {photosAClasser.length} photos <span aria-hidden="true">↗</span></a>
          </>
        ) : (
          <p>Le carnet est prêt. Les premières photos, anecdotes et vidéos viendront bientôt remplir cet espace.</p>
        )}
      </div>
    )}
  </section>

  <section class="feature-band">
    <div class="container feature-inner">
      <p class="eyebrow">AUTRE MANIÈRE D'EXPLORER</p>
      <h2>Un endroit, mille histoires.</h2>
      <p>Retrouver chaque souvenir par pays, par étape ou simplement en parcourant les images.</p>
      <div class="feature-links">
        <a class="button button-light" href={chemin("/pays/")}>Explorer les pays <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={chemin("/galerie/")}>Parcourir les photos <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>
