---
import Base from "../layouts/Base.astro";
import CarteItineraire from "../components/CarteItineraire.astro";
import FilmVoyage from "../components/FilmVoyage.astro";
import { etapes } from "../lib/data";

const points = etapes.filter((e) => Number.isFinite(e.latitude) && Number.isFinite(e.longitude));
---

<Base title="Mon itinéraire" headerTitle="Mon itinéraire" active="accueil">
  <section class="container section daily-view daily-map-controls" aria-label="Carte du voyage">
    <h1 id="home-map-heading">Où j'étais hier</h1>
  </section>
  <section class="route-section home-map-only" aria-labelledby="home-map-heading">
    <div class="route-map-card home-full-width-map">
      <CarteItineraire etapes={etapes}/>
    </div>
  </section>
  <section class="container section daily-view daily-map-controls daily-map-controls-bottom" aria-label="Choisir le jour du souvenir">
    <div class="home-map-control-row">
      <div class="section-heading">
        <div>
          <div class="daily-heading-title daily-heading-visible">
            <div class="daily-heading-arrows" aria-label="Jour précédent">
              <button type="button" id="daily-heading-previous" aria-label="Jour précédent" disabled>←</button>
            </div>
            <h2 id="daily-heading">Souvenir du jour</h2>
            <div class="daily-heading-arrows" aria-label="Jour suivant">
              <button type="button" id="daily-heading-next" aria-label="Jour suivant" disabled>→</button>
            </div>
          </div>
        </div>
        <div class="daily-controls" aria-label="Choisir une journée">
          <button type="button" id="day-previous" disabled>← Jour précédent</button>
          <button type="button" id="day-next" disabled>Jour suivant</button>
        </div>
      </div>
      <button type="button" id="map-visibility-toggle" aria-expanded="true">Masquer la carte</button>
    </div>
  </section>

  <section id="daily-view" class="container section daily-view" aria-label="Photos du jour">
    <div id="daily-photos" class="photo-grid gallery-grid" aria-live="polite"></div>
    <p id="daily-empty" hidden>Aucune photo ni vidéo.</p>
    <section id="daily-videos-wrap" class="daily-videos" hidden aria-label="Vidéos du jour"><h3>Vidéos</h3><div id="daily-videos"></div></section>
    <section id="daily-activities-wrap" class="daily-activities" hidden aria-label="Activités du jour">
      <h3>Activités</h3>
      <div id="daily-activities"></div>
    </section>
  </section>

  <script>
    // Défense contre un ancien rendu qui ajouterait encore un second bouton dans la carte.
    document.querySelectorAll<HTMLButtonElement>("#map-visibility-toggle").forEach((button, index) => {
      if (index > 0) button.remove();
    });
    type DailyPhoto = {src:string;alt?:string;legende?:string;commentaire?:string;etape?:string;datePrise?:string;dateHeure?:string;ajouteLe?:string;latitude?:number;longitude?:number};
    const dateLabel = (value:string) => "Souvenir du " + new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"long",timeZone:"Europe/Paris"}).format(new Date(value+"T12:00:00"));
    const dateKey = (p:DailyPhoto) => String(p.dateHeure || p.datePrise || p.ajouteLe || "").slice(0,10);
    const grid = document.querySelector<HTMLElement>("#daily-photos");
    const dateText = document.querySelector<HTMLElement>("#daily-date");
    const headingDate = document.querySelector<HTMLElement>("#daily-heading-date");
    const empty = document.querySelector<HTMLElement>("#daily-empty");
    const activitiesWrap = document.querySelector<HTMLElement>("#daily-activities-wrap");
    const activitiesGrid = document.querySelector<HTMLElement>("#daily-activities");
    const previous = document.querySelector<HTMLButtonElement>("#day-previous");
    const next = document.querySelector<HTMLButtonElement>("#day-next");
    const headingPrevious = document.querySelector<HTMLButtonElement>("#daily-heading-previous");
    const headingNext = document.querySelector<HTMLButtonElement>("#daily-heading-next");
    async function initDailyView() {
      if (!grid || !empty || !previous || !next) return;
      const [photoResponse, eventResponse, looseVideoResponse] = await Promise.all([
        fetch("/api/public/photos",{cache:"no-store"}),
        fetch("/api/public/carte-evenements",{cache:"no-store"}),
        fetch("/api/public/videos",{cache:"no-store"})
      ]);
      const photos:DailyPhoto[] = photoResponse.ok ? (await photoResponse.json()).photos || [] : [];
      const courses = eventResponse.ok ? (await eventResponse.json()).courses || [] : [];
      type DailyVideo = {id?:string;url?:string;titre?:string;date?:string;datePrise?:string;dateHeure?:string;etape?:string;lieu?:string;ville?:string;pays?:string};
      const looseVideos:DailyVideo[] = looseVideoResponse.ok ? (await looseVideoResponse.json()).videos || [] : [];
      const videoGroups = await Promise.all(etapes.map(async step => {
        try {
          const response = await fetch("/api/public/videos?etape="+encodeURIComponent(step.slug),{cache:"no-store"});
          const data = response.ok ? await response.json() : {videos:[]};
          return (data.videos || []).map((video:DailyVideo)=>({...video,etape:step.slug}));
        } catch { return []; }
      }));
      const videos:DailyVideo[] = [...looseVideos.map(video=>({...video,etape:"sans-etape"})),...videoGroups.flat()];
      const dates = new Set<string>();
      for (const photo of photos) { const d=dateKey(photo); if (/^\d{4}-\d{2}-\d{2}$/.test(d)) dates.add(d); }
      const videoDate = (video:DailyVideo) => String(video.dateHeure || video.datePrise || video.date || "").slice(0,10);
      for (const video of videos) { const d=videoDate(video); if (/^\d{4}-\d{2}-\d{2}$/.test(d)) dates.add(d); }
      const activityDate = (course:any) => String(course.date || (course.fin ? new Intl.DateTimeFormat("en-CA",{timeZone:"Europe/Paris",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date(Number(course.fin))) : "")).slice(0,10);
      for (const course of courses) {
        const d=activityDate(course);
        if (/^\d{4}-\d{2}-\d{2}$/.test(d)) dates.add(d);
      }
      const todayParts = new Intl.DateTimeFormat("fr-FR",{timeZone:"Europe/Paris",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date());
      const part = (type:string) => todayParts.find(p=>p.type===type)?.value || "";
      const todayKey = part("year")+"-"+part("month")+"-"+part("day");
      const yesterdayDate = new Date(Date.UTC(Number(part("year")), Number(part("month")) - 1, Number(part("day")) - 1));
      const yesterdayKey = [yesterdayDate.getUTCFullYear(), String(yesterdayDate.getUTCMonth()+1).padStart(2,"0"), String(yesterdayDate.getUTCDate()).padStart(2,"0")].join("-");
      // Toujours inclure aujourd'hui et hier, même sans photo ni activité associée.
      dates.add(todayKey);
      dates.add(yesterdayKey);
      const ordered = Array.from(dates).sort((a,b)=>b.localeCompare(a));
      const todayIndex = ordered.indexOf(todayKey);
      const yesterdayIndex = ordered.indexOf(yesterdayKey);
      // À l’arrivée, afficher les souvenirs d’hier, comme le bouton « Hier » de la carte.
      let index = yesterdayIndex >= 0 ? yesterdayIndex : todayIndex;
      const render = () => {
        const day = ordered[index];
        if (dateText) dateText.textContent = dateLabel(day);
        const heading = document.querySelector<HTMLElement>("#daily-heading");
        if (heading) heading.textContent = dateLabel(day);
        if (headingDate) headingDate.textContent = new Intl.DateTimeFormat("fr-FR",{day:"numeric",month:"long",timeZone:"Europe/Paris"}).format(new Date(day+"T12:00:00"));
        grid.replaceChildren();
        const dayPhotos = photos.filter(p=>dateKey(p)===day)
          .sort((a,b)=>String(b.dateHeure||b.datePrise||b.ajouteLe||"").localeCompare(String(a.dateHeure||a.datePrise||a.ajouteLe||"")));
        for (const photo of dayPhotos) {
          const figure=document.createElement("figure");figure.className="photo-tile";
          const button=document.createElement("button");button.type="button";button.className="photo-open";
          button.dataset.photo=photo.src;button.dataset.alt=photo.alt||"Photo du voyage";
          button.setAttribute("aria-label","Afficher cette photo sur la carte : "+(photo.alt||"photo du voyage"));
          button.addEventListener("click",()=>window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte",{detail:{date:day,kind:"photo",key:photo.src}})));
          const img=document.createElement("img");img.src=photo.src;img.alt=photo.alt||"Photo du voyage";img.loading="lazy";img.decoding="async";
          button.append(img);figure.append(button);
          const caption=document.createElement("figcaption");
          const place = String(photo.legende || photo.commentaire || photo.alt || photo.etape || "Photo").replace(/-/g," ").replace(/\b\p{L}/gu, (letter:string) => letter.toLocaleUpperCase("fr-FR"));
          const time=photo.dateHeure? " · "+photo.dateHeure.slice(11,16):"";
          caption.textContent=place+time;
          figure.append(caption);grid.append(figure);
        }
        const dayVideos = videos.filter(video => {
          const explicitDate = videoDate(video);
          if (explicitDate) return explicitDate === day;
          if (!video.etape || video.etape === "sans-etape") return false;
          const step = etapes.find(item=>item.slug===video.etape);
          if (!step) return false;
          const nextStepDate = [...etapes].filter(item=>item.date>step.date).sort((a,b)=>a.date.localeCompare(b.date))[0]?.date;
          return day >= step.date && (step.dateFin ? day <= step.dateFin : !nextStepDate || day < nextStepDate);
        });
        const dailyVideosWrap = document.querySelector<HTMLElement>("#daily-videos-wrap");
        const dailyVideosGrid = document.querySelector<HTMLElement>("#daily-videos");
        if (dailyVideosGrid && dailyVideosWrap) {
          dailyVideosGrid.replaceChildren();
          for (const video of dayVideos) {
            const id = String(video.url || "").match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/)?.[1];
            if (!id) continue;
            const figure = document.createElement("figure"); figure.className="photo-tile daily-video-tile";
            const link = document.createElement("a"); link.href=video.url || ("https://www.youtube.com/watch?v="+id); link.target="_blank"; link.rel="noopener noreferrer"; link.className="daily-video-link";
            const poster = document.createElement("img"); poster.src="https://i.ytimg.com/vi/"+id+"/hqdefault.jpg"; poster.alt=video.titre || "Vidéo du voyage"; poster.loading="lazy"; poster.decoding="async";
            const play = document.createElement("span"); play.className="daily-video-play"; play.setAttribute("aria-hidden","true"); play.textContent="▶";
            link.append(poster,play); figure.append(link);
            const caption=document.createElement("figcaption"); caption.textContent=video.titre || "Vidéo du voyage"; figure.append(caption); dailyVideosGrid.append(figure);
          }
          dailyVideosWrap.hidden = dailyVideosGrid.childElementCount===0;
        }
        empty.hidden = dayPhotos.length>0 || dayVideos.length>0;
        if (activitiesWrap && activitiesGrid) {
          activitiesGrid.replaceChildren();
          const dayActivities = courses.filter((course:any) => activityDate(course) === day)
            .sort((a:any,b:any) => Number(b.fin||0)-Number(a.fin||0));
          for (const activity of dayActivities) {
            const item = document.createElement("article");
            item.className = "daily-activity";
            const copy = document.createElement("div");
            copy.className = "daily-activity-copy";
            const name = document.createElement("button");
            name.type = "button";
            name.className = "daily-activity-title";
            name.textContent = activity.titre || "Activité";
            name.addEventListener("click",()=>window.dispatchEvent(new CustomEvent("voyage:voir-sur-carte",{detail:{date:activityDate(activity),kind:"sport",key:activity.id ? String(activity.id) : ""}})));
            const details = document.createElement("span");
            const parts = [String(activity.sport || "").replace(/^./, (c:string) => c.toLocaleUpperCase("fr-FR"))];
            if (typeof activity.km === "number" && activity.km > 0) parts.push(activity.km.toLocaleString("fr-FR",{maximumFractionDigits:2})+" km");
            if (typeof activity.minutes === "number" && activity.minutes > 0) parts.push(activity.minutes+" min");
            if (activity.fin) {
              const clock = new Intl.DateTimeFormat("fr-FR",{hour:"2-digit",minute:"2-digit",timeZone:"Europe/Paris"}).format(new Date(Number(activity.fin)));
              if (clock) parts.push(clock);
            }
            details.textContent = parts.filter(Boolean).join(" · ");
            copy.append(name, details);
            item.append(copy);
            const actions = document.createElement("div");
            actions.className = "daily-activity-actions";
            if (activity.url && /^https:\/\/(www\.)?strava\.com\//.test(activity.url)) {
              const link = document.createElement("a");
              link.href = activity.url; link.target = "_blank"; link.rel = "noopener noreferrer";
              link.textContent = "Strava";
              actions.append(link);
            }
            item.append(actions);
            activitiesGrid.append(item);
          }
          activitiesWrap.hidden = dayActivities.length === 0;
        }
        previous.disabled = index>=ordered.length-1;
        next.disabled = index<=0;
        if (headingPrevious) headingPrevious.disabled = previous.disabled;
        if (headingNext) headingNext.disabled = next.disabled;
        document.documentElement.dataset.voyageDay = day;
        window.dispatchEvent(new CustomEvent("voyage:jour",{detail:{date:day}}));
      };
      // Les sélections venant de la carte doivent aussi changer le contenu du souvenir du jour.
      window.addEventListener("voyage:jour",(event)=>{
        const detail=(event as CustomEvent<{date?:string}>).detail;
        const target=detail?.date ? ordered.indexOf(detail.date) : -1;
        if(target>=0 && target!==index){index=target;render();}
      });
      headingPrevious?.addEventListener("click",()=>previous.click());
      headingNext?.addEventListener("click",()=>next.click());
      previous.addEventListener("click",()=>{if(index<ordered.length-1){index++;render();}});
      next.addEventListener("click",()=>{if(index>0){index--;render();}});
      window.addEventListener("voyage:aujourdhui",()=>{index=todayIndex;render();});
      window.addEventListener("voyage:hier",()=>{if(yesterdayIndex>=0){index=yesterdayIndex;render();}});
      render();
    }
    initDailyView().catch(()=>{ if(dateText) dateText.textContent="Impossible de charger les souvenirs pour le moment."; });
  </script>
  <style is:global>
    .daily-videos{margin-top:1.5rem}.daily-videos h3{font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;margin:0 0 .75rem;color:var(--muted,#777)}#daily-videos{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr));gap:1rem}.daily-video-tile{min-width:0}.daily-video-link{display:block;position:relative;overflow:hidden;border-radius:6px;background:#222;aspect-ratio:16/9}.daily-video-link img{display:block;width:100%;height:100%;object-fit:cover}.daily-video-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:48px;height:34px;border-radius:9px;background:#d71920;color:#fff;font-size:1.2rem}.daily-video-tile figcaption{margin-top:.4rem;font-size:.9rem;line-height:1.4;overflow-wrap:anywhere}
    .daily-map-controls { padding-top: 18px; padding-bottom: 8px; }
    .daily-map-controls-bottom { padding-top: 12px; padding-bottom: 4px; }
    .daily-map-controls > h1 { margin: 0 0 12px; color: var(--forest); font-size: clamp(1.55rem, 2.5vw, 2rem); line-height: 1.2; }
    .home-map-control-row { display: flex; align-items: center; justify-content: flex-start; gap: 12px; flex-wrap: wrap; }
    .home-map-control-row .section-heading { display: flex; align-items: center; gap: 12px; margin: 0; min-width: 0; flex-wrap: wrap; }
    .home-map-control-row .section-heading h2 { margin: 0; white-space: nowrap; }
    .daily-map-controls .daily-heading-title { display: flex; align-items: center; gap: 8px; }
    .daily-heading-arrows { display: flex; align-items: center; }
    .daily-heading-arrows button { display: inline-grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 1px solid var(--line); border-radius: 4px; background: var(--white); color: var(--forest); font: 500 1rem 'DM Sans',sans-serif; cursor: pointer; transition: background-color .16s ease, border-color .16s ease, color .16s ease; }
    .daily-heading-arrows button:hover:not(:disabled) { background: #f2f0e9; border-color: #b9b3a5; }
    .daily-heading-arrows button:active:not(:disabled) { background: #e8e5dc; }
    .daily-heading-arrows button:disabled { opacity: 1; color: #a9a69d; border-color: #e8e5dd; background: #faf9f6; cursor: default; }
    .daily-heading-arrows button:focus-visible { outline: 2px solid var(--forest); outline-offset: 3px; }
    .home-map-control-row #daily-date { margin: 0; }
    .home-map-control-row .daily-controls { display: none; }
    #map-visibility-toggle { flex: 0 0 auto; width: auto; min-height: 32px; padding: 6px 11px; border: 1px solid var(--line); border-radius: 4px; background: transparent; color: var(--forest); font: 600 .76rem 'DM Sans',sans-serif; cursor: pointer; white-space: nowrap; transition: background-color .16s ease, border-color .16s ease; }
    #map-visibility-toggle:hover { background: var(--white); border-color: #b9b3a5; }
    #map-visibility-toggle:active { background: #f2f0e9; }
    #map-visibility-toggle:focus-visible { outline: 2px solid var(--forest); outline-offset: 3px; }
    .daily-view:not(.daily-map-controls) { padding-top: 28px; }
    .daily-heading-title { display: none; }
    .daily-heading-title.daily-heading-visible { display: flex; }
    .daily-view #daily-date { margin-top: 8px; font-size: .8rem; }
    .daily-activities { margin-top: 22px; }
    .daily-activities[hidden] { display: none !important; }
    .daily-activities h3 { font: 700 .8rem 'DM Sans',sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
    #daily-activities { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
    .daily-activity { display: flex; justify-content: space-between; gap: 14px; align-items: center; padding: 14px 16px; border: 1px solid var(--line); background: var(--white); }
    .daily-activity-copy { display: grid; gap: 5px; min-width: 0; }
    .daily-activity-title { border: 0; padding: 0; background: transparent; color: var(--forest); font: inherit; font-size: .9rem; line-height: 1.35; font-weight: 700; text-align: left; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
    .daily-activity span { color: var(--muted); font-size: .78rem; }
    .daily-activity-actions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .photo-tile figcaption { margin-top: 7px; color: var(--forest); font-size: .82rem; text-decoration: none; }
    .daily-activity a { color: var(--forest); font-size: .76rem; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
    @media(max-width:650px) {
      .daily-map-controls { padding-top: 14px; }
      .home-map-control-row { align-items: flex-start; gap: 8px 12px; }
      .home-map-control-row .section-heading { gap: 8px; }
      .home-map-control-row .section-heading h2 { font-size: .95rem; }
      .daily-view:not(.daily-map-controls) { padding-top: 24px; }
      #daily-activities { grid-template-columns: 1fr; }
      .daily-activity { align-items: flex-start; flex-direction: column; padding: 12px; gap: 9px; }
      .daily-activity-actions { flex-wrap: wrap; }
    }
  </style>
  <FilmVoyage etapes={etapes} />
</Base>

