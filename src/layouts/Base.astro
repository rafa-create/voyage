---
import "../styles/global.css";
import { chemin } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  active?: "accueil" | "journal" | "pays" | "galerie" | "defi";
}

const { title, description = "Un carnet de voyage en images, en mots et en vidéos.", active } = Astro.props;
const nav = [
  { label: "Accueil", href: "/", id: "accueil" },
  { label: "Journal", href: "/journal/", id: "journal" },
  { label: "Galerie", href: "/galerie/", id: "galerie" },
  { label: "Défi", href: "/defi/", id: "defi" },
  { label: "Connexion", href: "/connexion/", id: "connexion" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3eb" />
    <link rel="icon" type="image/svg+xml" href={chemin("/favicon.svg")} />
    <title>{title} · Carnet de voyage</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={chemin("/")} aria-label="Carnet de voyage, accueil">
          
          <span>Carnet<span class="brand-accent">.</span>voyage</span>
        </a>
        <nav class="main-nav" aria-label="Navigation principale">
          {nav.map((lien) => (
            <a
              href={chemin(lien.href)}
              class:list={{ selected: active === lien.id }}
              aria-current={active === lien.id ? "page" : undefined}
            >
              {lien.label}
            </a>
          ))}
        </nav>
      </div>
      <script>
        const connectionLink = document.querySelector<HTMLAnchorElement>('.main-nav a[href$="/connexion/"]');
        if (connectionLink) {
          fetch("/api/prive/moi", { credentials: "same-origin", cache: "no-store" })
            .then(async response => {
              if (!response.ok) return;
              const user = await response.json();
              connectionLink.textContent = "Connecté";
              connectionLink.href = user.isAdmin ? "/admin/" : "/espace/";
              connectionLink.setAttribute("aria-label", user.isAdmin ? "Connecté — espace administrateur" : "Connecté — albums privés");
              connectionLink.classList.add("is-connected");
            })
            .catch(() => {});
        }
      </script>
    </header>
    <main id="contenu"><slot /></main>
    <aside id="admin-quick-tools" class="admin-quick-tools" hidden aria-label="Outils administrateur">
      <button type="button" id="admin-tools-toggle" class="admin-tools-toggle" aria-expanded="false">Gérer cette page</button>
      <section id="admin-tools-panel" class="admin-tools-panel" hidden>
        <div class="admin-tools-heading">
          <strong>Administration</strong>
          <button type="button" id="admin-tools-close" aria-label="Fermer">×</button>
        </div>
        <p id="admin-tools-context">Actions adaptées à cette page.</p>
        <div class="admin-tools-links">
          <a id="admin-tools-primary" href={chemin("/admin/")}>Gérer le contenu</a>
          <a id="admin-tools-challenge" href={chemin("/admin/defi/")}>Gérer le défi</a>
          <a href={chemin("/admin/")}>Tous les outils</a>
        </div>
        <button type="button" id="admin-tools-open" class="admin-tools-open">Ouvrir les outils sans quitter cette page</button>
      </section>
    </aside>
    <div id="admin-tools-modal" class="admin-tools-modal" hidden role="dialog" aria-modal="true" aria-label="Outils d’administration">
      <div class="admin-tools-modal-head">
        <strong id="admin-tools-modal-title">Administration</strong>
        <button type="button" id="admin-tools-modal-close">Fermer ×</button>
      </div>
      <iframe id="admin-tools-frame" title="Outils d’administration" loading="lazy"></iframe>
    </div>
    <script>
      const adminDock = document.getElementById("admin-quick-tools");
      const adminToggle = document.getElementById("admin-tools-toggle");
      const adminPanel = document.getElementById("admin-tools-panel");
      const adminModal = document.getElementById("admin-tools-modal");
      const adminFrame = document.getElementById("admin-tools-frame") as HTMLIFrameElement | null;
      const adminPath = window.location.pathname;
      const isChallengePage = /\/defi\/?$/.test(adminPath);
      const primaryAdminLink = document.getElementById("admin-tools-primary") as HTMLAnchorElement | null;
      const challengeAdminLink = document.getElementById("admin-tools-challenge") as HTMLAnchorElement | null;
      const contextText = document.getElementById("admin-tools-context");
      const openAdminTools = () => {
        if (!adminModal || !adminFrame) return;
        const target = isChallengePage ? "/admin/defi/" : "/admin/";
        if (!adminFrame.src.endsWith(target)) adminFrame.src = target;
        adminModal.hidden = false;
        document.body.classList.add("admin-tools-modal-open");
      };
      fetch("/api/prive/moi", { credentials: "same-origin", cache: "no-store" })
        .then(async response => response.ok ? response.json() : null)
        .then(user => {
          if (!user?.isAdmin || !adminDock) return;
          adminDock.hidden = false;
          if (isChallengePage) {
            if (primaryAdminLink) { primaryAdminLink.href = "/admin/defi/"; primaryAdminLink.textContent = "Gérer le défi du jour"; }
            if (challengeAdminLink) challengeAdminLink.hidden = true;
            if (contextText) contextText.textContent = "Défi quotidien : synchronisation des échecs et activités.";
          } else if (/\/galerie\/?$/.test(adminPath)) {
            if (primaryAdminLink) { primaryAdminLink.href = "/admin/"; primaryAdminLink.textContent = "Gérer les photos et vidéos"; }
            if (contextText) contextText.textContent = "Galerie : ajouter, classer et gérer les photos.";
          } else {
            if (primaryAdminLink) { primaryAdminLink.href = "/admin/"; primaryAdminLink.textContent = "Gérer les étapes, photos et récits"; }
            if (contextText) contextText.textContent = "Outils d’édition disponibles sans perdre cette page.";
          }
        }).catch(() => {});
      adminToggle?.addEventListener("click", () => {
        const open = adminToggle.getAttribute("aria-expanded") === "true";
        adminToggle.setAttribute("aria-expanded", String(!open));
        if (adminPanel) adminPanel.hidden = open;
      });
      document.getElementById("admin-tools-close")?.addEventListener("click", () => {
        if (adminPanel) adminPanel.hidden = true;
        adminToggle?.setAttribute("aria-expanded", "false");
      });
      document.getElementById("admin-tools-open")?.addEventListener("click", openAdminTools);
      document.getElementById("admin-tools-modal-close")?.addEventListener("click", () => {
        if (adminModal) adminModal.hidden = true;
        document.body.classList.remove("admin-tools-modal-open");
      });
    </script>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} · Carnet de voyage</span>
      </div>
    </footer>
  </body>
</html>
