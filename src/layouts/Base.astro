---
import "../styles/global.css";
import { chemin } from "../lib/paths";

interface Props {
  title: string;
  headerTitle?: string;
  description?: string;
  active?: "ir" | "diapo" | "accueil" | "journal" | "pays" | "galerie" | "defi";
}

const { title, headerTitle = title, description = "Un carnet de voyage en images, en mots et en vidéos.", active } = Astro.props;
const nav = [
  { label: "Hier", href: "/", id: "ir" },
  { label: "Diapo", href: "/diapo/", id: "diapo" },
  { label: "Journal", href: "/journal/", id: "journal" },
  { label: "Galerie", href: "/galerie/", id: "galerie" },
  { label: "Défi", href: "/defi/", id: "defi" },
  { label: "Connexion", href: "/connexion/", id: "connexion" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3eb" />
    <link rel="icon" type="image/svg+xml" href={chemin("/favicon.svg")} />
    <title>{title} · Carnet de voyage</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <div class="header-branding">
          <a class="brand" href={chemin("/")} aria-label="Carnet de voyage, accueil">
            <span>Carnet de voyage</span>
          </a>
          <span class="header-page-title" aria-current="page">{headerTitle}</span>
        </div>
        <nav class="main-nav" aria-label="Navigation principale">
          {nav.map((lien) => (
            <a
              href={chemin(lien.href)}
              class:list={{ selected: active === lien.id }}
              aria-current={active === lien.id ? "page" : undefined}
            >
              {lien.label}
            </a>
          ))}
        </nav>
      </div>
      <script>
        const connectionLink = document.querySelector<HTMLAnchorElement>('.main-nav a[href$="/connexion/"]');
        if (connectionLink) {
          (async () => {
            try {
              const siteResponse = await fetch("/api/public/site-access/status", { credentials: "same-origin", cache: "no-store" });
              if (siteResponse.ok) {
                const site = await siteResponse.json();
                if (site.mode === "restricted" && site.authenticated) {
                  connectionLink.textContent = "Connecté";
                  connectionLink.href = "/connexion/";
                  connectionLink.setAttribute("aria-label", "Connecté — accès au carnet de voyage");
                  connectionLink.classList.add("is-connected");
                  return;
                }
              }
              const response = await fetch("/api/prive/moi", { credentials: "same-origin", cache: "no-store" });
              if (!response.ok) return;
              const user = await response.json();
              connectionLink.textContent = "Connecté";
              connectionLink.href = user.isAdmin ? "/admin/" : "/espace/";
              connectionLink.setAttribute("aria-label", user.isAdmin ? "Connecté — espace administrateur" : "Connecté — albums privés");
              connectionLink.classList.add("is-connected");
            } catch {}
          })();
        }
      </script>
    </header>
    <aside id="admin-quick-tools" class="admin-quick-tools" hidden aria-label="Outils administrateur">
      <div class="admin-quick-tools-inner">
        <button type="button" id="admin-tools-toggle" class="admin-tools-toggle" aria-expanded="false">Gérer cette page</button>
        <section id="admin-tools-panel" class="admin-tools-panel" hidden>
          <div class="admin-tools-heading">
            <strong id="admin-tools-context">Administration de cette page</strong>
            <button type="button" id="admin-tools-close" aria-label="Fermer">×</button>
          </div>
          <iframe id="admin-tools-frame" title="Outils d’administration de cette page" loading="lazy"></iframe>
        </section>
      </div>
    </aside>
    <main id="contenu"><slot /></main>
    <div id="admin-tools-modal" class="admin-tools-modal" hidden role="dialog" aria-modal="true" aria-label="Outils d’administration">
      <div class="admin-tools-modal-head">
        <strong id="admin-tools-modal-title">Administration</strong>
        <button type="button" id="admin-tools-modal-close">Fermer ×</button>
      </div>
      <iframe id="admin-tools-modal-frame" title="Outils d’administration" loading="lazy"></iframe>
    </div>
    <script>
      const adminDock = document.getElementById("admin-quick-tools");
      const adminToggle = document.getElementById("admin-tools-toggle");
      const adminPanel = document.getElementById("admin-tools-panel");
      const adminFrame = document.getElementById("admin-tools-frame") as HTMLIFrameElement | null;
      const adminPath = window.location.pathname;
      const isChallengePage = /\/defi\/?$/.test(adminPath);
      const isGalleryPage = /\/galerie\/?$/.test(adminPath);
      const isJournalPage = /\/journal\/?$/.test(adminPath);
      const contextText = document.getElementById("admin-tools-context");
      const target = isChallengePage ? "/admin/defi/" : "/admin/?context=" + (isGalleryPage ? "photos" : isJournalPage ? "etapes" : "general");
      if (!/^\/admin(?:\/|$)/.test(adminPath)) {
        fetch("/api/prive/moi", { credentials: "same-origin", cache: "no-store" })
          .then(async response => response.ok ? response.json() : null)
          .then(user => {
            if (!user?.isAdmin || !adminDock || isChallengePage || isHomePage) return;
            adminDock.hidden = false;
            if (contextText) contextText.textContent = isChallengePage ? "Défi quotidien" : isGalleryPage ? "Ajouter des photos" : isJournalPage ? "Ajouter une étape" : "Administration de cette page";
          }).catch(() => {});
      }
      adminToggle?.addEventListener("click", () => {
        const open = adminToggle.getAttribute("aria-expanded") === "true";
        if (!open && adminFrame && !adminFrame.src) adminFrame.src = target;
        if (adminPanel) adminPanel.hidden = open;
        adminToggle?.setAttribute("aria-expanded", String(!open));
      });
      document.getElementById("admin-tools-close")?.addEventListener("click", () => {
        if (adminPanel) adminPanel.hidden = true;
        adminToggle?.setAttribute("aria-expanded", "false");
      });
    </script>
    <script>
      // Crayon de modification des photos : conservé uniquement dans la galerie.
      (async () => {
        if (!/\/galerie\/?$/.test(window.location.pathname)) return;
        const main = document.querySelector<HTMLElement>("main");
        if (!main) return;
        try {
          const me = await fetch("/api/prive/moi", { credentials: "same-origin", cache: "no-store" });
          if (!me.ok || !(await me.json()).isAdmin) return;
          const addPhotoPencils = () => {
            for (const figure of main.querySelectorAll<HTMLElement>("figure.photo-tile")) {
              if (figure.dataset.adminPhotoPencil) continue;
              const image = figure.querySelector("img");
              const photoControl = figure.querySelector<HTMLButtonElement>("button.photo-open[data-photo]") || figure.querySelector<HTMLAnchorElement>("a.photo-open[href]");
              const imagePath = image?.getAttribute("src") || "";
              if (!image || !photoControl || !/^\/media(?:-prive)?\//.test(imagePath)) continue;
              figure.dataset.adminPhotoPencil = "true";
              figure.style.position = figure.style.position || "relative";
              const pencil = document.createElement("button");
              pencil.type = "button";
              pencil.className = "admin-photo-pencil";
              pencil.textContent = "✎";
              pencil.title = "Modifier le commentaire de cette photo";
              pencil.setAttribute("aria-label", "Modifier le commentaire de cette photo");
              pencil.addEventListener("click", () => {
                const src = image.getAttribute("src") || "";
                if (!src) return;
                const target = figure.querySelector<HTMLButtonElement>("button.photo-open[data-photo]");
                if (!target) return;
                target.click();
                let attempts = 0;
                const openEditor = () => {
                  const edit = document.querySelector<HTMLButtonElement>(".lightbox-edit");
                  if (edit && !edit.hidden) { edit.click(); return; }
                  if (++attempts < 30) window.setTimeout(openEditor, 100);
                };
                window.setTimeout(openEditor, 100);
              });
              figure.append(pencil);
            }
          };
          addPhotoPencils();
          // Surveillance limitée à la galerie pour les photos chargées dynamiquement.
          const observer = new MutationObserver(addPhotoPencils);
          observer.observe(main, { childList: true, subtree: true });
        } catch {}
      })();
    </script>
    <style is:global>
      .admin-photo-pencil{position:absolute;top:7px;right:7px;z-index:8;display:inline-flex;align-items:center;justify-content:center;width:27px;height:27px;border:1px solid #397a70;border-radius:50%;background:#fff;color:#24534f;font:700 16px/1 sans-serif;box-shadow:0 2px 8px #0002;cursor:pointer}
    </style>
  </body>
</html>
