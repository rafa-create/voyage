{
  "name": "voyage",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/media/*",
      "/media-prive/*",
      "/api/*",
      "/espace/*",
      "/admin/*",
      "/etapes/*"
    ]
  },
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "main": "./worker/index.js",
  "r2_buckets": [
    {
      "binding": "PHOTOS_PUBLIQUES",
      "bucket_name": "voyage-photos"
    },
    {
      "binding": "PHOTOS_PRIVEES",
      "bucket_name": "voyage-photos-prive"
    }
  ]
}
